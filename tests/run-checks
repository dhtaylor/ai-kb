  mkdir -p "$1/$(dirname "$2")"; git init -q "$1"
  printf -- '---\nname: x-index\ndomain: x\n---\n# x\n' > "$1/INDEX.md"
  printf '%s\n' "$3" > "$1/$2"; git -C "$1" add -A >/dev/null 2>&1
}
arc_lib "$TMP/arc1" documents/schema/dump.sql "$IDENTS"
