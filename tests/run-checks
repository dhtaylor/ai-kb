git -C "$TMP/ksrc-head" add -A >/dev/null 2>&1
: > "$SRV/access.log"
case_run "kb-sources: only the 429 is queued (HEAD 400/404/500 then GET 200 are alive)" 1 "queued" -- \
  "$ENGINE/scripts/kb-sources" "$TMP/ksrc-head" --yes
KHQ="$TMP/ksrc-head/needs-attention.md"
case_run "kb-sources: HEAD 400 then GET 200 is not queued" 1 "" -- grep -qF 'sources/s-head400.md' "$KHQ"
case_run "kb-sources: HEAD 404 then GET 200 is not queued" 1 "" -- grep -qF 'sources/s-head404.md' "$KHQ"
case_run "kb-sources: HEAD 500 then GET 200 is not queued" 1 "" -- grep -qF 'sources/s-head500.md' "$KHQ"
case_run "kb-sources: HEAD 429 queued as source-unreachable" 0 "" -- \
  bash -c 'grep -B2 -A8 "stub: \"sources/s-busy.md\"" "$1" | grep -qF "category: \"source-unreachable\""' _ "$KHQ"
case_run "kb-sources: HEAD 429 sends no GET" 1 "" -- grep -qxF 'GET /busy' "$SRV/access.log"
case_run "kb-sources: HEAD 400 was retried with GET" 0 "" -- grep -qxF 'GET /head400' "$SRV/access.log"
# Issue #117: dni.gov answered 403 to kb-sources' own User-Agent and 200 to every other client, so
# a live source was queued every week. A 403 to the tool's User-Agent is retried once as a plain
# client, and that answer decides. A server that refuses every client is still unreachable.
case_run "kb-sources: a 403 only to the tool's User-Agent is alive, not queued (#117)" 1 "" -- \
  grep -qF 'sources/s-uablock.md' "$KHQ"
case_run "kb-sources: ...after exactly one retry without that User-Agent" 0 "" -- \
  bash -c '[ "$(grep -cxF "GET /uablock" "$1")" = 2 ]' _ "$SRV/access.log"
case_run "kb-sources: a 404 is not retried as a plain client" 0 "" -- \
  bash -c '[ "$(grep -cxF "GET /gone" "$1")" -le 1 ]' _ "$SRV/access.log"

# ---------------------------------------------------------------- kb-due ----
build_clean "$TMP/due" --swept "$KB_TODAY"   # computed: a typed date expires
case_run "recently swept tree is not due" 0 "0 of 1" -- "$ENGINE/scripts/kb-due" "$TMP/due"

build_clean "$TMP/overdue" --swept 2026-01-01
case_run "long-unswept tree is due" 0 "1 of 1" -- "$ENGINE/scripts/kb-due" "$TMP/overdue"

# A trailing YAML comment is valid and must not hide the value (issue #28).
build_clean "$TMP/due-comment" --swept "$KB_TODAY  # swept by me"
patch "$TMP/due-comment/INDEX.md" "s/^sweep_interval: 30d\$/sweep_interval: 7d  # weekly/"
case_run "kb-due: last_swept with an inline comment is read" 0 "0 of 1" -- "$ENGINE/scripts/kb-due" "$TMP/due-comment"
case_run "kb-due: sweep_interval with an inline comment is read" 0 "every 7d" -- "$ENGINE/scripts/kb-due" "$TMP/due-comment"

# ------------------------------------------------------- kb-due --nudge ----
# Phase 5 step 3: one nudge covers sweep-due, facts due for recheck (reusing kb-verify's
# own selection, never running it), open queue items (parsed with kb-watch's own
# parse_records), and episodic notes awaiting distillation. Silence is still the point: nothing due in
# any category prints nothing, exit 0.

# A registered library, so --nudge is exercised through the registry the way kb-session-start
# actually calls it, not just through a single tree argument.
NFX="$TMP/nudge-fx"; mkdir -p "$NFX/kb"

# 1. Nothing due anywhere: fresh sweep, a fresh agent-stamped fact with no Recheck, no
#    queue, no episodic/. --nudge must print nothing at all.
build_clean "$NFX/kb/nothing-due" --swept "$KB_TODAY" --stamp "$KB_TODAY"
# The fact must really be fresh: build_clean's literal 2026-09-22 stamp ages past the 9d short lease,
# and this case passed only because the nudge ignored stale facts with no Recheck (issue #63).
HOME="$TMP/nfxhome" "$ENGINE/scripts/kb-library" add "$NFX/kb/nothing-due" >/dev/null   # installed = registered
case_run "nudge: nothing due anywhere prints nothing" 0 "" -- \
  bash -c '[ -z "$(HOME="$2" "$1" --nudge)" ]' _ "$ENGINE/scripts/kb-due" "$TMP/nfxhome"

# 2. A stale fact carrying a Recheck: due for recheck, and the Recheck must NOT run —
#    proven with a sentinel file, the same technique kb-verify's own fixture uses.
build_clean "$NFX/kb/recheck-due" --swept "$KB_TODAY"
NUDGE_SENTINEL="$TMP/nudge-sentinel"
rm -f "$NUDGE_SENTINEL"
fm stale-recheck general > "$NFX/kb/recheck-due/stale-recheck.md"
cat >> "$NFX/kb/recheck-due/stale-recheck.md" <<EOF
# Stale Recheck

## Port

The service listens on some port.

Source: manual
Verified: 2026-01-01 · by: agent · method: manual
Recheck: touch "$NUDGE_SENTINEL"
EOF
printf -- '- [stale-recheck](stale-recheck.md) — a stale fact with a Recheck\n' >> "$NFX/kb/recheck-due/INDEX.md"
case_run "nudge: a stale fact with Recheck is reported due" 0 "1 fact due for recheck" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/recheck-due" --nudge
case_run "nudge: names the exact kb-verify command, by path" 0 "kb-verify $NFX/kb/recheck-due --yes" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/recheck-due" --nudge
case_run "nudge: the Recheck assertion itself is never run" 1 "" -- test -e "$NUDGE_SENTINEL"
# #211: the count is the whole backlog, not the budget's worth; ", N a run" says how many one run
# takes, and only when the backlog is more than that. Two stale Rechecks, verifier_budget 1.
cp -r "$NFX/kb/recheck-due" "$TMP/overbudget"
patch "$TMP/overbudget/INDEX.md" "s/^verifier_budget: 5\$/verifier_budget: 1/"
sed "s/^## Port\$/## Host/; s/^Recheck: .*\$/Recheck: true/" "$TMP/overbudget/stale-recheck.md" > "$TMP/overbudget/stale-recheck-2.md"
printf -- '- [stale-recheck-2](stale-recheck-2.md) — a second stale fact with a Recheck\n' >> "$TMP/overbudget/INDEX.md"
case_run "nudge: past the budget, the count is every due recheck and says how many a run takes (#211)" 0 \
  "2 facts due for recheck, 1 a run (kb-verify $TMP/overbudget --yes)" -- \
  "$ENGINE/scripts/kb-due" "$TMP/overbudget" --nudge
case_run "nudge: ...and the summary line counts every due recheck (#211)" 0 "to recheck: overbudget 2" -- \
  "$ENGINE/scripts/kb-due" "$TMP/overbudget" --nudge --summary
case_run "nudge: within the budget, no per-run count is added (#211)" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF " a run "' _ "$ENGINE/scripts/kb-due" "$NFX/kb/recheck-due"
# Issue #16: the printed command must actually run when pasted, from any cwd.
NUDGE_CMD=$("$ENGINE/scripts/kb-due" "$NFX/kb/recheck-due" --nudge \
  | sed -n 's/.*(\(kb-verify [^)]*\)).*/\1/p' | head -1)
mkdir -p "$TMP/nudge-elsewhere"
case_run "nudge: the printed kb-verify command runs from another cwd" 0 "" -- \
  bash -c 'cd "$1" && PATH="$2:$PATH" && out=$($3 2>&1); rc=$?; echo "$out"; ! printf %s "$out" | grep -q "has no INDEX.md" && [ $rc = 0 ]' \
  _ "$TMP/nudge-elsewhere" "$ENGINE/scripts" "$NUDGE_CMD"
rm -f "$NUDGE_SENTINEL"  # the pasted command ran the Recheck for real; reset for later cases

# 3. An open queue item, built by actually running kb-verify --yes on a failing fact, so
#    the queue format being counted is the real one kb-verify writes — not a hand-rolled
#    stand-in. A second failing fact gives a second entry, which is then acknowledged by
#    hand (flipping only its status:, the one field a human triaging the queue would
#    change) to prove an acknowledged item is excluded from the count.
build_clean "$NFX/kb/queue-due"
cat >> "$NFX/kb/queue-due/widgets.md" <<'EOF'
Recheck: false
EOF
patch "$NFX/kb/queue-due/widgets.md" 's/^Verified: .*$/Verified: 2026-01-01 · by: human · method: query/'
fm second-fact general > "$NFX/kb/queue-due/second-fact.md"
cat >> "$NFX/kb/queue-due/second-fact.md" <<'EOF'
# Second Fact

## Thing

Another claim.

Source: manual
Verified: 2026-01-01 · by: human · method: query
Recheck: false
EOF
printf -- '- [second-fact](second-fact.md) — a second stale, wrong fact\n' >> "$NFX/kb/queue-due/INDEX.md"
"$ENGINE/scripts/kb-verify" "$NFX/kb/queue-due" --yes >/dev/null 2>&1
case_run "nudge fixture: kb-verify queued exactly two open findings" 0 "" -- \
  sh -c "[ \$(grep -c '^- id:' '$NFX/kb/queue-due/needs-attention.md') = 2 ]"
case_run "nudge: two open queue items are counted" 0 "2 open queue item" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/queue-due" --nudge
case_run "nudge: grouped by category" 0 "2 stale-recheck" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/queue-due" --nudge
# Acknowledge one entry — a human's triage action, nothing kb-due itself ever does.
patch "$NFX/kb/queue-due/needs-attention.md" '0,/status: "open"/s//status: "acknowledged"/'
case_run "nudge: an acknowledged item is not counted" 0 "1 open queue item" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/queue-due" --nudge
case_run "nudge: acknowledged count does not also read as two" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "2 open queue item"' _ \
  "$ENGINE/scripts/kb-due" "$NFX/kb/queue-due"

# 4. Episodic notes: no marker in this codebase distinguishes a distilled note from an
#    undistilled one (kb-distill leaves free-text prose, never a frontmatter field or
#    other machine-checkable sentinel — see kb-distill/SKILL.md Step 5 and the real
#    "## Distilled" / "## Distillation record" notes already in kb/claude-code-runtime
#    and kb/knowledge-architecture, which spell the heading two different ways). The
#    honest proxy is therefore a raw count, named as exactly that.
build_clean "$NFX/kb/episodic-due" --swept "$KB_TODAY"
mkdir -p "$NFX/kb/episodic-due/episodic"
for n in 1 2; do
  printf -- '---\nname: 2026-01-0%s-note\ndescription: fixture\nmemory_type: episodic\ndomain: fx\nscope: general\nmetadata: {type: episodic, node_type: memory, created: 2026-01-0%s}\ntags: [fx, episodic]\nkeywords: [episodic]\n---\n# note %s\n' \
    "$n" "$n" "$n" > "$NFX/kb/episodic-due/episodic/2026-01-0$n-note.md"
done
printf -- '---\nname: episodic-index\ndescription: fixture\nmemory_type: reference\ndomain: fx\nscope: general\nmetadata: {type: index, node_type: router, created: 2026-01-01}\ntags: [fx]\nkeywords: [episodic]\n---\n# Episodic\n' \
  > "$NFX/kb/episodic-due/episodic/INDEX.md"
case_run "nudge: episodic notes are counted, INDEX.md excluded" 0 "2 episodic notes awaiting distillation" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/episodic-due" --nudge
# A distilled note is not awaiting distillation. Both spellings in use are recognised: the
# canonical "## Distilled" (kb-distill Step 5) and older notes' "## Distillation record".
# Counting them would ask about the same notes at every session start, forever.
for h in "Distilled $KB_TODAY" "Distillation record"; do
  f="$NFX/kb/episodic-due/episodic/2026-01-0$(( ${#h} % 7 + 3 ))-done.md"
  printf -- '---\nname: %s\ndescription: fixture\nmemory_type: episodic\ndomain: fx\nscope: general\nmetadata: {type: episodic, node_type: memory, created: 2026-01-01}\ntags: [fx, episodic]\nkeywords: [episodic]\n---\n# done\n\n## %s\nFacts went to x.md.\n' \
    "$(basename "$f" .md)" "$h" > "$f"
done
case_run "nudge: distilled notes (either heading spelling) are not counted" 0 "2 episodic notes awaiting distillation" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/episodic-due" --nudge

# 4b. Unstamped sourced sections (issue #29): §7 ranks unknown ahead of stale, so the nudge
#     names them between sweeps. A CONFLICTED section, an episodic note and a source stub are
#     not counted: the first is not served, the others are records, not facts.
build_clean "$NFX/kb/unstamped-due"   # never swept: no sweep to compare with, so the full count (#142)
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n\n## Colour\n\nRed.\n\nSource: manual\n\n## Size\n\nstatus: CONFLICTED · since: 2026-01-01\n\nSource: manual\n' >> "$NFX/kb/unstamped-due/widgets.md"
mkdir -p "$NFX/kb/unstamped-due/episodic"
printf -- '---\nname: 2026-01-01-note\ndescription: fixture\nmemory_type: episodic\ndomain: fx\nscope: general\n---\n# note\n\n## Distilled\n\nSource: manual\n' > "$NFX/kb/unstamped-due/episodic/2026-01-01-note.md"
# A state leaf (§2) records questions and disputes, not facts: its Source: lines say where a
# question came from, and no stamp could ever clear it, so it is not counted either.
fm fx-open-questions general > "$NFX/kb/unstamped-due/fx-open-questions.md"
printf '# Open questions\n\n## Is it blue?\n\nNo source says.\n\nSource: manual\n' >> "$NFX/kb/unstamped-due/fx-open-questions.md"
printf -- '- [fx-open-questions](fx-open-questions.md) — open questions\n' >> "$NFX/kb/unstamped-due/INDEX.md"
case_run "nudge: unstamped sources are counted, CONFLICTED, episodic and state leaves excluded" 0 \
  "2 unstamped sources (never verified)" -- "$ENGINE/scripts/kb-due" "$NFX/kb/unstamped-due" --nudge
# #201: a router is not a fact file, so a Source: line in INDEX.md is no unstamped source.
build_clean "$NFX/kb/unstamped-index"
printf '\n## Where it came from\n\nSource: manual\n' >> "$NFX/kb/unstamped-index/INDEX.md"
case_run "nudge: a Source: line in INDEX.md is not counted as unstamped (#201)" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "(never verified)"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/unstamped-index"
case_run "nudge: a fully stamped library reports no unstamped sections" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "unstamped"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/nothing-due"
# Issue #64: §6 stacks one stamp per source, so a Source: line with no Verified: of its own is
# unstamped even when the section's other source is stamped. Counted per Source: line.
build_clean "$NFX/kb/stacked-due" --stamp "$KB_TODAY"   # never swept, as above
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\nSource: vendor sheet\nVerified: %s · by: agent · method: manual\n\n## Colour\n\nRed.\n\nSource: manual\nVerified: %s · by: agent · method: manual\nSource: vendor sheet\nVerified: %s · by: agent · method: manual\n' \
  "$KB_TODAY" "$KB_TODAY" "$KB_TODAY" >> "$NFX/kb/stacked-due/widgets.md"
case_run "nudge: a stacked source with no stamp of its own is counted" 0 "1 unstamped source (never verified)" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/stacked-due" --nudge
# Issue #142: once a library has been swept, the nudge names only the unstamped sources that are new
# since the sweep's commit; the standing stock was already in front of the sweep. Plain kb-due keeps
# the full count. A source is matched by its heading and Source: line, not its file, so a move is
# not new.
gitc() { git -C "$1" -c user.email=t@t -c user.name=t commit -qm "$2" >/dev/null 2>&1; }
build_clean "$NFX/kb/delta-due"
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n' >> "$NFX/kb/delta-due/widgets.md"
git -C "$NFX/kb/delta-due" add -A; gitc "$NFX/kb/delta-due" seed
patch "$NFX/kb/delta-due/INDEX.md" "s/^last_swept: never\$/last_swept: $KB_TODAY/"
git -C "$NFX/kb/delta-due" add -A; gitc "$NFX/kb/delta-due" sweep
case_run "nudge: right after a committed sweep, no unstamped line (#142)" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "(never verified)"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/delta-due"
printf '\n## Colour\n\nRed.\n\nSource: manual\n' >> "$NFX/kb/delta-due/widgets.md"
case_run "nudge: a new unstamped source since the sweep is named (#142)" 0 \
  "1 new unstamped source since the last sweep" -- "$ENGINE/scripts/kb-due" "$NFX/kb/delta-due" --nudge
case_run "nudge: ...and counted in the summary line (#142)" 0 "unstamped: delta-due 1" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/delta-due" --nudge --summary
case_run "kb-due without --nudge keeps the full unstamped count (#142)" 0 "2 unstamped sources" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/delta-due"
# A section moved to another file after the sweep is the same source, not a new one.
build_clean "$NFX/kb/delta-move" --swept "$KB_TODAY"
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n' >> "$NFX/kb/delta-move/widgets.md"
git -C "$NFX/kb/delta-move" add -A; gitc "$NFX/kb/delta-move" sweep
python3 - "$NFX/kb/delta-move/widgets.md" <<'PY'
import sys; p = sys.argv[1]; t = open(p).read(); i = t.index("\n## Weight"); open(p, "w").write(t[:i] + "\n")
PY
fm weight general > "$NFX/kb/delta-move/weight.md"
printf '# Weight\n\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n' >> "$NFX/kb/delta-move/weight.md"
printf -- '- [weight](weight.md) — what a widget weighs\n' >> "$NFX/kb/delta-move/INDEX.md"
case_run "nudge: a section moved to another file since the sweep is not new (#142)" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "(never verified)"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/delta-move"
# A sweep not yet committed: the comparison is with the files as they are, so nothing is new.
build_clean "$NFX/kb/delta-uncommitted"
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n' >> "$NFX/kb/delta-uncommitted/widgets.md"
git -C "$NFX/kb/delta-uncommitted" add -A; gitc "$NFX/kb/delta-uncommitted" seed
patch "$NFX/kb/delta-uncommitted/INDEX.md" "s/^last_swept: never\$/last_swept: $KB_TODAY/"
case_run "nudge: a sweep not yet committed leaves nothing new (#142)" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "(never verified)"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/delta-uncommitted"
# A swept tree outside git has no sweep commit to compare with: the full count.
mkdir -p "$TMP/delta-nogit" && cp -r "$NFX/kb/delta-due" "$TMP/delta-nogit/lib" && rm -rf "$TMP/delta-nogit/lib/.git"
case_run "nudge: a swept tree outside git reports the full count (#142)" 0 "2 unstamped sources (never verified)" -- \
  "$ENGINE/scripts/kb-due" "$TMP/delta-nogit/lib" --nudge
# Issue #141: a project tree kept as a read-only archive declares `archived:` in its root INDEX.md
# and drops out of the nudge; plain kb-due still lists it, marked archived. A registered library is
# served whatever it says, so it is nudged as usual and told how to retire it.
build_clean "$NFX/kb/arch-proj"
patch "$NFX/kb/arch-proj/INDEX.md" 's/^last_swept: never$/&\narchived: 2026-11-01, moved to registered libraries/'
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n' >> "$NFX/kb/arch-proj/widgets.md"
mkdir -p "$TMP/archhome"
case_run "nudge: an archived project tree prints nothing (#141)" 0 "" -- \
  bash -c '[ -z "$(HOME="$3" "$1" "$2" --nudge --summary)" ]' _ "$ENGINE/scripts/kb-due" "$NFX/kb/arch-proj" "$TMP/archhome"
case_run "kb-due --quiet: an archived project tree is not due (#141)" 0 "" -- \
  bash -c '[ -z "$(HOME="$3" "$1" "$2" --quiet)" ]' _ "$ENGINE/scripts/kb-due" "$NFX/kb/arch-proj" "$TMP/archhome"
case_run "kb-due: an archived project tree is still listed, marked archived (#141)" 0 "archived: 2026-11-01" -- \
  env HOME="$TMP/archhome" "$ENGINE/scripts/kb-due" "$NFX/kb/arch-proj"
cp -r "$NFX/kb/arch-proj" "$NFX/kb/arch-lib" && patch "$NFX/kb/arch-lib/INDEX.md" 's/^domain: arch-proj$/domain: arch-lib/'
mkdir -p "$TMP/archhome2"; HOME="$TMP/archhome2" "$ENGINE/scripts/kb-library" add "$NFX/kb/arch-lib" >/dev/null 2>&1
case_run "nudge: a registered library declaring archived: is still nudged (#141)" 0 "arch-lib: sweep due" -- \
  env HOME="$TMP/archhome2" "$ENGINE/scripts/kb-due" --nudge
case_run "nudge: ...and told how to retire it (#141)" 0 "kb-library remove arch-lib" -- \
  env HOME="$TMP/archhome2" "$ENGINE/scripts/kb-due" --nudge
# Issue #154: a section with no Source: line is counted too, and a sourced library reports none.
build_clean "$NFX/kb/unsourced-due" --swept "$KB_TODAY" --stamp "$KB_TODAY"
printf '\n## Colour\n\nRed.\n\n## Size\n\nSmall.\n' >> "$NFX/kb/unsourced-due/widgets.md"
case_run "nudge: sections with no Source: line are counted" 0 "2 unsourced sections (no Source: line)" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/unsourced-due" --nudge
case_run "nudge: a fully sourced library reports no unsourced sections" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "unsourced"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/nothing-due"
# #203: a field is read from the frontmatter, not the whole file. A last_swept: line in the body is
# prose; read as a declaration, it made a library never swept look swept an hour ago.
build_clean "$NFX/kb/body-swept"
patch "$NFX/kb/body-swept/INDEX.md" '/^last_swept:/d'
printf '\nlast_swept: %s\n' "$KB_TODAY" >> "$NFX/kb/body-swept/INDEX.md"
case_run "kb-due: a last_swept: line in the body is not a sweep (#203)" 0 "body-swept: never swept" -- \
  env HOME="$TMP/archhome" "$ENGINE/scripts/kb-due" "$NFX/kb/body-swept" --quiet
# Issue #63: a stale fact with no Recheck is due too. kb-verify cannot settle it, so it is its own
# category, told apart from rechecks a command can run, and it is not capped by verifier_budget.
build_clean "$NFX/kb/stale-noassert" --swept "$KB_TODAY" --stamp 2026-01-01
for i in 1 2 3 4 5 6; do
  printf '\n## Limit %s\n\nA widget holds %s.\n\nSource: manual\nVerified: 2026-01-01 · by: agent · method: manual\n' "$i" "$i" >> "$NFX/kb/stale-noassert/widgets.md"
done
printf '\n## Fresh\n\nNew.\n\nSource: manual\nVerified: %s · by: agent · method: manual\n' "$KB_TODAY" >> "$NFX/kb/stale-noassert/widgets.md"
case_run "nudge: stale facts with no Recheck are reported, all of them, past the budget" 0 \
  "7 stale facts with no assertion" -- "$ENGINE/scripts/kb-due" "$NFX/kb/stale-noassert" --nudge
case_run "nudge: ...and not as facts a recheck can run" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "due for recheck"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/stale-noassert"
# recheck-due holds one stale fact with a Recheck and build_clean's stale one without: 1, not 2.
case_run "nudge: a stale fact WITH a Recheck is not also counted as having none" 0 "1 stale fact with no assertion" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/recheck-due" --nudge
# Without check-kb beside it, kb-due loses only the categories that use its rules: the unstamped
# count (issue #30). One warning; the rest intact. The recheck count no longer needs check-kb: its
# horizon and short lease are read through kbengine (#203).
