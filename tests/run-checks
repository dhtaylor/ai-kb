  bash -c 'cd "$1" && env -i HOME="$2" PATH="$PATH" "$3" --subagent | grep -qF "Due for a librarian"' _ \
  "$TMP/session-cwd" "$SHOME" "$SFX/scripts/kb-session-start"

# --------------------------------------------------------- check-secrets ----
# The check with the most expensive failure, and until now the only one with no
# case here. The fixture's credential is ASSEMBLED at run time: written literally,
# it would sit in this file and trip check-secrets over the engine itself.
mkdir -p "$TMP/sec"; git init -q "$TMP/sec"
printf 'key = "%s%s"\n' "AKIA" "ABCDEFGHIJKLMNOP" > "$TMP/sec/config.txt"
git -C "$TMP/sec" add -A >/dev/null 2>&1
case_run "staged credential is caught" 1 "" -- \
  sh -c "cd '$TMP/sec' && '$ENGINE/scripts/check-secrets'"

mkdir -p "$TMP/sec2"; git init -q "$TMP/sec2"
printf 'key = "not-a-credential"\n' > "$TMP/sec2/config.txt"
git -C "$TMP/sec2" add -A >/dev/null 2>&1
case_run "ordinary staged text is not a credential" 0 "clean" -- \
  sh -c "cd '$TMP/sec2' && '$ENGINE/scripts/check-secrets'"

# A credential removed in a later commit is still in history — the fact
# secret-governance.md states, and the reason --all walks every blob.
git -C "$TMP/sec" -c user.email=t@t -c user.name=t commit -qm add >/dev/null 2>&1
rm "$TMP/sec/config.txt"; git -C "$TMP/sec" add -A >/dev/null 2>&1
git -C "$TMP/sec" -c user.email=t@t -c user.name=t commit -qm remove >/dev/null 2>&1
case_run "credential deleted but still in history is caught by --all" 1 "" -- \
  sh -c "cd '$TMP/sec' && '$ENGINE/scripts/check-secrets' --all"

