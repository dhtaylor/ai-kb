# ------------------------------- links_to: where a linked library comes from (ADR-0020, 2.6) ----
# A library names the origin of each library it links into. Origins compare by host and path, so the
# https and ssh forms of one repository are the same; a different origin is a dependency mismatch,
# which warns (the consumer can't fix a published library) instead of failing as a dead link.
same_origin() { python3 -c 'import importlib.machinery as m, importlib.util as u, sys
sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[1] + "/scripts")   # kb-libraries imports kbengine, found beside it as a script finds it
l = m.SourceFileLoader("kl", sys.argv[1] + "/scripts/kb-libraries"); s = u.spec_from_loader("kl", l)
k = u.module_from_spec(s); l.exec_module(k); sys.exit(0 if k.same_origin(sys.argv[2], sys.argv[3]) else 1)' "$ENGINE" "$1" "$2"; }
case_run "origins: https and ssh forms of one repository are the same" 0 "" -- same_origin https://example.com/acme/lib.git git@example.com:acme/lib
