#!/usr/bin/env bash
# run-checks — prove the guardrails still catch what they were written to catch.
#
# WHY: every check in scripts/ has been broken at least once, by its own author,
# and each time it was found by a person happening to look:
#
#   check-exec-bits matched `scripts/check-*` and missed two new scripts, which
#     were then "Permission denied" in every clone;
#   check-xlinks excluded episodic/ and called a live citation dead;
#   check-scope lost four spaces of indentation and silently checked only the
#     last library it was given;
#   check-golden counted a record that had drifted outside its code fence.
#
# Three of those passed CI. A guardrail nobody tests is a guardrail you hope
# about. Each case below breaks one thing on purpose and requires the check to
# notice — the negative control, applied to the checkers themselves.
#
# Fixtures are BUILT HERE, not committed: a tree full of deliberate defects
# sitting in the repo is something another check will eventually read and flag.
# Each one is a git repo where it must be, because check-scope tells a library
# from a project tree by whether it has its own .git.
#
# Usage: tests/run-checks [-v]
# Exit 0 when every case behaves as specified.
set -uo pipefail

ENGINE="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)"
VERBOSE=${1:-}
PASS=0; FAIL=0
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

fm() { # frontmatter: name, scope, [extra]
  printf -- '---\nname: %s\ndescription: a test fixture.\nmemory_type: reference\ndomain: fx\nscope: %s\n%smetadata:\n  type: topic\n  node_type: memory\n  created: 2026-09-22\ntags: [fx]\nkeywords: [fx]\n---\n' "$1" "$2" "${3:-}"
}

# A valid library: router, one fact, a conformant golden set. Every defect fixture
# below is this, with exactly one thing broken.
build_clean() {
  local d="$1" scope="${2:-general}"
  mkdir -p "$d"
  fm fx-index "$scope" $'freshness_horizon: 90d\nverifier_budget: 5\nsweep_interval: 30d\nlast_swept: never\n' > "$d/INDEX.md"
  printf '# fx\n\n- [widgets](widgets.md) — what widgets do\n' >> "$d/INDEX.md"
  fm widgets "$scope" > "$d/widgets.md"
  printf '# Widgets\n\n## Limits\n\nA widget holds up to 12 things.\n\nSource: manual\nVerified: 2026-09-22 · by: agent · method: manual\n' >> "$d/widgets.md"
  fm fx-golden "$scope" > "$d/fx-golden.md"
  cat >> "$d/fx-golden.md" <<'GOLDEN'
# fx golden set

Unresolved case: not applicable — no CONFLICTED section here.
Cross-root case: not applicable — this fixture links to no other library.

```yaml
- case: positive
  question: How many things does a widget hold?
  expected_file: widgets.md
  expected_excerpt: "up to 12 things"

- case: negative
  question: What is the deploy target?
  expected_file: ""
  expected_excerpt: "fact not found — check KB"

- case: negative
  question: Who owns the widget service?
  expected_file: ""
  expected_excerpt: "fact not found — check KB"
```
GOLDEN
  git init -q "$d" && git -C "$d" add -A 2>/dev/null
}

# case <name> <expected-exit> <expected-substring> -- <command...>
case_run() {
  local name="$1" want_exit="$2" want_text="$3"; shift 4
  local out rc
  out=$("$@" 2>&1); rc=$?
  # An empty want_text means the exit status is the whole claim — grep finds
  # nothing in empty output, so it cannot stand in for "no requirement".
  if [ "$rc" = "$want_exit" ] && { [ -z "$want_text" ] || printf '%s' "$out" | grep -qF -- "$want_text"; }; then
    PASS=$((PASS+1)); [ -n "$VERBOSE" ] && printf '  ok    %s\n' "$name"
  else
    FAIL=$((FAIL+1))
    printf '  FAIL  %s\n' "$name"
    printf '        wanted exit %s containing: %s\n' "$want_exit" "$want_text"
    printf '        got exit %s:\n' "$rc"
    printf '%s\n' "$out" | sed 's/^/          /' | head -6
  fi
}

echo "run-checks: $ENGINE"

# ---------------------------------------------------------------- check-kb ----
build_clean "$TMP/clean"
case_run "clean library passes check-kb" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/clean"

build_clean "$TMP/orphan"
fm stray general > "$TMP/orphan/stray.md"; printf '# Stray\n\nNothing routes here.\n' >> "$TMP/orphan/stray.md"
case_run "unrouted file is an orphan" 1 "orphan" -- "$ENGINE/scripts/check-kb" "$TMP/orphan"

build_clean "$TMP/subtree"
mkdir -p "$TMP/subtree/deep"
fm fx-sub general > "$TMP/subtree/deep/INDEX.md"; printf '# Deep\n\n- [buried](buried.md) — buried\n' >> "$TMP/subtree/deep/INDEX.md"
fm buried general > "$TMP/subtree/deep/buried.md"; printf '# Buried\n\nListed, but by an unrouted index.\n' >> "$TMP/subtree/deep/buried.md"
case_run "subtree under an unrouted sub-index is orphaned" 1 "deep/buried.md" -- "$ENGINE/scripts/check-kb" "$TMP/subtree"

build_clean "$TMP/badname"
sed -i 's/^name: widgets$/name: gadgets/' "$TMP/badname/widgets.md"
case_run "name that disagrees with filename" 1 "does not match filename" -- "$ENGINE/scripts/check-kb" "$TMP/badname"

build_clean "$TMP/deadlink"
printf '\nSee [[nowhere]].\n' >> "$TMP/deadlink/widgets.md"
case_run "dead [[slug]] link" 1 "dead" -- "$ENGINE/scripts/check-kb" "$TMP/deadlink"

build_clean "$TMP/collide"
mkdir -p "$TMP/collide/widgets"
fm inner general > "$TMP/collide/widgets/inner.md"; printf '# Inner\n\ntext\n' >> "$TMP/collide/widgets/inner.md"
printf -- '- [widgets-folder](widgets/inner.md) — inner\n' >> "$TMP/collide/INDEX.md"
case_run "file colliding with a folder name" 1 "collides with directory" -- "$ENGINE/scripts/check-kb" "$TMP/collide"

build_clean "$TMP/badfm"
sed -i 's/^domain: fx$/domain fx/' "$TMP/badfm/widgets.md"          # a key with no colon
case_run "malformed frontmatter is reported, not skipped" 1 "unparseable frontmatter" -- \
  "$ENGINE/scripts/check-kb" "$TMP/badfm"

# The toolchain runs in every commit hook on every machine, and on CI runners that
# install nothing. check-kb once imported PyYAML: it worked for its author and was
# a traceback everywhere else, including on the runner, which had never exercised
# it because the engine holds no knowledge for it to read.
case_run "no script depends on a third-party module" 1 "" -- \
  grep -rlE "^import (yaml|requests|jinja2)|^from (yaml|requests|jinja2) " "$ENGINE/scripts"

# ------------------------------------------------------------- check-scope ----
build_clean "$TMP/scopeok"
case_run "clean library passes check-scope" 0 "clean" -- "$ENGINE/scripts/check-scope" "$TMP/scopeok"

build_clean "$TMP/scopemix"
sed -i 's/^scope: general$/scope: product:acme/' "$TMP/scopemix/widgets.md"
case_run "file scope disagreeing with its library" 1 "disagrees with its library" -- "$ENGINE/scripts/check-scope" "$TMP/scopemix"

build_clean "$TMP/libwithrepo" "repo:fx"
case_run "library declaring a repo: tier" 1 "general-tier home" -- "$ENGINE/scripts/check-scope" "$TMP/libwithrepo"

# A project tree is one with no .git of its own, sitting inside a repository.
mkdir -p "$TMP/proj"; git init -q "$TMP/proj"
build_clean "$TMP/proj/knowledge" "general"; rm -rf "$TMP/proj/knowledge/.git"
case_run "project tree declaring a general tier" 1 "project tree" -- "$ENGINE/scripts/check-scope" "$TMP/proj/knowledge"

build_clean "$TMP/escape"
printf '\nSee [the engine](../../CONVENTIONS.md).\n' >> "$TMP/escape/widgets.md"
case_run "relative link climbing out of a library" 1 "climbs out" -- "$ENGINE/scripts/check-scope" "$TMP/escape"

# ------------------------------------------------------------ check-golden ----
build_clean "$TMP/goldok"
case_run "conformant golden set passes" 0 "clean" -- "$ENGINE/scripts/check-golden" "$TMP/goldok"

build_clean "$TMP/goldexcerpt"
sed -i 's/up to 12 things/up to 20 things/' "$TMP/goldexcerpt/fx-golden.md"
case_run "golden excerpt not in the file it names" 1 "excerpt not found" -- "$ENGINE/scripts/check-golden" "$TMP/goldexcerpt"

build_clean "$TMP/goldfile"
sed -i 's/expected_file: widgets.md/expected_file: nowhere.md/' "$TMP/goldfile/fx-golden.md"
case_run "golden record naming a missing file" 1 "does not exist" -- "$ENGINE/scripts/check-golden" "$TMP/goldfile"

build_clean "$TMP/goldneg"
python3 - "$TMP/goldneg/fx-golden.md" <<'PY'
import sys, pathlib, re
p = pathlib.Path(sys.argv[1]); t = p.read_text()
p.write_text(t[:t.index("- case: negative\n  question: Who owns")] + "```\n")
PY
case_run "golden set with fewer than two negatives" 1 "negative case" -- "$ENGINE/scripts/check-golden" "$TMP/goldneg"

# An UNRESOLVED case tests the refusal of a disputed fact. Its excerpt is the fixed
# phrase ("disputed — not served"), which is in no fact file, so it cannot be grepped
# for there. Instead the file it names must genuinely hold a CONFLICTED section: the
# case must point at a real dispute, not a fiction written to satisfy a count.
build_unresolved() { # build_unresolved <dir> <excerpt> <conflicted-file-marker>
  build_clean "$1"
  printf -- '# Gizmos\n\n## Capacity\n\nstatus: %s\n\nClaim A: 12. Claim B: 20.\n' "$3" > "$1/gizmos.md"
  python3 - "$1/fx-golden.md" "$2" <<'PY'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); t = p.read_text()
rec = ("- case: unresolved\n  question: How many things does a gizmo hold?\n"
       "  expected_file: gizmos.md\n  expected_excerpt: \"" + sys.argv[2] + "\"\n\n")
i = t.index("- case: negative")
p.write_text(t[:i] + rec + t[i:])
PY
}
# A file may state one fact in two sentences (a summary and the source it quotes).
# alt_excerpt names the second; it is held to exactly the same standard as the first.
build_alt() { # build_alt <dir> <alt excerpt> [case-to-attach-to]
  build_clean "$1"
  printf 'Twelve things is the most a widget can hold.\n' >> "$1/widgets.md"
  python3 - "$1/fx-golden.md" "$2" "${3:-positive}" <<'PY'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); t = p.read_text()
anchor = {"positive": '  expected_excerpt: "up to 12 things"\n',
          "negative": '  expected_excerpt: "fact not found — check KB"\n'}[sys.argv[3]]
p.write_text(t.replace(anchor, anchor + '  alt_excerpt: "' + sys.argv[2] + '"\n', 1))
PY
}
build_alt "$TMP/goldalt" "Twelve things is the most a widget can hold"
case_run "alt_excerpt present in the file passes" 0 "clean" -- "$ENGINE/scripts/check-golden" "$TMP/goldalt"
build_alt "$TMP/goldalt2" "Twenty things is the most a widget can hold"
case_run "alt_excerpt absent from the file is oracle rot" 1 "alt_excerpt not found" -- "$ENGINE/scripts/check-golden" "$TMP/goldalt2"
build_alt "$TMP/goldalt3" "anything at all" negative
case_run "alt_excerpt on a refusal case is refused" 1 "alt_excerpt" -- "$ENGINE/scripts/check-golden" "$TMP/goldalt3"
alt() { # alt <name> <want-exit> <want-text> <library> <Q1 record>
  printf '%s\nQ2||fact not found — check KB\nQ3||fact not found — check KB\n' "$5" > "$4/answers"
  case_run "$1" "$2" "$3" -- "$ENGINE/scripts/grade-eval" "$4" "$4/answers"
}
alt "grade-eval: quoting the alternative sentence is grounded" 0 "3/3 passed" "$TMP/goldalt" \
  'Q1|widgets.md|At most twelve: "Twelve things is the most a widget can hold."'
alt "grade-eval: quoting neither sentence still fails" 1 "excerpt not in answer" "$TMP/goldalt" \
  'Q1|widgets.md|A widget carries about a dozen.'
alt "grade-eval: an alternative missing from the file is oracle rot" 1 "ORACLE ROT" "$TMP/goldalt2" \
  'Q1|widgets.md|A widget holds up to 12 things.'

build_unresolved "$TMP/goldun" "disputed — not served" "CONFLICTED"
case_run "unresolved case: refusal phrase, file holds a real conflict" 0 "clean" -- "$ENGINE/scripts/check-golden" "$TMP/goldun"
build_unresolved "$TMP/goldun2" "disputed — not served" "settled"
case_run "unresolved case naming a file with no CONFLICTED section" 1 "no CONFLICTED section" -- "$ENGINE/scripts/check-golden" "$TMP/goldun2"
build_unresolved "$TMP/goldun3" "status: CONFLICTED" "CONFLICTED"
case_run "unresolved case whose excerpt is not the refusal phrase" 1 "disputed — not served" -- "$ENGINE/scripts/check-golden" "$TMP/goldun3"

# ----------------------------------------------------------- check-xlinks ----
mkdir -p "$TMP/kb"; build_clean "$TMP/kb/alpha"; build_clean "$TMP/kb/beta"
printf '\nSee [[beta:widgets]].\n' >> "$TMP/kb/alpha/widgets.md"
case_run "live cross-library link resolves" 0 "0 dead" -- "$ENGINE/scripts/check-xlinks" "$TMP/kb"

printf '\nAnd [[beta:no-such-thing]].\n' >> "$TMP/kb/alpha/widgets.md"
case_run "dead cross-library link fails" 1 "has no slug" -- "$ENGINE/scripts/check-xlinks" "$TMP/kb"

# episodic/ is a legitimate citation target: a session note is routed and citable.
# Excluding it from the slug index called a live citation dead — the bug that shipped.
mkdir -p "$TMP/kb/beta/episodic"
fm 2026-09-22-a-session-note general > "$TMP/kb/beta/episodic/2026-09-22-a-session-note.md"
printf '# A session note\n\nWhat happened.\n' >> "$TMP/kb/beta/episodic/2026-09-22-a-session-note.md"
fm episodic-index general > "$TMP/kb/beta/episodic/INDEX.md"
printf '# Episodic\n\n- [2026-09-22-a-session-note](2026-09-22-a-session-note.md) — a note\n' >> "$TMP/kb/beta/episodic/INDEX.md"
printf -- '- [episodic](episodic/INDEX.md) — session notes\n' >> "$TMP/kb/beta/INDEX.md"
build_clean "$TMP/kb/gammaless" >/dev/null 2>&1 || true
rm -rf "$TMP/kb/gammaless"
mkdir -p "$TMP/kb3"; build_clean "$TMP/kb3/alpha"; build_clean "$TMP/kb3/beta"
mkdir -p "$TMP/kb3/beta/episodic"
fm 2026-09-22-a-session-note general > "$TMP/kb3/beta/episodic/2026-09-22-a-session-note.md"
printf '# A session note\n\nWhat happened.\n' >> "$TMP/kb3/beta/episodic/2026-09-22-a-session-note.md"
fm episodic-index general > "$TMP/kb3/beta/episodic/INDEX.md"
printf '# Episodic\n\n- [2026-09-22-a-session-note](2026-09-22-a-session-note.md) — a note\n' >> "$TMP/kb3/beta/episodic/INDEX.md"
printf -- '- [episodic](episodic/INDEX.md) — session notes\n' >> "$TMP/kb3/beta/INDEX.md"
printf '\nSee [[beta:2026-09-22-a-session-note]].\n' >> "$TMP/kb3/alpha/widgets.md"
case_run "citation of another library's session note resolves" 0 "0 dead" -- "$ENGINE/scripts/check-xlinks" "$TMP/kb3"

mkdir -p "$TMP/kb2"; build_clean "$TMP/kb2/alpha"
printf '\nSee [[gamma:widgets]].\n' >> "$TMP/kb2/alpha/widgets.md"
case_run "link into an absent library only warns" 0 "unresolvable" -- "$ENGINE/scripts/check-xlinks" "$TMP/kb2"

# a project tree's links are resolved when it is passed as an extra tree
mkdir -p "$TMP/proj2"; git init -q "$TMP/proj2"
build_clean "$TMP/proj2/knowledge" "repo:proj2"; rm -rf "$TMP/proj2/knowledge/.git"
printf '\nSee [[beta:not-a-slug]].\n' >> "$TMP/proj2/knowledge/widgets.md"
case_run "project tree's cross-library link is checked" 1 "has no slug" -- \
  "$ENGINE/scripts/check-xlinks" "$TMP/kb" "$TMP/proj2/knowledge"

# ---------------------------------------- library pre-commit hook: xlinks ----
# check-xlinks is regression-tested above, but nothing had run it against real
# content at the point a link actually breaks: a library's own pre-commit hook
# never called it. These cases exercise the CANONICAL hook template embedded in
# kb-create-domain/SKILL.md — extracted from its fenced block, not retyped —
# so drift between the template and this test cannot hide a regression.

SKILL="$ENGINE/plugins/knowledge-tools/skills/kb-create-domain/SKILL.md"
TEMPLATE_HOOK="$TMP/template-pre-commit"
if ! python3 - "$SKILL" "$TEMPLATE_HOOK" <<'PY'
import re, sys
src_path, out_path = sys.argv[1], sys.argv[2]
src = open(src_path).read()
blocks = re.findall(r'```bash\n(.*?)```', src, re.S)
if len(blocks) != 1:
    sys.exit(f"expected exactly one ```bash fenced block in {src_path}, found {len(blocks)}")
body = blocks[0]
if not body.startswith("#!/usr/bin/env bash") or "find_engine" not in body:
    sys.exit(f"the ```bash block in {src_path} no longer looks like the pre-commit hook template")
open(out_path, "w").write(body)
PY
then
  echo "run-checks: FATAL — could not extract the pre-commit hook template from $SKILL" >&2
  exit 2
fi
chmod +x "$TEMPLATE_HOOK"

install_hook() { # install_hook <library-dir> -- stage the template as its hook
  mkdir -p "$1/.githooks"
  cp "$TEMPLATE_HOOK" "$1/.githooks/pre-commit"
  chmod +x "$1/.githooks/pre-commit"
  git -C "$1" add -A
  git -C "$1" update-index --chmod=+x .githooks/pre-commit
}

# A hermetic HOME: this machine's real ~/.gitconfig sets kb.engineRoot to the
# real engine, and KB_ENGINE_ROOT is commonly set in the shell too (kb-bootstrap
# sets both) — either would make find_engine resolve to the real engine
# instead of the fixture below. env -i plus a HOME with no .gitconfig is the
# same hermetic pattern kb-verify's own Recheck assertions use.
FAKEHOME="$TMP/fakehome"; mkdir -p "$FAKEHOME"

# Case A: two libraries live under one engine's kb/, exactly where the template
# expects. B cites a fact in A; A's own commit then renames that fact away,
# leaving A itself clean but B's citation dangling. A's hook must catch it.
XENGINE="$TMP/xhook/engine"; mkdir -p "$XENGINE/kb"
ln -s "$ENGINE/scripts" "$XENGINE/scripts"
build_clean "$XENGINE/kb/alpha"
fm gadgets general > "$XENGINE/kb/alpha/gadgets.md"
printf '# Gadgets\n\nA gadget is a small useful thing.\n' >> "$XENGINE/kb/alpha/gadgets.md"
printf -- '- [gadgets](gadgets.md) — what a gadget is\n' >> "$XENGINE/kb/alpha/INDEX.md"
git -C "$XENGINE/kb/alpha" add -A
build_clean "$XENGINE/kb/beta"
printf '\nSee [[alpha:gadgets]].\n' >> "$XENGINE/kb/beta/widgets.md"
git -C "$XENGINE/kb/beta" add -A
install_hook "$XENGINE/kb/alpha"

# Break the cited fact — A's commit removes gadgets.md and its route.
rm -f "$XENGINE/kb/alpha/gadgets.md"
sed -i '/gadgets.md) — what a gadget is/d' "$XENGINE/kb/alpha/INDEX.md"
git -C "$XENGINE/kb/alpha" add -A

case_run "library hook blocks a commit that breaks a sibling's citation" 1 "has no slug" -- \
  sh -c "cd '$XENGINE/kb/alpha' && env -i HOME='$FAKEHOME' PATH='$PATH' ./.githooks/pre-commit"

# Case B: the same library, cloned OUTSIDE any engine's kb/ (KB_ENGINE_ROOT set
# by hand, the documented escape hatch) — siblings are not visible, so the
# hook must skip the cross-library check and say so, without failing.
mkdir -p "$TMP/standalone"
build_clean "$TMP/standalone"
install_hook "$TMP/standalone"
case_run "library outside the engine's kb/ skips cross-library links, does not fail" 0 \
  "cross-library links not checked" -- \
  sh -c "cd '$TMP/standalone' && env -i HOME='$FAKEHOME' PATH='$PATH' KB_ENGINE_ROOT='$XENGINE' ./.githooks/pre-commit"

# Case C: re-confirm, through the hook this time rather than the bare script,
# that a link into a library that simply is not installed only warns.
mkdir -p "$TMP/xhook3/engine/kb"
ln -s "$ENGINE/scripts" "$TMP/xhook3/engine/scripts"
build_clean "$TMP/xhook3/engine/kb/solo"
printf '\nSee [[gamma:widgets]].\n' >> "$TMP/xhook3/engine/kb/solo/widgets.md"
git -C "$TMP/xhook3/engine/kb/solo" add -A
install_hook "$TMP/xhook3/engine/kb/solo"
case_run "library hook warns, but does not fail, on a link into an absent library" 0 "unresolvable" -- \
  sh -c "cd '$TMP/xhook3/engine/kb/solo' && env -i HOME='$FAKEHOME' PATH='$PATH' ./.githooks/pre-commit"

# -------------------------------------------------------- check-exec-bits ----
mkdir -p "$TMP/bits/.githooks"; git init -q "$TMP/bits"
printf '#!/usr/bin/env bash\ntrue\n' > "$TMP/bits/.githooks/pre-commit"
git -C "$TMP/bits" add -A >/dev/null 2>&1
git -C "$TMP/bits" update-index --chmod=-x .githooks/pre-commit 2>/dev/null
case_run "hook recorded non-executable" 1 "NOT EXECUTABLE" -- "$ENGINE/scripts/check-exec-bits" "$TMP/bits"

mkdir -p "$TMP/bits2/scripts"; git init -q "$TMP/bits2"
printf '#!/usr/bin/env python3\nprint(1)\n' > "$TMP/bits2/scripts/do-thing"
git -C "$TMP/bits2" add -A >/dev/null 2>&1
git -C "$TMP/bits2" update-index --chmod=-x scripts/do-thing 2>/dev/null
case_run "shebang script recorded non-executable, whatever its name" 1 "do-thing" -- \
  "$ENGINE/scripts/check-exec-bits" "$TMP/bits2"

# --------------------------------------------------------- check-tool-scope ----
# tool_fixture <path> <key: tools|allowed-tools> <tier, or "" to omit> <tools value, or "" to omit>
tool_fixture() {
  local path="$1" key="$2" tier="$3" tools="$4"
  mkdir -p "$(dirname "$path")"
  {
    echo "---"
    echo "name: fx"
    echo "description: a test fixture."
    [ -n "$tools" ] && echo "$key: $tools"
    [ -n "$tier" ] && echo "tier: $tier"
    echo "---"
    echo "# fx"
  } > "$path"
}

mkdir -p "$TMP/toolscope/clean/agents" "$TMP/toolscope/clean/skills/kb-x"
tool_fixture "$TMP/toolscope/clean/agents/fx.md" tools retrieval "Read, Grep, Glob"
tool_fixture "$TMP/toolscope/clean/skills/kb-x/SKILL.md" allowed-tools curation "Read, Write, Bash"
case_run "clean tool-scope fixture passes" 0 "clean" -- \
  "$ENGINE/scripts/check-tool-scope" "$TMP/toolscope/clean"

mkdir -p "$TMP/toolscope/notier/agents"
tool_fixture "$TMP/toolscope/notier/agents/fx.md" tools "" "Read, Grep, Glob"
case_run "file missing a tier fails" 1 "no tier:" -- \
  "$ENGINE/scripts/check-tool-scope" "$TMP/toolscope/notier"

mkdir -p "$TMP/toolscope/noscope/agents"
tool_fixture "$TMP/toolscope/noscope/agents/fx.md" tools retrieval ""
case_run "file missing a tool-scope field fails" 1 "no tools:" -- \
  "$ENGINE/scripts/check-tool-scope" "$TMP/toolscope/noscope"

mkdir -p "$TMP/toolscope/overreach/agents"
tool_fixture "$TMP/toolscope/overreach/agents/fx.md" tools retrieval "Read, Grep, Glob, Write"
case_run "retrieval-tier file declaring Write fails" 1 \
  "outside the 'retrieval' tier's allowance" -- \
  "$ENGINE/scripts/check-tool-scope" "$TMP/toolscope/overreach"

mkdir -p "$TMP/toolscope/badtier/agents"
tool_fixture "$TMP/toolscope/badtier/agents/fx.md" tools bogus "Read, Grep, Glob"
case_run "unknown tier fails" 1 "unknown tier" -- \
  "$ENGINE/scripts/check-tool-scope" "$TMP/toolscope/badtier"

# ----------------------------------------------------------- kb-bootstrap ----
# kb-bootstrap writes machine-level config OUTSIDE this repo (a settings file,
# global git config, a shell rc) — the highest-blast-radius script here — so it
# must default to report-only, exactly like kb-verify's --yes. Build a fixture
# "engine" (the script needs CONVENTIONS.md, a marketplace.json and an
# executable kb-session-start to accept a directory as one) plus a hermetic
# HOME, so this test can never touch the real ~/.claude or ~/.gitconfig.
BFX="$TMP/bootstrap-fx"; mkdir -p "$BFX/scripts" "$BFX/.claude-plugin"
cp "$ENGINE/scripts/kb-bootstrap" "$BFX/scripts/kb-bootstrap"; chmod +x "$BFX/scripts/kb-bootstrap"
printf '# fixture contract\n' > "$BFX/CONVENTIONS.md"
printf '{"name":"fx-market","plugins":[{"name":"fx-plugin"}]}\n' > "$BFX/.claude-plugin/marketplace.json"
printf '#!/usr/bin/env bash\ntrue\n' > "$BFX/scripts/kb-session-start"
chmod +x "$BFX/scripts/kb-session-start"
BHOME="$TMP/bootstrap-home"; mkdir -p "$BHOME"

case_run "no flag: reports drift, changes nothing" 1 "would-set" -- \
  env -i HOME="$BHOME" PATH="$PATH" "$BFX/scripts/kb-bootstrap"
case_run "no flag: settings.json was not created" 1 "" -- test -e "$BHOME/.claude/settings.json"
case_run "no flag: global git config was not touched" 1 "" -- \
  env -i HOME="$BHOME" PATH="$PATH" git config --global --get kb.engineRoot
case_run "--check: same report-only behaviour, spelled out" 1 "would-set" -- \
  env -i HOME="$BHOME" PATH="$PATH" "$BFX/scripts/kb-bootstrap" --check

env -i HOME="$BHOME" PATH="$PATH" "$BFX/scripts/kb-bootstrap" --apply >/dev/null 2>&1
case_run "--apply: settings.json now names the fixture engine" 0 "$BFX" -- \
  cat "$BHOME/.claude/settings.json"
case_run "--apply: global git config now names the fixture engine" 0 "$BFX" -- \
  env -i HOME="$BHOME" PATH="$PATH" git config --global --get kb.engineRoot

# ------------------------------------------------------------- kb-verify ----
build_clean "$TMP/vpass"
printf 'Recheck: true\n' >> "$TMP/vpass/widgets.md"
case_run "passing assertion is reported, not applied" 0 "still hold" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vpass" --all --yes

build_clean "$TMP/vfail"
printf 'Recheck: false\n' >> "$TMP/vfail/widgets.md"
case_run "failing assertion exits 1" 1 "FAILED" -- "$ENGINE/scripts/kb-verify" "$TMP/vfail" --all --yes

build_clean "$TMP/vfail2"
printf 'Recheck: false\n' >> "$TMP/vfail2/widgets.md"
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: agent · method: manual/' "$TMP/vfail2/widgets.md"
"$ENGINE/scripts/kb-verify" "$TMP/vfail2" --all --yes --apply >/dev/null 2>&1
# the old date must survive --apply: a verifier that restamps what it just
# contradicted destroys the evidence that something changed.
case_run "a failing assertion's stamp is never rewritten" 0 "Verified: 2026-01-01" -- \
  grep -F "Verified:" "$TMP/vfail2/widgets.md"

build_clean "$TMP/vnone"
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: agent · method: manual/' "$TMP/vnone/widgets.md"
case_run "stale section with no assertion is named, not skipped" 0 "no assertion" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vnone" --all

# kb-verify's own --yes gate (§3 of its docstring): without it, a Recheck command
# is printed, never executed. Prove it with an observable side effect — a rewritten
# date can be missed by eye, a file that must-not-exist cannot.
build_clean "$TMP/vgate"
printf 'Recheck: touch "%s/vgate-sentinel"\n' "$TMP" >> "$TMP/vgate/widgets.md"
case_run "no --yes: the command is printed, not run" 0 "NOT run" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vgate" --all
case_run "no --yes: its side effect never happened" 1 "" -- test -e "$TMP/vgate-sentinel"

"$ENGINE/scripts/kb-verify" "$TMP/vgate" --all --yes >/dev/null 2>&1
case_run "--yes: the command actually runs" 0 "" -- test -e "$TMP/vgate-sentinel"

# ------------------------------------------- kb-verify: Verifier fixture ----
# Exit criterion (§5A "Testing the librarian agents"): against a fact seeded stale
# and wrong, the Verifier must produce a flag, not a false-fresh stamp. Deliberate
# divergence from the plan text: §9.13 records the built design — a failure is
# reported and the fact left untouched, never written to contradictions.md,
# because automating the choice between a stale fact, a wrong assertion and a
# real contradiction destroys the evidence a human needs; this fixture asserts
# the built design, not the plan's original wording.
#
# The fixture's "local system" is a config file beside the facts; each Recheck
# greps it. One default (non --all) run below exercises staleness filtering,
# the untouched wrong fact, and the restamped true fact together.
# Dates are computed, never typed: a literal "today" turns this into a test that
# fails on its own the next morning.
VTODAY=$(date +%F)
build_clean "$TMP/vfixture"
printf 'port=8080\n' > "$TMP/vfixture/system-config.txt"

fm stale-wrong general > "$TMP/vfixture/stale-wrong.md"
cat >> "$TMP/vfixture/stale-wrong.md" <<'EOF'
# Stale Wrong

## Port

The service listens on port 9090.

Source: manual
Verified: 2026-01-01 · by: human · method: query
Recheck: grep -q '^port=9090$' system-config.txt
EOF

fm stale-true general > "$TMP/vfixture/stale-true.md"
cat >> "$TMP/vfixture/stale-true.md" <<'EOF'
# Stale True

## Port

The service listens on port 8080.

Source: manual
Verified: 2026-01-01 · by: human · method: query
Recheck: grep -q '^port=8080$' system-config.txt
EOF

fm fresh-fact general > "$TMP/vfixture/fresh-fact.md"
cat >> "$TMP/vfixture/fresh-fact.md" <<EOF
# Fresh Fact

## Timeout

The request timeout is 30 seconds.

Source: manual
Verified: $VTODAY · by: agent · method: query
Recheck: touch "$TMP/vfixture-sentinel"
EOF

printf -- '- [stale-wrong](stale-wrong.md) — a stale, wrong fact\n- [stale-true](stale-true.md) — a stale, true fact\n- [fresh-fact](fresh-fact.md) — a fresh fact\n' >> "$TMP/vfixture/INDEX.md"
cp "$TMP/vfixture/stale-wrong.md" "$TMP/vfixture/stale-wrong.md.orig"

case_run "verifier fixture: stale wrong fact is reported failing, not false-fresh" 1 \
  "FAIL stale-wrong.md § Port" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vfixture" --yes --apply

case_run "verifier fixture: stale wrong fact's file is byte-for-byte unchanged" 0 "" -- \
  cmp -s "$TMP/vfixture/stale-wrong.md" "$TMP/vfixture/stale-wrong.md.orig"

case_run "verifier fixture: stale true fact is restamped to today" 0 "Verified: $VTODAY" -- \
  grep -F "Verified:" "$TMP/vfixture/stale-true.md"

case_run "verifier fixture: fresh fact's Recheck is not run when it is not due" 1 "" -- \
  test -e "$TMP/vfixture-sentinel"

# Negative control for the line above: on a separate copy (the run just above already
# restamped stale-true.md, so it cannot be reused), force selection with --all to prove
# the sentinel assertion CAN fire — an assertion that cannot fail is worse than none
# (§7, §9.13).
build_clean "$TMP/vfixture-all"
fm fresh-fact general > "$TMP/vfixture-all/fresh-fact.md"
cat >> "$TMP/vfixture-all/fresh-fact.md" <<EOF
# Fresh Fact

## Timeout

The request timeout is 30 seconds.

Source: manual
Verified: $VTODAY · by: agent · method: query
Recheck: touch "$TMP/vfixture-all-sentinel"
EOF
printf -- '- [fresh-fact](fresh-fact.md) — a fresh fact\n' >> "$TMP/vfixture-all/INDEX.md"
"$ENGINE/scripts/kb-verify" "$TMP/vfixture-all" --all --yes >/dev/null 2>&1
case_run "verifier fixture: --all forces the fresh fact's Recheck to run" 0 "" -- \
  test -e "$TMP/vfixture-all-sentinel"

# --yes without --apply: nothing is restamped at all. A fresh copy of the true fact
# is needed because the first run above already restamped its stale-true.md.
build_clean "$TMP/vfixture-noapply"
printf 'port=8080\n' > "$TMP/vfixture-noapply/system-config.txt"
fm stale-true general > "$TMP/vfixture-noapply/stale-true.md"
cat >> "$TMP/vfixture-noapply/stale-true.md" <<'EOF'
# Stale True

## Port

The service listens on port 8080.

Source: manual
Verified: 2026-01-01 · by: human · method: query
Recheck: grep -q '^port=8080$' system-config.txt
EOF
printf -- '- [stale-true](stale-true.md) — a stale, true fact\n' >> "$TMP/vfixture-noapply/INDEX.md"
"$ENGINE/scripts/kb-verify" "$TMP/vfixture-noapply" --yes >/dev/null 2>&1
case_run "verifier fixture: --yes without --apply restamps nothing" 0 "Verified: 2026-01-01" -- \
  grep -F "Verified:" "$TMP/vfixture-noapply/stale-true.md"

# ------------------------------------------- kb-verify: needs-attention queue ----
# Phase 5 (plan §6 exit: "stale or drifted facts surface as a queue rather than rotting
# silently"). Built on the Verifier fixture above: its first run (line ~532) already ran
# stale-wrong.md's failing assertion under --yes --apply, so this is the queue that run
# produced, not a fresh one — proving the queue write happens as a side effect of the
# same run the byte-for-byte-unchanged check above already exercises, not a separate path.
VQ="$TMP/vfixture/needs-attention.md"
case_run "queue: a failing assertion under --yes writes exactly one entry" 0 "" -- \
  sh -c "[ \$(grep -c '^- id:' '$VQ') = 1 ]"
case_run "queue: entry names the failing file" 0 "" -- grep -qF 'file: "stale-wrong.md"' "$VQ"
case_run "queue: entry names the section" 0 "" -- grep -qF 'section: "Port"' "$VQ"
case_run "queue: entry carries the assertion" 0 "" -- grep -qF "grep -q '^port=9090\$' system-config.txt" "$VQ"
case_run "queue: entry carries the stamp it carried when it failed" 0 "" -- \
  grep -qF 'stamp: "2026-01-01 · by: human · method: query"' "$VQ"
case_run "queue: entry is open, for a human to triage" 0 "" -- grep -qF 'status: "open"' "$VQ"
case_run "queue: an assertion that ran and returned false is category stale-recheck" 0 "" -- \
  grep -qF 'category: "stale-recheck"' "$VQ"
case_run "queue: not miscategorized as the command-error variant" 1 "" -- \
  grep -qF 'category: "stale-recheck-error"' "$VQ"
case_run "queue: the passing stale-true fact gets no entry" 1 "" -- grep -qF 'file: "stale-true.md"' "$VQ"
case_run "queue: frontmatter still exactly bounded" 0 "" -- sh -c "[ \$(grep -c '^---\$' '$VQ') = 2 ]"
case_run "queue: fences still balanced" 0 "" -- sh -c "[ \$(( \$(grep -c '^\`\`\`' '$VQ') % 2 )) = 0 ]"
case_run "queue: frontmatter domain/scope copied from the library's own INDEX.md" 0 "" -- \
  grep -qF 'domain: fx' "$VQ"

# Re-run the same fixture: the still-failing assertion reproduces the same stable id and
# must dedupe, not pile up a second entry for the same unfixed claim.
"$ENGINE/scripts/kb-verify" "$TMP/vfixture" --yes --apply >/dev/null 2>&1
case_run "queue: re-run on the same failure dedupes, still exactly one entry" 0 "" -- \
  sh -c "[ \$(grep -c '^- id:' '$VQ') = 1 ]"

# A command that cannot be run at all (not a false assertion) is a different finding,
# distinguishable by category — the shell's own 127 "not found" is the unambiguous case.
build_clean "$TMP/vqueue-error"
cat >> "$TMP/vqueue-error/widgets.md" <<'EOF'
Recheck: this-command-does-not-exist-anywhere-xyz
EOF
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: human · method: query/' "$TMP/vqueue-error/widgets.md"
"$ENGINE/scripts/kb-verify" "$TMP/vqueue-error" --yes >/dev/null 2>&1
case_run "queue: a command that cannot be run is categorized distinctly" 0 "" -- \
  grep -qF 'category: "stale-recheck-error"' "$TMP/vqueue-error/needs-attention.md"

# Without --yes, nothing runs — so nothing is queued either, on a fixture that has never
# been queued before (unlike vfixture/vqueue-error above, which already have been).
build_clean "$TMP/vqueue-noyes"
printf 'Recheck: false\n' >> "$TMP/vqueue-noyes/widgets.md"
"$ENGINE/scripts/kb-verify" "$TMP/vqueue-noyes" --all >/dev/null 2>&1
case_run "queue: without --yes, no queue file is written" 1 "" -- \
  test -e "$TMP/vqueue-noyes/needs-attention.md"

# A queue is a file like any other (CONVENTIONS §3): created unrouted, it is an
# orphan, check-kb fails, and the library's own pre-commit blocks every commit.
case_run "kb-verify: queue is routed from the library's INDEX, exactly once" 0 "" -- \
  bash -c '[ "$(grep -c "](needs-attention.md)" "$1")" = 1 ]' _ "$TMP/vfixture/INDEX.md"
case_run "kb-verify: a library holding a fresh queue still passes check-kb" 0 "clean" -- \
  "$ENGINE/scripts/check-kb" "$TMP/vfixture"

# ---------------------------------------------------------------- kb-due ----
build_clean "$TMP/due"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$TMP/due/INDEX.md"   # computed: a typed date expires
case_run "recently swept tree is not due" 0 "0 of 1" -- "$ENGINE/scripts/kb-due" /nonexistent "$TMP/due"

build_clean "$TMP/overdue"
sed -i 's/^last_swept: never$/last_swept: 2026-01-01/' "$TMP/overdue/INDEX.md"
case_run "long-unswept tree is due" 0 "1 of 1" -- "$ENGINE/scripts/kb-due" /nonexistent "$TMP/overdue"

# ------------------------------------------------------- kb-due --nudge ----
# Phase 5 step 3: one nudge covers sweep-due, facts due for recheck (reusing kb-verify's
# own selection, never running it), open queue items (parsed with kb-watch's own
# parse_records), and episodic notes awaiting distillation. Silence is still the point: nothing due in
# any category prints nothing, exit 0.

# A fixture engine, so --nudge is exercised through engine/kb/* the way kb-session-start
# actually calls it, not just through a single tree argument.
NFX="$TMP/nudge-fx"; mkdir -p "$NFX/kb"

# 1. Nothing due anywhere: fresh sweep, a fresh agent-stamped fact with no Recheck, no
#    queue, no episodic/. --nudge must print nothing at all.
build_clean "$NFX/kb/nothing-due"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$NFX/kb/nothing-due/INDEX.md"
case_run "nudge: nothing due anywhere prints nothing" 0 "" -- \
  bash -c '[ -z "$("$1" "$2" --nudge)" ]' _ "$ENGINE/scripts/kb-due" "$NFX"

# 2. A stale fact carrying a Recheck: due for recheck, and the Recheck must NOT run —
#    proven with a sentinel file, the same technique kb-verify's own fixture uses.
build_clean "$NFX/kb/recheck-due"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$NFX/kb/recheck-due/INDEX.md"
NUDGE_SENTINEL="$TMP/nudge-sentinel"
rm -f "$NUDGE_SENTINEL"
fm stale-recheck general > "$NFX/kb/recheck-due/stale-recheck.md"
cat >> "$NFX/kb/recheck-due/stale-recheck.md" <<EOF
# Stale Recheck

## Port

The service listens on some port.

Source: manual
Verified: 2026-01-01 · by: agent · method: manual
Recheck: touch "$NUDGE_SENTINEL"
EOF
printf -- '- [stale-recheck](stale-recheck.md) — a stale fact with a Recheck\n' >> "$NFX/kb/recheck-due/INDEX.md"
case_run "nudge: a stale fact with Recheck is reported due" 0 "1 fact due for recheck" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$NFX/kb/recheck-due" --nudge
case_run "nudge: names the exact kb-verify command" 0 "kb-verify recheck-due --yes" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$NFX/kb/recheck-due" --nudge
case_run "nudge: the Recheck assertion itself is never run" 1 "" -- test -e "$NUDGE_SENTINEL"

# 3. An open queue item, built by actually running kb-verify --yes on a failing fact, so
#    the queue format being counted is the real one kb-verify writes — not a hand-rolled
#    stand-in. A second failing fact gives a second entry, which is then acknowledged by
#    hand (flipping only its status:, the one field a human triaging the queue would
#    change) to prove an acknowledged item is excluded from the count.
build_clean "$NFX/kb/queue-due"
cat >> "$NFX/kb/queue-due/widgets.md" <<'EOF'
Recheck: false
EOF
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: human · method: query/' "$NFX/kb/queue-due/widgets.md"
fm second-fact general > "$NFX/kb/queue-due/second-fact.md"
cat >> "$NFX/kb/queue-due/second-fact.md" <<'EOF'
# Second Fact

## Thing

Another claim.

Source: manual
Verified: 2026-01-01 · by: human · method: query
Recheck: false
EOF
printf -- '- [second-fact](second-fact.md) — a second stale, wrong fact\n' >> "$NFX/kb/queue-due/INDEX.md"
"$ENGINE/scripts/kb-verify" "$NFX/kb/queue-due" --yes >/dev/null 2>&1
case_run "nudge fixture: kb-verify queued exactly two open findings" 0 "" -- \
  sh -c "[ \$(grep -c '^- id:' '$NFX/kb/queue-due/needs-attention.md') = 2 ]"
case_run "nudge: two open queue items are counted" 0 "2 open queue item" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$NFX/kb/queue-due" --nudge
case_run "nudge: grouped by category" 0 "2 stale-recheck" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$NFX/kb/queue-due" --nudge
# Acknowledge one entry — a human's triage action, nothing kb-due itself ever does.
sed -i '0,/status: "open"/s//status: "acknowledged"/' "$NFX/kb/queue-due/needs-attention.md"
case_run "nudge: an acknowledged item is not counted" 0 "1 open queue item" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$NFX/kb/queue-due" --nudge
case_run "nudge: acknowledged count does not also read as two" 1 "" -- \
  bash -c '"$1" /nonexistent "$2" --nudge | grep -qF "2 open queue item"' _ \
  "$ENGINE/scripts/kb-due" "$NFX/kb/queue-due"

# 4. Episodic notes: no marker in this codebase distinguishes a distilled note from an
#    undistilled one (kb-distill leaves free-text prose, never a frontmatter field or
#    other machine-checkable sentinel — see kb-distill/SKILL.md Step 5 and the real
#    "## Distilled" / "## Distillation record" notes already in kb/claude-code-runtime
#    and kb/knowledge-architecture, which spell the heading two different ways). The
#    honest proxy is therefore a raw count, named as exactly that.
build_clean "$NFX/kb/episodic-due"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$NFX/kb/episodic-due/INDEX.md"
mkdir -p "$NFX/kb/episodic-due/episodic"
for n in 1 2; do
  printf -- '---\nname: 2026-01-0%s-note\ndescription: fixture\nmemory_type: episodic\ndomain: fx\nscope: general\nmetadata: {type: episodic, node_type: memory, created: 2026-01-0%s}\ntags: [fx, episodic]\nkeywords: [episodic]\n---\n# note %s\n' \
    "$n" "$n" "$n" > "$NFX/kb/episodic-due/episodic/2026-01-0$n-note.md"
done
printf -- '---\nname: episodic-index\ndescription: fixture\nmemory_type: reference\ndomain: fx\nscope: general\nmetadata: {type: index, node_type: router, created: 2026-01-01}\ntags: [fx]\nkeywords: [episodic]\n---\n# Episodic\n' \
  > "$NFX/kb/episodic-due/episodic/INDEX.md"
case_run "nudge: episodic notes are counted, INDEX.md excluded" 0 "2 episodic notes awaiting distillation" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$NFX/kb/episodic-due" --nudge
# A distilled note is not awaiting distillation. Both spellings in use are recognised: the
# canonical "## Distilled" (kb-distill Step 5) and older notes' "## Distillation record".
# Counting them would ask about the same notes at every session start, forever.
for h in "Distilled $(date +%F)" "Distillation record"; do
  f="$NFX/kb/episodic-due/episodic/2026-01-0$(( ${#h} % 7 + 3 ))-done.md"
  printf -- '---\nname: %s\ndescription: fixture\nmemory_type: episodic\ndomain: fx\nscope: general\nmetadata: {type: episodic, node_type: memory, created: 2026-01-01}\ntags: [fx, episodic]\nkeywords: [episodic]\n---\n# done\n\n## %s\nFacts went to x.md.\n' \
    "$(basename "$f" .md)" "$h" > "$f"
done
case_run "nudge: distilled notes (either heading spelling) are not counted" 0 "2 episodic notes awaiting distillation" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$NFX/kb/episodic-due" --nudge

# 5. A malformed (unreadable) queue file: one-line warning, never a crash, exit 0 — and
#    every other tree and category still gets reported. Root only: chmod 000 has no
#    effect for root, so the negative control would be vacuous there.
if [ "$(id -u)" != "0" ]; then
  build_clean "$NFX/kb/malformed-queue"
  cat > "$NFX/kb/malformed-queue/needs-attention.md" <<'EOF'
---
name: needs-attention
description: fixture
memory_type: reference
domain: fx
scope: general
metadata: {type: index, node_type: memory, created: 2026-01-01}
tags: [meta]
keywords: [queue]
---
# Needs attention

```yaml
- id: aaaaaaaa
  category: drift
  status: open
  source_id: x
  field: y
  old: "a"
  new: "b"
  source_url: "-"
  date: "2026-01-01"
```
EOF
  chmod 000 "$NFX/kb/malformed-queue/needs-attention.md"
  out=$("$ENGINE/scripts/kb-due" /nonexistent "$NFX/kb/malformed-queue" --nudge 2>&1); rc=$?
  chmod 644 "$NFX/kb/malformed-queue/needs-attention.md"   # restore so TMP cleanup can remove it
  case_run "nudge: malformed queue file never crashes the hook" 0 "" -- test "$rc" = 0
  case_run "nudge: malformed queue file is reported as a one-line warning" 0 "" -- \
    bash -c 'printf "%s" "$1" | grep -q "could not read needs-attention.md"' _ "$out"
fi

# -------------------------------------------- kb-session-start + --nudge, hermetic ----
# End-to-end: a fixture engine (this repo's own scripts, a throwaway CONVENTIONS.md, one
# fixture library) run as the real SessionStart hook would, with a hermetic HOME so this
# can never touch ~/.claude, and a cwd outside any git repo so the project-tree branch
# stays inert.
SFX="$TMP/session-fx"; mkdir -p "$SFX/scripts" "$SFX/kb"
for f in kb-session-start kb-due kb-verify kb-watch; do
  cp "$ENGINE/scripts/$f" "$SFX/scripts/$f"; chmod +x "$SFX/scripts/$f"
done
printf '# fixture contract\n' > "$SFX/CONVENTIONS.md"
SHOME="$TMP/session-home"; mkdir -p "$SHOME" "$TMP/session-cwd"

build_clean "$SFX/kb/libdue"
fm stale-recheck general > "$SFX/kb/libdue/stale-recheck.md"
cat >> "$SFX/kb/libdue/stale-recheck.md" <<'EOF'
# Stale Recheck

## Port

The service listens on some port.

Source: manual
Verified: 2026-01-01 · by: agent · method: manual
Recheck: true
EOF
printf -- '- [stale-recheck](stale-recheck.md) — a stale fact with a Recheck\n' >> "$SFX/kb/libdue/INDEX.md"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$SFX/kb/libdue/INDEX.md"

case_run "kb-session-start: nudge block appears when something is due" 0 \
  "Due for a librarian's attention" -- \
  sh -c "cd '$TMP/session-cwd' && env -i HOME='$SHOME' PATH='$PATH' '$SFX/scripts/kb-session-start'"
case_run "kb-session-start: names the due library and its recheck count" 0 \
  "libdue: 1 fact due for recheck" -- \
  sh -c "cd '$TMP/session-cwd' && env -i HOME='$SHOME' PATH='$PATH' '$SFX/scripts/kb-session-start'"

# A second fixture engine with nothing due at all: the block must be absent entirely.
SFX2="$TMP/session-fx-clean"; mkdir -p "$SFX2/scripts" "$SFX2/kb"
for f in kb-session-start kb-due kb-verify kb-watch; do
  cp "$ENGINE/scripts/$f" "$SFX2/scripts/$f"; chmod +x "$SFX2/scripts/$f"
done
printf '# fixture contract\n' > "$SFX2/CONVENTIONS.md"
build_clean "$SFX2/kb/libclean"
