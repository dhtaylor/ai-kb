  bash -c 'grep -B2 -A8 "stub: \"sources/s-busy.md\"" "$1" | grep -qF "category: \"source-unreachable\""' _ "$KHQ"
case_run "kb-sources: HEAD 429 sends no GET" 1 "" -- grep -qxF 'GET /busy' "$SRV/access.log"
case_run "kb-sources: HEAD 400 was retried with GET" 0 "" -- grep -qxF 'GET /head400' "$SRV/access.log"

