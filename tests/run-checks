# A Grep's exclusion glob (leading !) names what it skips, not what it touched. kb-retrieve is
# told to pass one, so a compliant agent must not fail for it; with a result, only the result counts.
mk_grep() { # mk_grep <out.jsonl> <path> <mode> <glob> <head_limit|-> <result|NONE> <then-Read file>
  python3 - "$@" <<'PY'
import json, sys
out, path, mode, glob, cap, res = sys.argv[1:7]
inp = {"pattern": "x", "path": path, "glob": glob, "output_mode": mode}
if cap != "-": inp["head_limit"] = int(cap)
recs = [{"type": "user", "message": {"role": "user", "content": "a question"}},
        {"type": "assistant", "message": {"role": "assistant", "content": [
            {"type": "tool_use", "id": "g0", "name": "Grep", "input": inp}]}}]
if res != "NONE":
    recs.append({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": "g0", "content": res}]}})
recs.append({"type": "assistant", "message": {"role": "assistant", "content": [
    {"type": "tool_use", "id": "r0", "name": "Read", "input": {"file_path": sys.argv[7]}}]}})
open(out, "w").write("\n".join(json.dumps(r) for r in recs) + "\n")
PY
}
