mkdir -p "$NFX/kb/episodic-due/episodic"
for n in 1 2; do
  printf -- '---\nname: 2026-01-0%s-note\ndescription: fixture\nmemory_type: episodic\ndomain: fx\nscope: general\nmetadata: {type: episodic, node_type: memory, created: 2026-01-0%s}\ntags: [fx, episodic]\nkeywords: [episodic]\n---\n# note %s\n' \
    "$n" "$n" "$n" > "$NFX/kb/episodic-due/episodic/2026-01-0$n-note.md"
done
printf -- '---\nname: episodic-index\ndescription: fixture\nmemory_type: reference\ndomain: fx\nscope: general\nmetadata: {type: index, node_type: router, created: 2026-01-01}\ntags: [fx]\nkeywords: [episodic]\n---\n# Episodic\n' \
  > "$NFX/kb/episodic-due/episodic/INDEX.md"
case_run "nudge: episodic notes are counted, INDEX.md excluded" 0 "2 episodic notes awaiting distillation" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/episodic-due" --nudge
# A distilled note is not awaiting distillation. Both spellings in use are recognised: the
# canonical "## Distilled" (kb-distill Step 5) and older notes' "## Distillation record".
# Counting them would ask about the same notes at every session start, forever.
for h in "Distilled $(date +%F)" "Distillation record"; do
  f="$NFX/kb/episodic-due/episodic/2026-01-0$(( ${#h} % 7 + 3 ))-done.md"
  printf -- '---\nname: %s\ndescription: fixture\nmemory_type: episodic\ndomain: fx\nscope: general\nmetadata: {type: episodic, node_type: memory, created: 2026-01-01}\ntags: [fx, episodic]\nkeywords: [episodic]\n---\n# done\n\n## %s\nFacts went to x.md.\n' \
    "$(basename "$f" .md)" "$h" > "$f"
done
case_run "nudge: distilled notes (either heading spelling) are not counted" 0 "2 episodic notes awaiting distillation" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/episodic-due" --nudge

# 4b. Unstamped sourced sections (issue #29): §7 ranks unknown ahead of stale, so the nudge
#     names them between sweeps. A CONFLICTED section, an episodic note and a source stub are
#     not counted: the first is not served, the others are records, not facts.
build_clean "$NFX/kb/unstamped-due"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$NFX/kb/unstamped-due/INDEX.md"
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n\n## Colour\n\nRed.\n\nSource: manual\n\n## Size\n\nstatus: CONFLICTED · since: 2026-01-01\n\nSource: manual\n' >> "$NFX/kb/unstamped-due/widgets.md"
mkdir -p "$NFX/kb/unstamped-due/episodic"
printf -- '---\nname: 2026-01-01-note\ndescription: fixture\nmemory_type: episodic\ndomain: fx\nscope: general\n---\n# note\n\n## Distilled\n\nSource: manual\n' > "$NFX/kb/unstamped-due/episodic/2026-01-01-note.md"
# A state leaf (§2) records questions and disputes, not facts: its Source: lines say where a
# question came from, and no stamp could ever clear it, so it is not counted either.
fm fx-open-questions general > "$NFX/kb/unstamped-due/fx-open-questions.md"
printf '# Open questions\n\n## Is it blue?\n\nNo source says.\n\nSource: manual\n' >> "$NFX/kb/unstamped-due/fx-open-questions.md"
printf -- '- [fx-open-questions](fx-open-questions.md) — open questions\n' >> "$NFX/kb/unstamped-due/INDEX.md"
case_run "nudge: unstamped sources are counted, CONFLICTED, episodic and state leaves excluded" 0 \
  "2 unstamped sources (never verified)" -- "$ENGINE/scripts/kb-due" "$NFX/kb/unstamped-due" --nudge
case_run "nudge: a fully stamped library reports no unstamped sections" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "unstamped"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/nothing-due"
# Issue #64: §6 stacks one stamp per source, so a Source: line with no Verified: of its own is
# unstamped even when the section's other source is stamped. Counted per Source: line.
build_clean "$NFX/kb/stacked-due"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$NFX/kb/stacked-due/INDEX.md"
sed -i "s/^Verified: 2026-09-22/Verified: $(date +%F)/" "$NFX/kb/stacked-due/widgets.md"
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\nSource: vendor sheet\nVerified: %s · by: agent · method: manual\n\n## Colour\n\nRed.\n\nSource: manual\nVerified: %s · by: agent · method: manual\nSource: vendor sheet\nVerified: %s · by: agent · method: manual\n' \
  "$(date +%F)" "$(date +%F)" "$(date +%F)" >> "$NFX/kb/stacked-due/widgets.md"
case_run "nudge: a stacked source with no stamp of its own is counted" 0 "1 unstamped source (never verified)" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/stacked-due" --nudge
# Issue #63: a stale fact with no Recheck is due too. kb-verify cannot settle it, so it is its own
# category, told apart from rechecks a command can run, and it is not capped by verifier_budget.
build_clean "$NFX/kb/stale-noassert"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$NFX/kb/stale-noassert/INDEX.md"
sed -i "s/^Verified: 2026-09-22/Verified: 2026-01-01/" "$NFX/kb/stale-noassert/widgets.md"
for i in 1 2 3 4 5 6; do
  printf '\n## Limit %s\n\nA widget holds %s.\n\nSource: manual\nVerified: 2026-01-01 · by: agent · method: manual\n' "$i" "$i" >> "$NFX/kb/stale-noassert/widgets.md"
done
printf '\n## Fresh\n\nNew.\n\nSource: manual\nVerified: %s · by: agent · method: manual\n' "$(date +%F)" >> "$NFX/kb/stale-noassert/widgets.md"
case_run "nudge: stale facts with no Recheck are reported, all of them, past the budget" 0 \
  "7 stale facts with no assertion" -- "$ENGINE/scripts/kb-due" "$NFX/kb/stale-noassert" --nudge
case_run "nudge: ...and not as facts a recheck can run" 1 "" -- \
  bash -c '"$1" "$2" --nudge | grep -qF "due for recheck"' _ "$ENGINE/scripts/kb-due" "$NFX/kb/stale-noassert"
# recheck-due holds one stale fact with a Recheck and build_clean's stale one without: 1, not 2.
case_run "nudge: a stale fact WITH a Recheck is not also counted as having none" 0 "1 stale fact with no assertion" -- \
  "$ENGINE/scripts/kb-due" "$NFX/kb/recheck-due" --nudge
# Without check-kb beside it, kb-due loses only the categories that use its rules: the unstamped
# count, and the recheck count, whose agent TTL is check-kb's (issue #30). One warning each; the
# rest intact.
mkdir -p "$TMP/due-nockb"
for f in kb-due kb-verify kb-watch; do cp "$ENGINE/scripts/$f" "$TMP/due-nockb/$f"; done
case_run "nudge: without check-kb the other categories still print" 0 "episodic notes awaiting distillation" -- \
  "$TMP/due-nockb/kb-due" "$NFX/kb/episodic-due" --nudge
case_run "nudge: without check-kb the recheck count is a one-line warning" 0 "could not compute facts due for recheck" -- \
  "$TMP/due-nockb/kb-due" "$NFX/kb/recheck-due" --nudge
case_run "nudge: without check-kb the unstamped count is a one-line warning" 0 "could not count unstamped sections" -- \
  "$TMP/due-nockb/kb-due" "$NFX/kb/recheck-due" --nudge

# 5. A malformed (unreadable) queue file: one-line warning, never a crash, exit 0 — and
#    every other tree and category still gets reported. Root only: chmod 000 has no
#    effect for root, so the negative control would be vacuous there.
if [ "$(id -u)" != "0" ]; then
  build_clean "$NFX/kb/malformed-queue"
  cat > "$NFX/kb/malformed-queue/needs-attention.md" <<'EOF'
---
name: needs-attention
description: fixture
memory_type: reference
domain: fx
scope: general
metadata: {type: index, node_type: memory, created: 2026-01-01}
tags: [meta]
keywords: [queue]
---
# Needs attention

```yaml
- id: aaaaaaaa
  category: drift
  status: open
  source_id: x
  field: y
  old: "a"
  new: "b"
  source_url: "-"
  date: "2026-01-01"
```
EOF
  chmod 000 "$NFX/kb/malformed-queue/needs-attention.md"
  out=$("$ENGINE/scripts/kb-due" "$NFX/kb/malformed-queue" --nudge 2>&1); rc=$?
  chmod 644 "$NFX/kb/malformed-queue/needs-attention.md"   # restore so TMP cleanup can remove it
  case_run "nudge: malformed queue file never crashes the hook" 0 "" -- test "$rc" = 0
  case_run "nudge: malformed queue file is reported as a one-line warning" 0 "" -- \
    bash -c 'printf "%s" "$1" | grep -q "could not read needs-attention.md"' _ "$out"
fi

# -------------------------------------------- kb-session-start + --nudge, hermetic ----
# End-to-end: a fixture engine (this repo's own scripts, a throwaway CONVENTIONS.md, one
# fixture library) run as the real SessionStart hook would, with a hermetic HOME so this
# can never touch ~/.claude, and a cwd outside any git repo so the project-tree branch
# stays inert.
SFX="$TMP/session-fx"; mkdir -p "$SFX/scripts" "$SFX/kb"
for f in kb-session-start kb-due kb-verify kb-watch check-kb kb-libraries; do
  cp "$ENGINE/scripts/$f" "$SFX/scripts/$f"; chmod +x "$SFX/scripts/$f"
done
cp "$ENGINE/CONVENTIONS.md" "$SFX/CONVENTIONS.md"   # the engine reads its contract versions (§14) here
SHOME="$TMP/session-home"; mkdir -p "$SHOME" "$TMP/session-cwd"

build_clean "$SFX/kb/libdue"
fm stale-recheck general > "$SFX/kb/libdue/stale-recheck.md"
cat >> "$SFX/kb/libdue/stale-recheck.md" <<'EOF'
# Stale Recheck

## Port

The service listens on some port.

Source: manual
Verified: 2026-01-01 · by: agent · method: manual
Recheck: true
EOF
printf -- '- [stale-recheck](stale-recheck.md) — a stale fact with a Recheck\n' >> "$SFX/kb/libdue/INDEX.md"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$SFX/kb/libdue/INDEX.md"
HOME="$SHOME" "$ENGINE/scripts/kb-library" add "$SFX/kb/libdue" >/dev/null   # installed = registered

case_run "kb-session-start: nudge block appears when something is due" 0 \
  "Due for a librarian's attention" -- \
  sh -c "cd '$TMP/session-cwd' && env -i HOME='$SHOME' PATH='$PATH' '$SFX/scripts/kb-session-start'"
case_run "kb-session-start: names the due library and its recheck count" 0 \
  "libdue: 1 fact due for recheck" -- \
  sh -c "cd '$TMP/session-cwd' && env -i HOME='$SHOME' PATH='$PATH' '$SFX/scripts/kb-session-start'"
# A library behind the contract is nudged; one on an unsupported major is named as not served.
build_clean "$SFX/kb/libold"
sed -i '/^kb_contract:/d; s/^last_swept: never$/last_swept: '"$(date +%F)"'/' "$SFX/kb/libold/INDEX.md"
sed -i "s/^Verified: 2026-09-22/Verified: $(date +%F)/" "$SFX/kb/libold/widgets.md"
build_clean "$SFX/kb/libfuture"; sed -i 's/^kb_contract: .*$/kb_contract: "3.0"/' "$SFX/kb/libfuture/INDEX.md"
HOME="$SHOME" "$ENGINE/scripts/kb-library" add "$SFX/kb/libold" >/dev/null
HOME="$SHOME" "$ENGINE/scripts/kb-library" add "$SFX/kb/libfuture" >/dev/null 2>&1
case_run "kb-session-start: a library behind the contract is nudged" 0 \
  "libold: built to contract 2.0" -- \
  sh -c "cd '$TMP/session-cwd' && env -i HOME='$SHOME' PATH='$PATH' '$SFX/scripts/kb-session-start'"
case_run "kb-session-start: an unsupported contract major is named as not served" 0 \
  "libfuture: unsupported-contract" -- \
  sh -c "cd '$TMP/session-cwd' && env -i HOME='$SHOME' PATH='$PATH' '$SFX/scripts/kb-session-start'"

# A second fixture engine with nothing due at all: the block must be absent entirely.
SFX2="$TMP/session-fx-clean"; mkdir -p "$SFX2/scripts" "$SFX2/kb"
for f in kb-session-start kb-due kb-verify kb-watch check-kb kb-libraries; do
  cp "$ENGINE/scripts/$f" "$SFX2/scripts/$f"; chmod +x "$SFX2/scripts/$f"
done
cp "$ENGINE/CONVENTIONS.md" "$SFX2/CONVENTIONS.md"
build_clean "$SFX2/kb/libclean"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$SFX2/kb/libclean/INDEX.md"
sed -i "s/^Verified: 2026-09-22/Verified: $(date +%F)/" "$SFX2/kb/libclean/widgets.md"   # really fresh (#63)
SHOME2="$TMP/session-home2"; HOME="$SHOME2" "$ENGINE/scripts/kb-library" add "$SFX2/kb/libclean" >/dev/null
case_run "kb-session-start: nudge block absent when nothing is due" 1 "" -- \
  bash -c 'cd "$1" && env -i HOME="$2" PATH="$PATH" "$3" | grep -qF "Due for a librarian"' _ \
  "$TMP/session-cwd" "$SHOME2" "$SFX2/scripts/kb-session-start"
# Issue #40: --subagent is the same engine context, as a SubagentStart event, without the
# librarian's nudge (a retrieval subagent has no use for it).
case_run "kb-session-start --subagent: emits a SubagentStart event" 0 '"hookEventName":"SubagentStart"' -- \
  sh -c "cd '$TMP/session-cwd' && env -i HOME='$SHOME' PATH='$PATH' '$SFX/scripts/kb-session-start' --subagent"
case_run "kb-session-start --subagent: names the engine and its libraries" 0 "libdue -> $SFX/kb/libdue" -- \
  sh -c "cd '$TMP/session-cwd' && env -i HOME='$SHOME' PATH='$PATH' '$SFX/scripts/kb-session-start' --subagent"
