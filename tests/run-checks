  printf -- '- [s-%s](s-%s.md) — stub\n' "$s" "$s" >> "$TMP/ksrc-head/sources/INDEX.md"
done
git -C "$TMP/ksrc-head" add -A >/dev/null 2>&1
: > "$SRV/access.log"
case_run "kb-sources: only the 429 is queued (HEAD 400/404/500 then GET 200 are alive)" 1 "queued" -- \
  "$ENGINE/scripts/kb-sources" "$TMP/ksrc-head" --yes
KHQ="$TMP/ksrc-head/needs-attention.md"
