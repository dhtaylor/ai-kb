# ------------------------------------------------- library registry (ADR-0014) ----
# A library is installed by being registered, wherever it lives, under the name its root
# INDEX.md declares. Each case gets its own HOME, so each starts with an empty registry.
REG_HOME="$TMP/reghome"
kbl() { HOME="$REG_HOME" "$ENGINE/scripts/kb-library" "$@"; }
kbls() { HOME="$REG_HOME" "$ENGINE/scripts/kb-libraries"; }
REGD="$TMP/reg"; mkdir -p "$REGD/elsewhere" "$REGD/kb"
build_clean "$REGD/elsewhere/alpha"; build_clean "$REGD/kb/beta"
# A library's folder can be called anything: this one is a clone into gamma-main/.
build_clean "$REGD/elsewhere/gamma-main"
sed -i 's/^domain: gamma-main$/domain: gamma/' "$REGD/elsewhere/gamma-main/INDEX.md"
git -C "$REGD/elsewhere/gamma-main" add -A
ln -s "$REGD/kb/beta" "$REGD/beta-link"
REG_ALPHA="$(cd "$REGD/elsewhere/alpha" && pwd -P)"; REG_BETA="$(cd "$REGD/kb/beta" && pwd -P)"
HEAD_BEFORE=$(git -C "$REG_ALPHA" write-tree); STATUS_BEFORE=$(git -C "$REG_ALPHA" status --porcelain)

case_run "registry: add registers a library under its declared name" 0 "registered alpha at $REG_ALPHA" -- kbl add "$REGD/elsewhere/alpha"
case_run "registry: the folder name does not decide the name" 0 "registered gamma at" -- kbl add "$REGD/elsewhere/gamma-main"
case_run "registry: a library reached through a symlink is registered by its real path" 0 "registered beta at $REG_BETA" -- kbl add "$REGD/beta-link"
case_run "registry: kb-libraries reports every library ok" 0 "" -- \
  sh -c "[ \"\$(HOME='$REG_HOME' '$ENGINE/scripts/kb-libraries' | cut -f1 | sort -u)\" = ok ] && HOME='$REG_HOME' '$ENGINE/scripts/kb-libraries' | grep -c . | grep -qx 3"
case_run "registry: re-adding the same path is a no-op" 0 "already registered at $REG_ALPHA" -- kbl add "$REGD/elsewhere/alpha"
case_run "registry: add wires the clone to the engine's library hook" 0 "$ENGINE/library-hooks" -- \
  git -C "$REG_ALPHA" config --get core.hooksPath
case_run "registry: registering writes nothing into the library" 0 "" -- \
  sh -c '[ "$(git -C "$1" status --porcelain)" = "$2" ] && [ "$(git -C "$1" write-tree)" = "$3" ] && ! git -C "$1" rev-parse -q --verify HEAD >/dev/null' _ "$REG_ALPHA" "$STATUS_BEFORE" "$HEAD_BEFORE"
cp -r "$REG_ALPHA" "$REGD/alpha-copy"
case_run "registry: a second library with a registered, live name is refused" 1 "one name, one library" -- kbl add "$REGD/alpha-copy"
mkdir -p "$REGD/notlib"
case_run "registry: a folder with no INDEX.md is not a library" 1 "not a library" -- kbl add "$REGD/notlib"
build_clean "$REGD/noname"; sed -i '/^domain:/d' "$REGD/noname/INDEX.md"
case_run "registry: a library that declares no name is refused" 1 "declares no domain" -- kbl add "$REGD/noname"
# States: every non-ok state is reported by name, never dropped.
mv "$REGD/elsewhere/gamma-main" "$REGD/gamma-moved"
case_run "registry: a moved library is reported missing" 0 "missing	gamma	" -- kbls
case_run "registry: re-adding a moved library updates its path" 0 "was missing at" -- kbl add "$REGD/gamma-moved"
case_run "registry: ...and it is ok again" 0 "ok	gamma	" -- kbls
sed -i 's/^domain: beta$/domain: beta2/' "$REG_BETA/INDEX.md"
case_run "registry: a library that renamed itself is a name mismatch" 0 "name-mismatch	beta	" -- kbls
sed -i 's/^domain: beta2$/domain: beta/' "$REG_BETA/INDEX.md"
mv "$REG_BETA/INDEX.md" "$REG_BETA/INDEX.md.off"
case_run "registry: a registered folder with no INDEX.md is not-a-library" 0 "not-a-library	beta	" -- kbls
mv "$REG_BETA/INDEX.md.off" "$REG_BETA/INDEX.md"
# A library on a contract major this engine does not support is not served (ADR-0016), and
# neither is one whose version cannot be read (here, unquoted). Only state ok is served.
sed -i 's/^kb_contract: .*$/kb_contract: "3.0"/' "$REG_BETA/INDEX.md"
case_run "registry: an unsupported contract major is unsupported-contract" 0 "unsupported-contract	beta	" -- kbls
sed -i 's/^kb_contract: .*$/kb_contract: 2.1/' "$REG_BETA/INDEX.md"
case_run "registry: an unreadable contract version is unsupported-contract" 0 "unsupported-contract	beta	" -- kbls
sed -i 's/^kb_contract: .*$/kb_contract: "2.1"/' "$REG_BETA/INDEX.md"
case_run "registry: ...and a supported version is ok again" 0 "ok	beta	" -- kbls
case_run "registry: remove unregisters and deletes nothing" 0 "nothing at $REG_ALPHA was deleted" -- kbl remove alpha
case_run "registry: ...the files are still there" 0 "" -- test -f "$REG_ALPHA/widgets.md"
case_run "registry: ...and the hook is unwired" 1 "" -- git -C "$REG_ALPHA" config --get core.hooksPath
case_run "registry: removing an unregistered name is refused" 1 "not registered" -- kbl remove alpha
case_run "registry: list shows state, name and path" 0 "ok             beta" -- kbl list
case_run "registry: the registry file is git-config format at the fixed path" 0 "$REG_BETA" -- \
  git config --file "$REG_HOME/.config/ai-kb/libraries" --get library.beta.path
case_run "registry: XDG_CONFIG_HOME does not move it" 0 "ok	beta	" -- \
  env XDG_CONFIG_HOME="$TMP/xdg-elsewhere" HOME="$REG_HOME" "$ENGINE/scripts/kb-libraries"

# ---------------------------------------- library pre-commit hook: xlinks ----
# The library hook is the engine's (library-hooks/pre-commit, ADR-0014): a library is shared
# by people who do not own it, so it carries no hook of its own. A clone is wired to it by
# kb-library add. Blocking a commit that breaks a registered sibling's citation, and skipping
# on an unregistered copy, are tested with the registry consumers below. Here: a link into a
# library that is simply not installed only warns, through the hook as through the script.
# A hermetic HOME (env -i): the registry is per machine, and this one holds only "solo".
LHOME="$TMP/lhook-home"; mkdir -p "$LHOME"
build_clean "$TMP/lhook/solo"
printf '\nSee [[gamma:widgets]].\n' >> "$TMP/lhook/solo/widgets.md"
git -C "$TMP/lhook/solo" add -A
HOME="$LHOME" "$ENGINE/scripts/kb-library" add "$TMP/lhook/solo" >/dev/null
case_run "library hook warns, but does not fail, on a link into an absent library" 0 "unresolvable" -- \
  sh -c "cd '$TMP/lhook/solo' && env -i HOME='$LHOME' PATH='$PATH' git -c user.email=t@t -c user.name=t commit -qm first"
case_run "the commit went through the engine's hook" 0 "" -- git -C "$TMP/lhook/solo" rev-parse -q --verify HEAD
case_run "kb-create-domain no longer writes a hook into a library" 1 "" -- \
  grep -q 'core.hooksPath .githooks' "$ENGINE/plugins/knowledge-tools/skills/kb-create-domain/SKILL.md"

