  sh -c "cd '$TMP/arc1/documents' && '$ENGINE/scripts/check-secrets' --worktree"
git -C "$TMP/arc1" -c user.email=t@t -c user.name=t commit -qm add >/dev/null 2>&1
case_run "archive exemption holds in --all mode" 0 "clean" -- \
  sh -c "cd '$TMP/arc1' && '$ENGINE/scripts/check-secrets' --all"
arc_lib "$TMP/arc2" documents/dump.sql "CREATE LOGIN app WITH PASS""WORD = '$PW'"
case_run "labelled secret in an archived artifact is still caught" 1 "SECRET?" -- \
  sh -c "cd '$TMP/arc2' && '$ENGINE/scripts/check-secrets'"
arc_lib "$TMP/arc3" documents/dump.sql "key = \"$(printf '%s%s' AKIA ABCDEFGHIJKLMNOP)\""
case_run "pattern secret in an archived artifact is still caught" 1 "SECRET?" -- \
  sh -c "cd '$TMP/arc3' && '$ENGINE/scripts/check-secrets'"
