# --transcripts (issue #32): grade straight from subagent transcripts, mapped Q<n>|<transcript>
# as grade-routing maps them. A subagent's answer is the message of its SubagentHandback call,
# not its last text block: text written before the hand-back is preamble, and grading it fails
# a correct answer. The citations are the answer's Sources: line; `Sources: none` cites nothing.
# The transcripts are SYNTHETIC, in the shape Claude Code writes.
mk_hb() { # mk_hb <out.jsonl> <text before the hand-back> <hand-back message, or - for none>
  python3 - "$@" <<'PY'
import json, sys
out, text, msg = sys.argv[1:4]
recs = [{"type": "user", "message": {"role": "user", "content": "a question"}},
        {"type": "assistant", "message": {"role": "assistant", "content": [
            {"type": "tool_use", "id": "r1", "name": "Read", "input": {"file_path": "widgets.md"}}]}},
        {"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "r1", "content": "A widget holds up to 12 things."}]}}]
if text != "-":
    recs.append({"type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": text}]}})
if msg != "-":
    recs.append({"type": "assistant", "message": {"role": "assistant", "content": [
        {"type": "tool_use", "id": "h1", "name": "SubagentHandback", "input": {"message": msg}}]}})
    # Claude Code also logs the request it sent, carrying copies of earlier blocks. Not an answer.
    recs.append({"type": "api-request-blob", "message": {"content": [
        {"type": "tool_use", "id": "h0", "name": "SubagentHandback", "input": {"message": "decoy\n\nSources: none"}}]}})
open(out, "w").write("\n".join(json.dumps(r) for r in recs) + "\n")
PY
}
