case_run "origins: another owner is another origin" 1 "" -- same_origin https://github.com/acme/lib.git https://github.com/other/lib.git
case_run "origins: another host is another origin" 1 "" -- same_origin https://github.com/acme/lib.git https://gitlab.com/acme/lib.git

