printf 'Recheck: kbtool\n' >> "$XH/lib/widgets.md"
git -C "$XH/lib" -c user.email=t@t -c user.name=t commit -qm init
HOME="$XHH" "$ENGINE/scripts/kb-library" add "$XH/lib" >/dev/null 2>&1
cat > "$XH/claudestub" <<STUB
#!/bin/sh
printf %s "\$CLAUDE_CONFIG_DIR" > "$XH/cc-seen"
echo '{"result": "NO ITEMS"}'
STUB
chmod +x "$XH/claudestub"
xsched() { # xsched PATH [VAR=value ...] -- kb-schedule arguments, run with only HOME, PATH and what is named
  local p="$1" e=(); shift
  while [ "$1" != -- ]; do e+=("$1"); shift; done; shift
  env -i HOME="$XHH" PATH="$p" KS_LOG="$KS/log" KS_CRON="$XH/cron" KB_SYSTEMCTL="$KS/bin/systemctl" KB_CRONTAB="$KS/bin/crontab" \
    ${e[@]+"${e[@]}"} "$ENGINE/scripts/kb-schedule" "$@"
}
xsched "$XH/userbin:$PATH" XDG_CONFIG_HOME="$XOTHER/config" XDG_STATE_HOME="$XOTHER/state" CLAUDE_CONFIG_DIR="$XOTHER/cc" -- install --backend cron --prepare --claude "$XH/claudestub" >/dev/null 2>&1
