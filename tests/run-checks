#!/usr/bin/env bash
# run-checks — prove the guardrails still catch what they were written to catch.
#
# WHY: every check in scripts/ has been broken at least once, by its own author,
# and each time it was found by a person happening to look:
#
#   check-exec-bits matched `scripts/check-*` and missed two new scripts, which
#     were then "Permission denied" in every clone;
#   check-xlinks excluded episodic/ and called a live citation dead;
#   check-scope lost four spaces of indentation and silently checked only the
#     last library it was given;
#   check-golden counted a record that had drifted outside its code fence.
#
# Three of those passed CI. A guardrail nobody tests is a guardrail you hope
# about. Each case below breaks one thing on purpose and requires the check to
# notice — the negative control, applied to the checkers themselves.
#
# Fixtures are BUILT HERE, not committed: a tree full of deliberate defects
# sitting in the repo is something another check will eventually read and flag.
# Each one is a git repo where it must be, because check-scope tells a library
# from a project tree by whether it has its own .git.
#
# Usage: tests/run-checks [-v]
# Exit 0 when every case behaves as specified.
set -uo pipefail

ENGINE="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)"
VERBOSE=${1:-}
PASS=0; FAIL=0
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
# The library registry is per machine, at ~/.config/ai-kb/libraries (ADR-0014). Every case runs
# under a throwaway HOME, so none can read or write the real one. Cases that need a HOME of
# their own (env -i HOME=...) still set it.
export HOME="$TMP/home"; mkdir -p "$HOME"

fm() { # frontmatter: name, scope, [extra]
  printf -- '---\nname: %s\ndescription: a test fixture.\nmemory_type: reference\ndomain: fx\nscope: %s\n%smetadata:\n  type: topic\n  node_type: memory\n  created: 2026-09-22\ntags: [fx]\nkeywords: [fx]\n---\n' "$1" "$2" "${3:-}"
}

# A valid library: router, one fact, a conformant golden set. Every defect fixture
# below is this, with exactly one thing broken.
build_clean() {
  local d="$1" scope="${2:-general}"
  mkdir -p "$d"
  # Declares the newest contract (CONVENTIONS §14), so a fixture is not "behind" (ADR-0016).
  # Publishing a new contract version means raising this line.
  fm fx-index "$scope" $'freshness_horizon: 90d\nverifier_budget: 5\nsweep_interval: 30d\nkb_contract: "2.1"\nlast_swept: never\n' > "$d/INDEX.md"
  printf '# fx\n\n- [widgets](widgets.md) — what widgets do\n' >> "$d/INDEX.md"
  sed -i "s/^domain: fx\$/domain: $(basename "$d")/" "$d/INDEX.md"   # a library declares its own name (ADR-0014)
  fm widgets "$scope" > "$d/widgets.md"
  printf '# Widgets\n\n## Limits\n\nA widget holds up to 12 things.\n\nSource: manual\nVerified: 2026-09-22 · by: agent · method: manual\n' >> "$d/widgets.md"
  fm fx-golden "$scope" > "$d/fx-golden.md"
  cat >> "$d/fx-golden.md" <<'GOLDEN'
# fx golden set

Unresolved case: not applicable — no CONFLICTED section here.
Cross-root case: not applicable — this fixture links to no other library.

```yaml
- case: positive
  question: How many things does a widget hold?
  expected_file: widgets.md
  expected_excerpt: "up to 12 things"

- case: negative
  question: What is the deploy target?
  expected_file: ""
  expected_excerpt: "fact not found — check KB"

- case: negative
  question: Who owns the widget service?
  expected_file: ""
  expected_excerpt: "fact not found — check KB"
```
GOLDEN
  git init -q "$d" && git -C "$d" add -A 2>/dev/null
}

# case <name> <expected-exit> <expected-substring> -- <command...>
case_run() {
  local name="$1" want_exit="$2" want_text="$3"; shift 4
  local out rc
  out=$("$@" 2>&1); rc=$?
  # An empty want_text means the exit status is the whole claim — grep finds
  # nothing in empty output, so it cannot stand in for "no requirement".
  if [ "$rc" = "$want_exit" ] && { [ -z "$want_text" ] || printf '%s' "$out" | grep -qF -- "$want_text"; }; then
    PASS=$((PASS+1)); [ -n "$VERBOSE" ] && printf '  ok    %s\n' "$name"
  else
    FAIL=$((FAIL+1))
    printf '  FAIL  %s\n' "$name"
    printf '        wanted exit %s containing: %s\n' "$want_exit" "$want_text"
    printf '        got exit %s:\n' "$rc"
    printf '%s\n' "$out" | sed 's/^/          /' | head -6
  fi
}

echo "run-checks: $ENGINE"

# ---------------------------------------------------------------- check-kb ----
build_clean "$TMP/clean"
case_run "clean library passes check-kb" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/clean"

build_clean "$TMP/orphan"
fm stray general > "$TMP/orphan/stray.md"; printf '# Stray\n\nNothing routes here.\n' >> "$TMP/orphan/stray.md"
case_run "unrouted file is an orphan" 1 "orphan" -- "$ENGINE/scripts/check-kb" "$TMP/orphan"

build_clean "$TMP/subtree"
mkdir -p "$TMP/subtree/deep"
fm fx-sub general > "$TMP/subtree/deep/INDEX.md"; printf '# Deep\n\n- [buried](buried.md) — buried\n' >> "$TMP/subtree/deep/INDEX.md"
fm buried general > "$TMP/subtree/deep/buried.md"; printf '# Buried\n\nListed, but by an unrouted index.\n' >> "$TMP/subtree/deep/buried.md"
case_run "subtree under an unrouted sub-index is orphaned" 1 "deep/buried.md" -- "$ENGINE/scripts/check-kb" "$TMP/subtree"

build_clean "$TMP/badname"
sed -i 's/^name: widgets$/name: gadgets/' "$TMP/badname/widgets.md"
case_run "name that disagrees with filename" 1 "does not match filename" -- "$ENGINE/scripts/check-kb" "$TMP/badname"

build_clean "$TMP/deadlink"
printf '\nSee [[nowhere]].\n' >> "$TMP/deadlink/widgets.md"
case_run "dead [[slug]] link" 1 "dead" -- "$ENGINE/scripts/check-kb" "$TMP/deadlink"

# kb-verify parses stamps only at column 0, so an indented one certifies nothing (issue #38).
build_clean "$TMP/indentstamp"
printf '\n## Debate\n\n- One side.\n  Source: manual\n  Verified: 2026-09-22 · by: agent · method: manual\n  Recheck: false\n' >> "$TMP/indentstamp/widgets.md"
case_run "indented Verified: line fails check-kb" 1 "indented Verified:" -- "$ENGINE/scripts/check-kb" "$TMP/indentstamp"
case_run "indented Recheck: line fails check-kb" 1 "indented Recheck:" -- "$ENGINE/scripts/check-kb" "$TMP/indentstamp"
build_clean "$TMP/fencedstamp"
printf '\n## Example\n\n- How a stamp looks:\n\n  ```\n  Verified: 2026-09-22 · by: agent · method: manual\n  ```\n' >> "$TMP/fencedstamp/widgets.md"
case_run "an indented stamp inside a code fence is an example, not a stamp" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/fencedstamp"

# Issue #71: sources/ holds only .md citation stubs (§6); a raw artifact (DDL, an ERD export, a
# PDF) is archived under documents/ and cited with a stub. check-kb read only .md files, so a raw
# file under sources/ passed silently and the user never learned it was in the wrong place.
build_clean "$TMP/srcraw"; mkdir -p "$TMP/srcraw/sources/schema"
printf 'CREATE TABLE t (id int);\n' > "$TMP/srcraw/sources/schema/t.sql"
case_run "a raw artifact under sources/ fails, and says to archive it under documents/" 1 "archive it under documents/" -- \
  "$ENGINE/scripts/check-kb" "$TMP/srcraw"
build_clean "$TMP/srcdoc"; mkdir -p "$TMP/srcdoc/documents/schema" "$TMP/srcdoc/sources"
printf 'CREATE TABLE t (id int);\n' > "$TMP/srcdoc/documents/schema/t.sql"
: > "$TMP/srcdoc/sources/.gitkeep"
case_run "a raw artifact under documents/ and a dotfile under sources/ pass" 0 "clean" -- \
  "$ENGINE/scripts/check-kb" "$TMP/srcdoc"

# The frontmatter verified: floor is derived from the section stamps and lint-checked (§7,
# issue #27): the oldest stamp among sections that are not CONFLICTED, and unknown when a
# sourced section is unstamped or nothing is stamped. A stamp may not be dated in the future.
floor_lib() { # floor_lib <dir> <verified-value> -- widgets.md declares that floor
  build_clean "$1"
  sed -i "s/^scope: general\$/scope: general\nverified: $2/" "$1/widgets.md"
}
floor_lib "$TMP/floorok" 2026-09-22
case_run "floor: matching the one stamp passes" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/floorok"
floor_lib "$TMP/floorold" 1999-01-01
case_run "floor: a date no stamp supports fails" 1 "derived floor is 2026-09-22" -- "$ENGINE/scripts/check-kb" "$TMP/floorold"
floor_lib "$TMP/floorpartial" 2026-09-22
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n' >> "$TMP/floorpartial/widgets.md"
case_run "floor: a date over an unstamped sourced section fails" 1 "derived floor is unknown" -- "$ENGINE/scripts/check-kb" "$TMP/floorpartial"
floor_lib "$TMP/floorpartialok" unknown
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\n' >> "$TMP/floorpartialok/widgets.md"
case_run "floor: unknown over an unstamped sourced section passes" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/floorpartialok"
floor_lib "$TMP/floorconf" 2026-09-22
printf '\n## Colour\n\nstatus: CONFLICTED · since: 2026-01-01\n\nClaim A: red. Claim B: blue.\n\nSource: manual\nVerified: 2026-01-01 · by: agent · method: manual\n\n## Size\n\nSource: manual\n' >> "$TMP/floorconf/widgets.md"
sed -i 's/^## Size$/## Size\n\nstatus: CONFLICTED · since: 2026-01-01/' "$TMP/floorconf/widgets.md"
case_run "floor: CONFLICTED sections' stamps and gaps are ignored" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/floorconf"
floor_lib "$TMP/floorstacked" 2026-09-22
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\nSource: vendor sheet\nVerified: 2026-09-22 · by: agent · method: manual\n' >> "$TMP/floorstacked/widgets.md"
case_run "floor: a date over a stacked source with no stamp of its own fails (#64)" 1 "derived floor is unknown" -- "$ENGINE/scripts/check-kb" "$TMP/floorstacked"
floor_lib "$TMP/floorpaired" 2026-09-22
printf '\n## Weight\n\nA widget weighs 3 kg.\n\nSource: manual\nVerified: 2026-09-22 · by: agent · method: manual\nSource: vendor sheet\nVerified: 2026-09-23 · by: agent · method: manual\n' >> "$TMP/floorpaired/widgets.md"
case_run "floor: one stamp per stacked source passes" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/floorpaired"
floor_lib "$TMP/floorcomment" "2026-09-22  # oldest of one"
case_run "floor: an inline YAML comment on verified: is allowed" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/floorcomment"
build_clean "$TMP/floorfuture"
sed -i 's/^Verified: 2026-09-22/Verified: 2999-01-01/' "$TMP/floorfuture/widgets.md"
case_run "a stamp dated in the future fails" 1 "dated in the future" -- "$ENGINE/scripts/check-kb" "$TMP/floorfuture"

build_clean "$TMP/collide"
mkdir -p "$TMP/collide/widgets"
fm inner general > "$TMP/collide/widgets/inner.md"; printf '# Inner\n\ntext\n' >> "$TMP/collide/widgets/inner.md"
printf -- '- [widgets-folder](widgets/inner.md) — inner\n' >> "$TMP/collide/INDEX.md"
case_run "file colliding with a folder name" 1 "collides with directory" -- "$ENGINE/scripts/check-kb" "$TMP/collide"

build_clean "$TMP/badfm"
sed -i 's/^domain: fx$/domain fx/' "$TMP/badfm/widgets.md"          # a key with no colon
case_run "malformed frontmatter is reported, not skipped" 1 "unparseable frontmatter" -- \
  "$ENGINE/scripts/check-kb" "$TMP/badfm"

# The toolchain runs in every commit hook on every machine, and on CI runners that
# install nothing. check-kb once imported PyYAML: it worked for its author and was
# a traceback everywhere else, including on the runner, which had never exercised
# it because the engine holds no knowledge for it to read.
case_run "no script depends on a third-party module" 1 "" -- \
  grep -rlE "^import (yaml|requests|jinja2)|^from (yaml|requests|jinja2) " "$ENGINE/scripts"

# ------------------------------------------------------------- check-scope ----
build_clean "$TMP/scopeok"
case_run "clean library passes check-scope" 0 "clean" -- "$ENGINE/scripts/check-scope" "$TMP/scopeok"

# A trailing YAML comment is valid and must not hide the scope (issue #43).
build_clean "$TMP/scopecomment"
sed -i 's/^scope: general$/scope: general  # the tie-breaker says general/' "$TMP/scopecomment/widgets.md"
case_run "scope: with an inline comment is read" 0 "clean" -- "$ENGINE/scripts/check-scope" "$TMP/scopecomment"

build_clean "$TMP/scopemix"
sed -i 's/^scope: general$/scope: product:acme/' "$TMP/scopemix/widgets.md"
case_run "file scope disagreeing with its library" 1 "disagrees with its library" -- "$ENGINE/scripts/check-scope" "$TMP/scopemix"

build_clean "$TMP/libwithrepo" "repo:fx"
case_run "library declaring a repo: tier" 1 "general-tier home" -- "$ENGINE/scripts/check-scope" "$TMP/libwithrepo"

# A project tree is one with no .git of its own, sitting inside a repository.
mkdir -p "$TMP/proj"; git init -q "$TMP/proj"
build_clean "$TMP/proj/knowledge" "general"; rm -rf "$TMP/proj/knowledge/.git"
case_run "project tree declaring a general tier" 1 "project tree" -- "$ENGINE/scripts/check-scope" "$TMP/proj/knowledge"

# A comparative product library (issue #37): product:<category> names a set of alternatives,
# not a vendor, so the root INDEX.md lists the vendors it compares. Without the list, a
# category passes as if it were a vendor.
build_comp() { # build_comp <dir> <scope> <vendors: frontmatter, as printf %b text>
  build_clean "$1" "$2"
  python3 - "$1/INDEX.md" "$3" <<'PY'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); t = p.read_text()
i = t.index("\n", t.index("\nscope:") + 1) + 1
p.write_text(t[:i] + sys.argv[2].encode().decode("unicode_escape") + "\n" + t[i:])
PY
}
build_comp "$TMP/comp" "product:message-brokers" "vendors: [kafka, rabbitmq, azure-service-bus]"
case_run "comparative library: product:<category> with its vendors passes" 0 "clean" -- "$ENGINE/scripts/check-scope" "$TMP/comp"
case_run "comparative library: vendors: passes check-kb" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/comp"
build_comp "$TMP/comp-block" "product:message-brokers" 'vendors:\n  - kafka\n  - rabbitmq'
case_run "comparative library: a block list of vendors is read" 0 "clean" -- "$ENGINE/scripts/check-scope" "$TMP/comp-block"
build_comp "$TMP/comp-one" "product:message-brokers" "vendors: [kafka]"
case_run "comparative library: one vendor is not a comparison" 1 "at least two" -- "$ENGINE/scripts/check-scope" "$TMP/comp-one"
build_comp "$TMP/comp-gen" "general" "vendors: [kafka, rabbitmq]"
case_run "comparative library: vendors: on a general library fails" 1 "only a product:" -- "$ENGINE/scripts/check-scope" "$TMP/comp-gen"
build_comp "$TMP/comp-self" "product:kafka" "vendors: [kafka, rabbitmq]"
case_run "comparative library: a category that is one of its vendors fails" 1 "is one of its own vendors" -- "$ENGINE/scripts/check-scope" "$TMP/comp-self"
build_comp "$TMP/comp-slug" "product:message-brokers" "vendors: [kafka, Rabbit MQ]"
case_run "comparative library: a vendor that is not a slug fails" 1 "not a slug" -- "$ENGINE/scripts/check-scope" "$TMP/comp-slug"
build_comp "$TMP/comp-dup" "product:message-brokers" "vendors: [kafka, rabbitmq, kafka]"
case_run "comparative library: a vendor listed twice fails" 1 "listed twice" -- "$ENGINE/scripts/check-scope" "$TMP/comp-dup"

build_clean "$TMP/escape"
printf '\nSee [the engine](../../CONVENTIONS.md).\n' >> "$TMP/escape/widgets.md"
case_run "relative link climbing out of a library" 1 "climbs out" -- "$ENGINE/scripts/check-scope" "$TMP/escape"

# ------------------------------------------------------------ check-golden ----
build_clean "$TMP/goldok"
case_run "conformant golden set passes" 0 "clean" -- "$ENGINE/scripts/check-golden" "$TMP/goldok"

build_clean "$TMP/goldexcerpt"
sed -i 's/up to 12 things/up to 20 things/' "$TMP/goldexcerpt/fx-golden.md"
case_run "golden excerpt not in the file it names" 1 "excerpt not found" -- "$ENGINE/scripts/check-golden" "$TMP/goldexcerpt"

build_clean "$TMP/goldfile"
sed -i 's/expected_file: widgets.md/expected_file: nowhere.md/' "$TMP/goldfile/fx-golden.md"
case_run "golden record naming a missing file" 1 "does not exist" -- "$ENGINE/scripts/check-golden" "$TMP/goldfile"

build_clean "$TMP/goldneg"
python3 - "$TMP/goldneg/fx-golden.md" <<'PY'
import sys, pathlib, re
p = pathlib.Path(sys.argv[1]); t = p.read_text()
p.write_text(t[:t.index("- case: negative\n  question: Who owns")] + "```\n")
PY
case_run "golden set with fewer than two negatives" 1 "negative case" -- "$ENGINE/scripts/check-golden" "$TMP/goldneg"

# Reachability: an expected_file must be reachable from the root INDEX.md by router links,
# or retrieval (which descends routers and never searches) can never route to it. check-kb's
# orphan check exempts documents/ and the golden set, so a golden record could name a file
# there and pass every other check.
build_reach() { # build_reach <dir> <path of an extra file, library-relative> [routed-from-index]
  build_clean "$1"
  mkdir -p "$(dirname "$1/$2")"
  fm "$(basename "$2" .md)" general > "$1/$2"
  printf '# Gadgets\n\nA gadget weighs 7 grams.\n' >> "$1/$2"
  [ -n "${3:-}" ] && printf -- '- [gadgets](%s) — what gadgets weigh\n' "$2" >> "$1/INDEX.md"
  sed -i "0,/expected_file: widgets.md/s||expected_file: $2|; 0,/up to 12 things/s||A gadget weighs 7 grams|" "$1/fx-golden.md"
}
build_reach "$TMP/goldreach" gadgets.md routed
case_run "golden expected_file reachable through the router passes" 0 "clean" -- "$ENGINE/scripts/check-golden" "$TMP/goldreach"
build_reach "$TMP/goldorph" gadgets.md
case_run "golden expected_file that is an orphan fails" 1 "not reachable" -- "$ENGINE/scripts/check-golden" "$TMP/goldorph"
build_reach "$TMP/golddocs" documents/gadgets.md
case_run "golden expected_file under documents/ (orphan-exempt) fails" 1 "not reachable" -- "$ENGINE/scripts/check-golden" "$TMP/golddocs"
build_clean "$TMP/goldself"
sed -i '0,/expected_file: widgets.md/s||expected_file: fx-golden.md|; 0,/up to 12 things/s|up to 12 things|case: positive|' "$TMP/goldself/fx-golden.md"
case_run "golden expected_file that is the golden set itself fails" 1 "not reachable" -- "$ENGINE/scripts/check-golden" "$TMP/goldself"
build_clean "$TMP/goldnoindex"; rm "$TMP/goldnoindex/INDEX.md"
case_run "golden library with no root INDEX.md fails reachability" 1 "not reachable" -- "$ENGINE/scripts/check-golden" "$TMP/goldnoindex"

# An UNRESOLVED case tests the refusal of a disputed fact. Its excerpt is the fixed
# phrase ("disputed — not served"), which is in no fact file, so it cannot be grepped
# for there. Instead the file it names must genuinely hold a CONFLICTED section: the
# case must point at a real dispute, not a fiction written to satisfy a count.
build_unresolved() { # build_unresolved <dir> <excerpt> <conflicted-file-marker>
  build_clean "$1"
  printf -- '# Gizmos\n\n## Capacity\n\nstatus: %s\n\nClaim A: 12. Claim B: 20.\n' "$3" > "$1/gizmos.md"
  printf -- '- [gizmos](gizmos.md) — what gizmos hold\n' >> "$1/INDEX.md"   # a golden file must be routed
  python3 - "$1/fx-golden.md" "$2" <<'PY'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); t = p.read_text()
rec = ("- case: unresolved\n  question: How many things does a gizmo hold?\n"
       "  expected_file: gizmos.md\n  expected_excerpt: \"" + sys.argv[2] + "\"\n\n")
i = t.index("- case: negative")
p.write_text(t[:i] + rec + t[i:])
PY
}
# A file may state one fact in two sentences (a summary and the source it quotes).
# alt_excerpt names the second; it is held to exactly the same standard as the first.
build_alt() { # build_alt <dir> <alt excerpt> [case-to-attach-to]
  build_clean "$1"
  printf 'Twelve things is the most a widget can hold.\n' >> "$1/widgets.md"
  python3 - "$1/fx-golden.md" "$2" "${3:-positive}" <<'PY'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); t = p.read_text()
anchor = {"positive": '  expected_excerpt: "up to 12 things"\n',
          "negative": '  expected_excerpt: "fact not found — check KB"\n'}[sys.argv[3]]
p.write_text(t.replace(anchor, anchor + '  alt_excerpt: "' + sys.argv[2] + '"\n', 1))
PY
}
build_alt "$TMP/goldalt" "Twelve things is the most a widget can hold"
case_run "alt_excerpt present in the file passes" 0 "clean" -- "$ENGINE/scripts/check-golden" "$TMP/goldalt"
build_alt "$TMP/goldalt2" "Twenty things is the most a widget can hold"
case_run "alt_excerpt absent from the file is oracle rot" 1 "alt_excerpt not found" -- "$ENGINE/scripts/check-golden" "$TMP/goldalt2"
build_alt "$TMP/goldalt3" "anything at all" negative
case_run "alt_excerpt on a refusal case is refused" 1 "alt_excerpt" -- "$ENGINE/scripts/check-golden" "$TMP/goldalt3"
alt() { # alt <name> <want-exit> <want-text> <library> <Q1 record>
  printf '%s\nQ2||fact not found — check KB\nQ3||fact not found — check KB\n' "$5" > "$4/answers"
  case_run "$1" "$2" "$3" -- "$ENGINE/scripts/grade-eval" "$4" "$4/answers"
}
alt "grade-eval: quoting the alternative sentence is grounded" 0 "3/3 passed" "$TMP/goldalt" \
  'Q1|widgets.md|At most twelve: "Twelve things is the most a widget can hold."'
alt "grade-eval: quoting neither sentence still fails" 1 "excerpt not in answer" "$TMP/goldalt" \
  'Q1|widgets.md|A widget carries about a dozen.'
alt "grade-eval: an alternative missing from the file is oracle rot" 1 "ORACLE ROT" "$TMP/goldalt2" \
  'Q1|widgets.md|A widget holds up to 12 things.'

build_unresolved "$TMP/goldun" "disputed — not served" "CONFLICTED"
case_run "unresolved case: refusal phrase, file holds a real conflict" 0 "clean" -- "$ENGINE/scripts/check-golden" "$TMP/goldun"
build_unresolved "$TMP/goldun2" "disputed — not served" "settled"
case_run "unresolved case naming a file with no CONFLICTED section" 1 "no CONFLICTED section" -- "$ENGINE/scripts/check-golden" "$TMP/goldun2"
build_unresolved "$TMP/goldun3" "status: CONFLICTED" "CONFLICTED"
case_run "unresolved case whose excerpt is not the refusal phrase" 1 "disputed — not served" -- "$ENGINE/scripts/check-golden" "$TMP/goldun3"

# UNCORROBORATED (issue #33): one unofficial source for a value the authority never published.
# Not a dispute, so it is served, caveat first. Mapped to CONFLICTED it was refused, with the
# "other side" invented; left as plain text it was served with no caveat at all.
build_uncorr() { # build_uncorr <dir> <marker> [excerpt|-]   ("-": no uncorroborated record)
  build_clean "$1"
  printf '\n## Calibration\n\nstatus: %s\n\nA widget is calibrated to 3 mm.\n\nSource: a community forum post\n' "$2" >> "$1/widgets.md"
  [ "${3:-}" = "-" ] && return 0
  python3 - "$1/fx-golden.md" "${3:-A widget is calibrated to 3 mm.}" <<'PY'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); t = p.read_text()
rec = ("- case: uncorroborated\n  question: What is a widget calibrated to?\n"
       "  expected_file: widgets.md\n  expected_excerpt: \"" + sys.argv[2] + "\"\n\n")
i = t.index("- case: negative")
p.write_text(t[:i] + rec + t[i:])
PY
}
UMARK="UNCORROBORATED · since: 2026-10-01"
build_uncorr "$TMP/gunc" "$UMARK"
