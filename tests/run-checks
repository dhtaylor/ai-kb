# ------------------------------------------------------------- kb-sources ----
# External `Source:` liveness. Hermetic: the only server ever asked anything is a throwaway
# one on 127.0.0.1 (ephemeral port), killed on exit. It logs every request it receives, so
# "the no---yes mode makes no request" is proven by an empty log, not by trusting the code.
export no_proxy=127.0.0.1 NO_PROXY=127.0.0.1
SRV="$TMP/srv"; mkdir -p "$SRV"
cat > "$SRV/server.py" <<'PY'
import http.server, sys
LOG, PORTFILE = sys.argv[1], sys.argv[2]
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _do(self, method):
        with open(LOG, "a") as f: f.write(f"{method} {self.path}\n")
        table = {"/ok": 200, "/gone": 404, "/removed": 410, "/boom": 500}
        table["/forbidden"] = 403
        table["/paren(v=1)"] = 200   # a URL whose own last character is a balanced ')'
        st = table.get(self.path, 404)
        if self.path == "/moved":
            self.send_response(302); self.send_header("Location", "/ok"); self.end_headers(); return
        if self.path == "/nohead":
            st = 405 if method == "HEAD" else 200
        # Servers that mishandle HEAD but serve GET (issue #74), and one that rate-limits.
        mishead = {"/head400": 400, "/head404": 404, "/head500": 500, "/busy": 429}
        if self.path in mishead:
            st = mishead[self.path] if method == "HEAD" else 200
        self.send_response(st); self.send_header("Content-Length", "0"); self.end_headers()
    def do_HEAD(self): self._do("HEAD")
    def do_GET(self): self._do("GET")
srv = http.server.HTTPServer(("127.0.0.1", 0), H)
open(PORTFILE, "w").write(str(srv.server_port))
srv.serve_forever()
PY
: > "$SRV/access.log"
python3 "$SRV/server.py" "$SRV/access.log" "$SRV/port" & SRV_PID=$!
trap 'kill $SRV_PID 2>/dev/null; rm -rf "$TMP"' EXIT
for _ in $(seq 50); do [ -s "$SRV/port" ] && break; sleep 0.1; done
SP=$(cat "$SRV/port")
