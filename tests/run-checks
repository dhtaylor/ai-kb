# tool_fixture <path> <key: tools|allowed-tools> <tier, or "" to omit> <tools value, or "" to omit>
tool_fixture() {
  local path="$1" key="$2" tier="$3" tools="$4"
  mkdir -p "$(dirname "$path")"
  {
    echo "---"
    echo "name: fx"
    echo "description: a test fixture."
    [ -n "$tools" ] && echo "$key: $tools"
    [ -n "$tier" ] && echo "tier: $tier"
    echo "---"
    echo "# fx"
  } > "$path"
}

