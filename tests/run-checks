gu "uncorroborated: the caveat without the value fails" 1 "excerpt not in answer" \
  'Q2|widgets.md|uncorroborated — single source: it is about 3 millimetres.'
mk_ur() { # mk_ur <out.jsonl> <file read>...  — reads only, the shape grade-routing grades
  python3 - "$@" <<'PY'
import json, sys
recs = [{"type": "user", "message": {"role": "user", "content": "a question"}}]
for i, f in enumerate(sys.argv[2:]):
    recs.append({"type": "assistant", "message": {"role": "assistant", "content": [
        {"type": "tool_use", "id": f"t{i}", "name": "Read", "input": {"file_path": f}}]}})
    recs.append({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": f"t{i}", "content": "ok"}]}})
open(sys.argv[1], "w").write("\n".join(json.dumps(r) for r in recs) + "\n")
PY
}
