BL1="$TMP/blast/delete"; blast_base "$BL1"
rm "$BL1/widgets.md"
sed -i '/widgets.md) — what widgets do/d' "$BL1/INDEX.md"
git -C "$BL1" add -A; git -C "$BL1" -c user.email=t@t -c user.name=t commit -qm "delete fact" >/dev/null 2>&1
case_run "check-blast: deleted fact file" 1 "widgets.md: fact file deleted" -- \
  sh -c "cd '$BL1' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

BL2="$TMP/blast/rename"; blast_base "$BL2"
git -C "$BL2" mv widgets.md gizmos.md
sed -i 's/widgets.md) — what widgets do/gizmos.md) — what widgets do/' "$BL2/INDEX.md"
git -C "$BL2" add -A; git -C "$BL2" -c user.email=t@t -c user.name=t commit -qm "rename fact" >/dev/null 2>&1
case_run "check-blast: renamed-away fact file" 1 "widgets.md: fact file renamed to gizmos.md" -- \
  sh -c "cd '$BL2' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

BL3="$TMP/blast/conflict"; blast_base "$BL3"
printf '\n## Disputed\n\nstatus: CONFLICTED · since: 2026-01-01\n\nClaim A: 12. Claim B: 20.\n' >> "$BL3/widgets.md"
git -C "$BL3" add -A; git -C "$BL3" -c user.email=t@t -c user.name=t commit -qm "add conflict" >/dev/null 2>&1
sed -i '/status: CONFLICTED/d' "$BL3/widgets.md"
git -C "$BL3" add -A; git -C "$BL3" -c user.email=t@t -c user.name=t commit -qm "resolve conflict" >/dev/null 2>&1
case_run "check-blast: CONFLICTED marker removed" 1 "widgets.md: removes a CONFLICTED marker (1 -> 0)" -- \
  sh -c "cd '$BL3' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

BL4="$TMP/blast/promote"; blast_base "$BL4" "product:acme"
sed -i 's/^scope: product:acme$/scope: general/' "$BL4/widgets.md"
git -C "$BL4" add -A; git -C "$BL4" -c user.email=t@t -c user.name=t commit -qm "promote scope" >/dev/null 2>&1
case_run "check-blast: scope promoted toward general" 1 "widgets.md: scope promoted product:acme -> general" -- \
  sh -c "cd '$BL4' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

# A lateral reclassification (same rank) is not a promotion and must not fire.
BL4B="$TMP/blast/lateral"; blast_base "$BL4B" "product:acme"
sed -i 's/^scope: product:acme$/scope: org:acme/' "$BL4B/widgets.md"
git -C "$BL4B" add -A; git -C "$BL4B" -c user.email=t@t -c user.name=t commit -qm "lateral reclass" >/dev/null 2>&1
case_run "check-blast: lateral product<->org reclass is not a promotion" 0 "clean (library repo" -- \
  sh -c "cd '$BL4B' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

BL5="$TMP/blast/benign"; blast_base "$BL5"
sed -i 's/A widget holds up to 12 things\./A widget holds up to 12 thing./' "$BL5/widgets.md"
git -C "$BL5" add -A; git -C "$BL5" -c user.email=t@t -c user.name=t commit -qm "typo fix" >/dev/null 2>&1
case_run "check-blast: benign typo passes" 0 "clean (library repo" -- \
  sh -c "cd '$BL5' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

# owner-approved label: findings still print, exit becomes 0. A different label
# does not suppress anything.
case_run "check-blast: owner label suppresses failure but still prints the finding" 0 \
  "widgets.md: fact file deleted" -- \
  sh -c "cd '$BL1' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD --labels owner-approved"
case_run "check-blast: wrong label still fails" 1 "widgets.md: fact file deleted" -- \
  sh -c "cd '$BL1' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD --labels some-other-label"

# An engine-shaped repo: root CONVENTIONS.md, no root INDEX.md.
BLE="$TMP/blast/engine"; mkdir -p "$BLE/documents/decisions"
printf '# fixture contract\n\nSection one.\n' > "$BLE/CONVENTIONS.md"
printf '# ADR-0001\n\nOriginal text.\n' > "$BLE/documents/decisions/0001-fixture.md"
git init -q "$BLE"; git -C "$BLE" add -A
git -C "$BLE" -c user.email=t@t -c user.name=t commit -qm base >/dev/null 2>&1

sed -i 's/Section one\./Section one, revised./' "$BLE/CONVENTIONS.md"
git -C "$BLE" add -A; git -C "$BLE" -c user.email=t@t -c user.name=t commit -qm "edit contract" >/dev/null 2>&1
case_run "check-blast: CONVENTIONS.md edit in engine repo" 1 "CONVENTIONS.md changed" -- \
  sh -c "cd '$BLE' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

sed -i 's/Original text\./Revised text./' "$BLE/documents/decisions/0001-fixture.md"
git -C "$BLE" add -A; git -C "$BLE" -c user.email=t@t -c user.name=t commit -qm "edit adr" >/dev/null 2>&1
case_run "check-blast: decision record edit in engine repo" 1 \
  "documents/decisions/0001-fixture.md: decision record changed" -- \
  sh -c "cd '$BLE' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

# usage / repo-kind errors
case_run "check-blast: usage error on bad arg count" 2 "usage" -- "$ENGINE/scripts/check-blast" onlyone

mkdir -p "$TMP/blast/neither"; git init -q "$TMP/blast/neither"
printf 'x\n' > "$TMP/blast/neither/file.txt"; git -C "$TMP/blast/neither" add -A
git -C "$TMP/blast/neither" -c user.email=t@t -c user.name=t commit -qm base >/dev/null 2>&1
printf 'y\n' >> "$TMP/blast/neither/file.txt"; git -C "$TMP/blast/neither" add -A
git -C "$TMP/blast/neither" -c user.email=t@t -c user.name=t commit -qm second >/dev/null 2>&1
case_run "check-blast: repo with neither CONVENTIONS.md nor INDEX.md is a usage error" 2 \
  "not a recognized repo kind" -- \
  sh -c "cd '$TMP/blast/neither' && '$ENGINE/scripts/check-blast' HEAD~1 HEAD"

# ------------------------------------------------------------------- done ----
echo
# ------------------------------------------------- Phase 5 exit criterion ----
# "Stale or drifted facts surface as a queue rather than rotting silently": the whole
# chain in one library. A stale fact whose Recheck now fails AND a watched source that
# drifted must both land in the library's queue, the session-start nudge must name both,
# the fact must be untouched, and the library must still pass check-kb with its queue in it.
X="$TMP/exit5"; build_clean "$X/kb/fx"
sed -i "s/^last_swept: never\$/last_swept: $(date +%F)/" "$X/kb/fx/INDEX.md"
printf 'port=8080\n' > "$X/kb/fx/system-config.txt"
fm service-port general > "$X/kb/fx/service-port.md"
printf '%s\n' '# Service Port' '' '## Port' '' 'The service listens on port 9090.' '' \
  'Source: manual' 'Verified: 2026-01-01 · by: human · method: query' \
  "Recheck: grep -q '^port=9090\$' system-config.txt" >> "$X/kb/fx/service-port.md"
printf -- '- [service-port](service-port.md) — the port the service listens on\n' >> "$X/kb/fx/INDEX.md"
cp "$X/kb/fx/service-port.md" "$X/service-port.before"
watch_snapshot "$X/snap/baseline.html" 255 "Home" 2026-01-01
watch_snapshot "$X/snap/current.html"  500 "Home" 2026-01-01
watch_allowlist "$X/allowlist.json" "$X/kb/fx" "$X/snap/baseline.html" "$X/snap/current.html"

case_run "exit criterion: before checking, the nudge names the due recheck and no queue" 0 "fact due for recheck" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$X/kb/fx" --nudge
"$ENGINE/scripts/kb-verify" "$X/kb/fx" --yes >/dev/null 2>&1
"$ENGINE/scripts/kb-watch" "$X/allowlist.json" >/dev/null 2>&1
case_run "exit criterion: the stale fact and the drift both land in one queue" 0 "" -- \
  bash -c 'q="$1/needs-attention.md"; grep -qF "category: \"stale-recheck\"" "$q" && grep -qF "category: \"drift\"" "$q"' _ "$X/kb/fx"
case_run "exit criterion: the nudge names both open items" 0 "2 open queue items" -- \
  "$ENGINE/scripts/kb-due" /nonexistent "$X/kb/fx" --nudge
case_run "exit criterion: the stale fact itself is untouched" 0 "" -- \
  cmp -s "$X/service-port.before" "$X/kb/fx/service-port.md"
case_run "exit criterion: the library still passes check-kb with its queue in it" 0 "clean" -- \
  "$ENGINE/scripts/check-kb" "$X/kb/fx"

if [ "$FAIL" -eq 0 ]; then
  echo "run-checks: $PASS case(s), all as specified"
  exit 0
fi
echo "run-checks: $FAIL of $((PASS+FAIL)) case(s) FAILED"
echo "A guardrail that no longer catches what it was written to catch is worse than none:"
echo "it reports clean over the defect it was built for."
exit 1
