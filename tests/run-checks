mkdir -p "$TMP/toolscope/triage/skills/kb-x" "$TMP/toolscope/triage-reads/skills/kb-x"
tool_fixture "$TMP/toolscope/triage/skills/kb-x/SKILL.md" allowed-tools triage "Bash, Agent"
case_run "triage-tier file declaring Bash and Agent passes" 0 "clean" -- \
