kbo() { HOME="$OHOME" "$ENGINE/scripts/kb-library" "$@"; }
ovl_lib() { # name tags keywords
  build_clean "$OVD/$1"
  patch "$OVD/$1/INDEX.md" "s/^tags: .*\$/tags: $2/; s/^keywords: .*\$/keywords: $3/"
}
ovl_lib boards "[boards, Work_Items, sprints, backlog]" "[epics, Story Points, pipelines]"
ovl_lib backlogs "[backlog, work-item, sprint, scrum]" "[epic, story-points, velocity]"
ovl_lib recipes "[cooking, baking]" "[flour, yeast, oven]"
case_run "overlap: the first library has no neighbour, so no warning" 0 "registered boards at" -- kbo add "$OVD/boards"
OVL_BEFORE=$(git -C "$OVD/backlogs" status --porcelain)$(git -C "$OVD/backlogs" write-tree)
case_run "overlap: an unrelated library is registered, exit 0" 0 "registered recipes at" -- kbo add "$OVD/recipes"
case_run "overlap: ...and drew no warning" 0 "" -- \
  sh -c '! HOME="$1" "$2/scripts/kb-library" remove recipes | grep -q warning && ! HOME="$1" "$2/scripts/kb-library" add "$3" | grep -q warning' _ "$OHOME" "$ENGINE" "$OVD/recipes"
case_run "overlap: an overlapping library is registered with a warning naming the neighbour and terms" 0 "backlogs overlaps boards — 4 shared keywords/tags: epic, sprint, story-point, work-item" -- kbo add "$OVD/backlogs"
case_run "overlap: ...the warning suggests Not covered here" 0 "Not covered here" -- \
  sh -c 'HOME="$1" "$2/scripts/kb-library" remove backlogs >/dev/null && HOME="$1" "$2/scripts/kb-library" add "$3"' _ "$OHOME" "$ENGINE" "$OVD/backlogs"
case_run "overlap: ...and it is registered anyway" 0 "ok             backlogs" -- kbo list
case_run "overlap: re-adding it is a no-op" 0 "already registered" -- kbo add "$OVD/backlogs"
case_run "overlap: ...with no warning" 0 "" -- sh -c '! HOME="$1" "$2/scripts/kb-library" add "$3" | grep -q warning' _ "$OHOME" "$ENGINE" "$OVD/backlogs"
case_run "overlap: the library is untouched" 0 "" -- \
  sh -c '[ "$(git -C "$1" status --porcelain)$(git -C "$1" write-tree)" = "$2" ]' _ "$OVD/backlogs" "$OVL_BEFORE"
case_run "overlap: the registry holds only the entries" 0 "library.backlogs.path library.boards.path library.recipes.path" -- \
  sh -c 'git config --file "$1/.config/ai-kb/libraries" --list | cut -d= -f1 | grep -v origin | sort | tr "\n" " "' _ "$OHOME"

# ---------------------------------------- library pre-commit hook: xlinks ----
# The library hook is the engine's (library-hooks/pre-commit, ADR-0014): a library is shared
# by people who do not own it, so it carries no hook of its own. A clone is wired to it by
# kb-library add. Blocking a commit that breaks a registered sibling's citation, and skipping
# on an unregistered copy, are tested with the registry consumers below. Here: a link into a
# library that is simply not installed only warns, through the hook as through the script.
# A hermetic HOME (env -i): the registry is per machine, and this one holds only "solo".
LHOME="$TMP/lhook-home"; mkdir -p "$LHOME"
build_clean "$TMP/lhook/solo"
printf '\nSee [[gamma:widgets]].\n' >> "$TMP/lhook/solo/widgets.md"
patch "$TMP/lhook/solo/INDEX.md" 's|^last_swept: never$|&\nlinks_to:\n  gamma: https://example.com/gamma.git|'   # contract 2.6
git -C "$TMP/lhook/solo" add -A
HOME="$LHOME" "$ENGINE/scripts/kb-library" add "$TMP/lhook/solo" >/dev/null
case_run "library hook warns, but does not fail, on a link into an absent library" 0 "unresolvable" -- \
  sh -c "cd '$TMP/lhook/solo' && env -i HOME='$LHOME' PATH='$PATH' git -c user.email=t@t -c user.name=t commit -qm first"
case_run "the commit went through the engine's hook" 0 "" -- git -C "$TMP/lhook/solo" rev-parse -q --verify HEAD
case_run "kb-create-domain no longer writes a hook into a library" 1 "" -- \
  grep -q 'core.hooksPath .githooks' "$ENGINE/plugins/knowledge-tools/skills/kb-create-domain/SKILL.md"
# Issue #91: check-scope checks a vendors: list's form; only review can ask whether the vendors
# are alternatives. Both skills that touch a comparative library must ask it.
for s in kb-create-domain kb-audit; do
  case_run "$s asks whether a comparative library's vendors are alternatives" 0 "" -- \
    grep -q 'instead of another, for the same job' "$ENGINE/plugins/knowledge-tools/skills/$s/SKILL.md"
done

# -------------------------------------------------------- check-exec-bits ----
mkdir -p "$TMP/bits/.githooks"; git init -q "$TMP/bits"
printf '#!/usr/bin/env bash\ntrue\n' > "$TMP/bits/.githooks/pre-commit"
git -C "$TMP/bits" add -A >/dev/null 2>&1
git -C "$TMP/bits" update-index --chmod=-x .githooks/pre-commit 2>/dev/null
case_run "hook recorded non-executable" 1 "NOT EXECUTABLE" -- "$ENGINE/scripts/check-exec-bits" "$TMP/bits"

mkdir -p "$TMP/bits2/scripts"; git init -q "$TMP/bits2"
printf '#!/usr/bin/env python3\nprint(1)\n' > "$TMP/bits2/scripts/do-thing"
git -C "$TMP/bits2" add -A >/dev/null 2>&1
git -C "$TMP/bits2" update-index --chmod=-x scripts/do-thing 2>/dev/null
case_run "shebang script recorded non-executable, whatever its name" 1 "do-thing" -- \
  "$ENGINE/scripts/check-exec-bits" "$TMP/bits2"

# --------------------------------------------------------- check-tool-scope ----
# tool_fixture <path> <key: tools|allowed-tools> <tier, or "" to omit> <tools value, or "" to omit>
tool_fixture() {
  local path="$1" key="$2" tier="$3" tools="$4"
  mkdir -p "$(dirname "$path")"
  {
    echo "---"
    echo "name: fx"
    echo "description: a test fixture."
    [ -n "$tools" ] && echo "$key: $tools"
    [ -n "$tier" ] && echo "tier: $tier"
    echo "---"
    echo "# fx"
  } > "$path"
}

mkdir -p "$TMP/toolscope/clean/agents" "$TMP/toolscope/clean/skills/kb-x"
tool_fixture "$TMP/toolscope/clean/agents/fx.md" tools retrieval "Read, Grep, Glob"
tool_fixture "$TMP/toolscope/clean/skills/kb-x/SKILL.md" allowed-tools curation "Read, Write, Bash"
case_run "clean tool-scope fixture passes" 0 "clean" -- \
  "$ENGINE/scripts/check-tool-scope" "$TMP/toolscope/clean"

mkdir -p "$TMP/toolscope/notier/agents"
tool_fixture "$TMP/toolscope/notier/agents/fx.md" tools "" "Read, Grep, Glob"
case_run "file missing a tier fails" 1 "no tier:" -- \
  "$ENGINE/scripts/check-tool-scope" "$TMP/toolscope/notier"

mkdir -p "$TMP/toolscope/noscope/agents"
tool_fixture "$TMP/toolscope/noscope/agents/fx.md" tools retrieval ""
case_run "file missing a tool-scope field fails" 1 "no tools:" -- \
  "$ENGINE/scripts/check-tool-scope" "$TMP/toolscope/noscope"

mkdir -p "$TMP/toolscope/overreach/agents"
tool_fixture "$TMP/toolscope/overreach/agents/fx.md" tools retrieval "Read, Grep, Glob, Write"
case_run "retrieval-tier file declaring Write fails" 1 \
