# ----------------------------------------------------------- kb-bootstrap ----
# kb-bootstrap writes machine-level config OUTSIDE this repo (a settings file,
# global git config, a shell rc) — the highest-blast-radius script here — so it
# must default to report-only, exactly like kb-verify's --yes. Build a fixture
# "engine" (the script needs CONVENTIONS.md, a marketplace.json and an
# executable kb-session-start to accept a directory as one) plus a hermetic
# HOME, so this test can never touch the real ~/.claude or ~/.gitconfig.
BFX="$TMP/bootstrap-fx"; mkdir -p "$BFX/scripts" "$BFX/.claude-plugin"
cp "$ENGINE/scripts/kb-bootstrap" "$BFX/scripts/kb-bootstrap"; chmod +x "$BFX/scripts/kb-bootstrap"
printf '# fixture contract\n' > "$BFX/CONVENTIONS.md"
printf '{"name":"fx-market","plugins":[{"name":"fx-plugin"}]}\n' > "$BFX/.claude-plugin/marketplace.json"
printf '#!/usr/bin/env bash\ntrue\n' > "$BFX/scripts/kb-session-start"
chmod +x "$BFX/scripts/kb-session-start"
BHOME="$TMP/bootstrap-home"; mkdir -p "$BHOME"

case_run "no flag: reports drift, changes nothing" 1 "would-set" -- \
  env -i HOME="$BHOME" PATH="$PATH" "$BFX/scripts/kb-bootstrap"
case_run "no flag: settings.json was not created" 1 "" -- test -e "$BHOME/.claude/settings.json"
case_run "no flag: global git config was not touched" 1 "" -- \
  env -i HOME="$BHOME" PATH="$PATH" git config --global --get kb.engineRoot
case_run "--check: same report-only behaviour, spelled out" 1 "would-set" -- \
  env -i HOME="$BHOME" PATH="$PATH" "$BFX/scripts/kb-bootstrap" --check

env -i HOME="$BHOME" PATH="$PATH" "$BFX/scripts/kb-bootstrap" --apply >/dev/null 2>&1
case_run "--apply: settings.json now names the fixture engine" 0 "$BFX" -- \
  cat "$BHOME/.claude/settings.json"
case_run "--apply: global git config now names the fixture engine" 0 "$BFX" -- \
  env -i HOME="$BHOME" PATH="$PATH" git config --global --get kb.engineRoot
# Issue #40: a subagent never sees the SessionStart context, so kb-retrieve gets it from a
# SubagentStart hook matched to its plugin-scoped name, and nothing else is given it.
case_run "--apply: SubagentStart hook is matched to the plugin's kb-retrieve" 0 "" -- \
  python3 -c 'import json,sys; g=json.load(open(sys.argv[1]))["hooks"]["SubagentStart"]; \
ours=[x for x in g if any("kb-session-start" in h["command"] for h in x["hooks"])]; \
assert len(ours)==1 and ours[0]["matcher"]=="^fx-plugin:kb-retrieve$", ours; \
assert ours[0]["hooks"][0]["command"].endswith(" --subagent"), ours' "$BHOME/.claude/settings.json"
case_run "--apply twice: still exactly one SubagentStart hook of ours" 0 "" -- \
  sh -c 'env -i HOME="$1" PATH="$PATH" "$2" --apply >/dev/null 2>&1 && python3 -c "import json,sys; g=json.load(open(sys.argv[1]))[\"hooks\"][\"SubagentStart\"]; assert len(g)==1, g" "$1/.claude/settings.json"' _ "$BHOME" "$BFX/scripts/kb-bootstrap"
case_run "--check after --apply: the SubagentStart hook is not reported as drift" 0 "ok" -- \
  sh -c 'env -i HOME="$1" PATH="$PATH" "$2" --check | grep -F "SubagentStart hook"' _ "$BHOME" "$BFX/scripts/kb-bootstrap"

# ADR-0014: a library is installed by being registered. --apply registers what sits in the
# engine's kb/ ONCE (before ADR-0014 that was how a library was installed), and wires every
# registered clone to the engine's library hook through its local core.hooksPath.
for f in kb-library kb-libraries; do cp "$ENGINE/scripts/$f" "$BFX/scripts/$f"; done
mkdir -p "$BFX/library-hooks"; printf '#!/usr/bin/env bash\ntrue\n' > "$BFX/library-hooks/pre-commit"
build_clean "$BFX/kb/mig"; BREG="$BHOME/.config/ai-kb/libraries"
# The --apply runs above found kb/ empty and recorded the migration as done, as a fresh machine
# would. This machine was bootstrapped before ADR-0014: no registry yet, a library in kb/.
rm -f "$BREG"
bstrap() { env -i HOME="$BHOME" PATH="$PATH" "$BFX/scripts/kb-bootstrap" "$@"; }
case_run "bootstrap: a library in kb/ is reported for registration" 1 "would-register" -- bstrap --check
case_run "bootstrap: --check registers nothing" 1 "" -- git config --file "$BREG" --get library.mig.path
bstrap --apply >/dev/null 2>&1
case_run "bootstrap: --apply registers it" 0 "$BFX/kb/mig" -- git config --file "$BREG" --get library.mig.path
case_run "bootstrap: --apply wires it to the engine's library hook" 0 "$BFX/library-hooks" -- \
  git -C "$BFX/kb/mig" config --get core.hooksPath
case_run "bootstrap: --check afterwards reports nothing to do" 0 "Everything is configured." -- bstrap --check
git -C "$BFX/kb/mig" config core.hooksPath .githooks
case_run "bootstrap: a clone wired elsewhere is drift" 1 "would-set" -- bstrap --check
bstrap --apply >/dev/null 2>&1
case_run "bootstrap: --apply re-wires it" 0 "$BFX/library-hooks" -- git -C "$BFX/kb/mig" config --get core.hooksPath
HOME="$BHOME" "$BFX/scripts/kb-library" remove mig >/dev/null
bstrap --apply >/dev/null 2>&1
case_run "bootstrap: the migration runs once — a removed library stays removed" 1 "" -- \
  git config --file "$BREG" --get library.mig.path
case_run "bootstrap: --apply records the library home, defaulting to the engine's kb/" 0 "$BFX/kb" -- \
  git config --file "$BREG" --get kb.libraryHome
case_run "bootstrap: --library-home without --apply changes nothing" 1 "would-set" -- bstrap --library-home "$TMP/bhome-lib"
case_run "bootstrap: ...and the home is unchanged" 0 "$BFX/kb" -- git config --file "$BREG" --get kb.libraryHome
mkdir -p "$TMP/bhome-lib"
bstrap --apply --library-home "$TMP/bhome-lib" >/dev/null 2>&1
case_run "bootstrap: --apply --library-home sets it" 0 "$TMP/bhome-lib" -- git config --file "$BREG" --get kb.libraryHome
case_run "bootstrap: a home that was set is not reset by a later --apply" 0 "" -- \
  sh -c 'env -i HOME="$1" PATH="$PATH" "$2" --apply >/dev/null 2>&1; [ "$(git config --file "$3" --get kb.libraryHome)" = "$4" ]' _ "$BHOME" "$BFX/scripts/kb-bootstrap" "$BREG" "$TMP/bhome-lib"
case_run "bootstrap: an unknown option is still refused" 2 "unknown option" -- bstrap --frobnicate
HOME="$BHOME" "$BFX/scripts/kb-library" add "$BFX/kb/mig" >/dev/null
mv "$BFX/kb/mig" "$BFX/kb/mig-moved"
case_run "bootstrap: a registered library gone missing is drift, named" 1 "missing  mig" -- bstrap --check
mv "$BFX/kb/mig-moved" "$BFX/kb/mig"

# ------------------------------------------------------------- kb-verify ----
build_clean "$TMP/vpass"
printf 'Recheck: true\n' >> "$TMP/vpass/widgets.md"
case_run "passing assertion is reported, not applied" 0 "still hold" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vpass" --all --yes

build_clean "$TMP/vfail"
printf 'Recheck: false\n' >> "$TMP/vfail/widgets.md"
case_run "failing assertion exits 1" 1 "FAILED" -- "$ENGINE/scripts/kb-verify" "$TMP/vfail" --all --yes

build_clean "$TMP/vfail2"
printf 'Recheck: false\n' >> "$TMP/vfail2/widgets.md"
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: agent · method: manual/' "$TMP/vfail2/widgets.md"
"$ENGINE/scripts/kb-verify" "$TMP/vfail2" --all --yes --apply >/dev/null 2>&1
# the old date must survive --apply: a verifier that restamps what it just
# contradicted destroys the evidence that something changed.
case_run "a failing assertion's stamp is never rewritten" 0 "Verified: 2026-01-01" -- \
  grep -F "Verified:" "$TMP/vfail2/widgets.md"

# Issue #16: a restamp is a query-method verification, whatever method it carried before.
build_clean "$TMP/vmethod"
printf 'Recheck: true\n' >> "$TMP/vmethod/widgets.md"
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: agent · method: doc-review/' "$TMP/vmethod/widgets.md"
"$ENGINE/scripts/kb-verify" "$TMP/vmethod" --all --yes --apply >/dev/null 2>&1
case_run "--apply restamp records method: query" 0 "by: agent · method: query" -- \
  grep -F "Verified: $(date +%F)" "$TMP/vmethod/widgets.md"

# Rechecks that cannot fail (issues #34, #41): a doc-review assertion that greps a page for its
# own title, or one sentence reused across many sections, passes while the page exists. Found
# statically, on every run, with nothing fetched or executed; reported, never a failure.
build_clean "$TMP/vweak"
S='Verified: 2026-09-22 · by: agent · method: doc-review'
U='https://docs.example.test/widgets'
LONG='A widget holds up to twelve things at once'
{
  printf '\n## Title grep\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qiF 'Widgets'\n" "$U"
  printf '\n## Reuse one\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qiF '%s'\n" "$U" "$LONG"
  printf '\n## Reuse two\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qiF '%s'\n" "$U" "$LONG"
  printf '\n## Own sentence\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qiF 'the limit applies per widget, not per account'\n" "$U"
  printf '\n## Local query\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: f=../x; [ -f \"\$f\" ] && ! grep -qE 'import' \"\$f\"\n"
} >> "$TMP/vweak/widgets.md"
fm gadgets general > "$TMP/vweak/gadgets.md"
{ printf '# Gadgets\n\n## Reuse three\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qiF '%s'\n" "$U" "$LONG"; } >> "$TMP/vweak/gadgets.md"
printf -- '- [gadgets](gadgets.md) — gadgets\n' >> "$TMP/vweak/INDEX.md"
# Issue #65: a short pattern that BINDS two pieces of text, split by markup or (outside -F) by
# regex, tests a relation, not a title: not flagged. One run of text, however wrapped, still is.
# An alternation is as weak as its weakest branch.
{
  printf '\n## Bound by a tag\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qF 'Story Points</a> (Agile)'\n" "$U"
  printf '\n## Bound by a regex\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | tr -d '\\\\n' | grep -qE 'Data type=HTML(<[^>]*>)+All<'\n" "$U"
  printf '\n## Wrapped title\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qF '<h1>Widgets</h1>'\n" "$U"
  printf '\n## Literal regex under F\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qF 'Widgets.*Limits'\n" "$U"
  printf '\n## Grouped alternation\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qE '<h1>(Widgets|widgets)</h1>'\n" "$U"
  printf '\n## Alternation\n\nSource: manual\n%s\n' "$S"
  printf "Recheck: curl -fsSL %s | grep -qE 'Widgets|Max</td><td>12'\n" "$U"
} >> "$TMP/vweak/widgets.md"
case_run "weak recheck: a short fragment is flagged" 0 "WEAK widgets.md § Title grep: greps 1 word" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vweak"
case_run "weak recheck: one (url, fragment) backing three sections in two files is flagged" 0 "WEAK one fragment backs 3 sections in 2 files" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vweak"
case_run "weak recheck: a claim's own sentence is not flagged" 1 "" -- \
  bash -c '"$1" "$2" | grep -qE "WEAK .*Own sentence"' _ "$ENGINE/scripts/kb-verify" "$TMP/vweak"
case_run "weak recheck: a local query that greps a file is not flagged" 1 "" -- \
  bash -c '"$1" "$2" | grep -qE "WEAK .*Local query"' _ "$ENGINE/scripts/kb-verify" "$TMP/vweak"
case_run "weak recheck: reported without --yes, and nothing runs" 0 "NOT run" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vweak" --all
for sec in "Bound by a tag" "Bound by a regex"; do
  case_run "weak recheck: a pattern binding two texts is not flagged ($sec)" 1 "" -- \
    bash -c '"$1" "$2" | grep -qF "WEAK widgets.md § $3:"' _ "$ENGINE/scripts/kb-verify" "$TMP/vweak" "$sec"
done
for sec in "Wrapped title" "Literal regex under F" "Alternation" "Grouped alternation"; do
  case_run "weak recheck: one run of text is still flagged ($sec)" 0 "WEAK widgets.md § $sec:" -- \
    "$ENGINE/scripts/kb-verify" "$TMP/vweak"
done
case_run "weak recheck: a warning, never a failure" 0 "" -- "$ENGINE/scripts/kb-verify" "$TMP/vweak"
case_run "weak recheck: the fixture library is otherwise clean" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/vweak"

# Issue #60: an assertion runs from its fact file's directory, and a library may be registered
# anywhere (ADR-0014), so `../../scripts` reaches the engine only in the default layout. kb-verify
# exports the engine it belongs to as KB_ENGINE_ROOT, and flags a Recheck that climbs out of its
# library by a relative path. These fixture libraries sit in $TMP, outside any engine.
build_clean "$TMP/vengine"
printf 'Recheck: [ -x "$KB_ENGINE_ROOT/scripts/kb-verify" ]\n' >> "$TMP/vengine/widgets.md"
case_run "recheck: KB_ENGINE_ROOT names the engine, for a library outside it" 0 "still hold" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vengine" --all --yes
case_run "recheck: KB_ENGINE_ROOT is the running engine, not a stale value from the caller" 0 "still hold" -- \
  env KB_ENGINE_ROOT="$TMP/no-such-engine" "$ENGINE/scripts/kb-verify" "$TMP/vengine" --all --yes
case_run "recheck: one using KB_ENGINE_ROOT is not flagged as reaching outside" 1 "" -- \
  bash -c '"$1" "$2" | grep -q "OUTSIDE"' _ "$ENGINE/scripts/kb-verify" "$TMP/vengine"
build_clean "$TMP/voutside"
printf 'Recheck: s=$(cd ../../scripts && pwd) && [ -x "$s/kb-verify" ]\n' >> "$TMP/voutside/widgets.md"
case_run "recheck: one reaching outside its library by a relative path is flagged" 0 "OUTSIDE widgets.md" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/voutside"
case_run "recheck: the flag names the fix" 0 "KB_ENGINE_ROOT" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/voutside"
mkdir -p "$TMP/voutside/sub"
fm inner general > "$TMP/voutside/sub/inner.md"
printf '# Inner\n\n## Sibling\n\nSource: manual\nVerified: 2026-09-22 · by: agent · method: manual\nRecheck: [ -f ../widgets.md ]\n' >> "$TMP/voutside/sub/inner.md"
case_run "recheck: a relative path that stays inside the library is not flagged" 1 "" -- \
  bash -c '"$1" "$2" | grep -q "OUTSIDE sub/inner.md"' _ "$ENGINE/scripts/kb-verify" "$TMP/voutside"

# A restamp moves the floor, so --apply rewrites a declared verified: to match (issue #27);
# otherwise kb-verify's own output would fail check-kb in the library's pre-commit.
build_clean "$TMP/vfloor"
sed -i 's/^scope: general$/scope: general\nverified: 2026-01-01/' "$TMP/vfloor/widgets.md"
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: agent · method: manual/' "$TMP/vfloor/widgets.md"
printf 'Recheck: true\n' >> "$TMP/vfloor/widgets.md"
"$ENGINE/scripts/kb-verify" "$TMP/vfloor" --all --yes --apply >/dev/null 2>&1
case_run "--apply moves the frontmatter floor with the restamp" 0 "verified: $(date +%F)" -- \
  grep -F "verified:" "$TMP/vfloor/widgets.md"
case_run "--apply leaves a library check-kb still passes" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/vfloor"

# Issue #19: the value after --budget is the budget, not a second tree.
build_clean "$TMP/vbudget"
printf 'Recheck: true\n' >> "$TMP/vbudget/widgets.md"
case_run "--budget N overrides the domain's verifier_budget" 0 "budget 7)" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vbudget" --all --budget 7

build_clean "$TMP/vnone"
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: agent · method: manual/' "$TMP/vnone/widgets.md"
case_run "stale section with no assertion is named, not skipped" 0 "no assertion" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vnone" --all

# agent_ttl (issue #30): a domain may declare how long an agent stamp stays fresh. Derived as a
# tenth of the horizon, a vendor-product library's agent stamps (90–180d band: 9–18d) expired
# before every monthly sweep, and the only lever was the horizon, which also sets the human
# TTL. The fixture's horizon is 90d (default agent TTL 9d); its agent stamp is 20 days old.
ttl_lib() { # ttl_lib <dir> [agent_ttl line]
  build_clean "$1"
  printf 'Recheck: true\n' >> "$1/widgets.md"
  sed -i "s/^Verified: .*\$/Verified: $(date -d '20 days ago' +%F) · by: agent · method: manual/" "$1/widgets.md"
  [ -n "${2:-}" ] && sed -i "s/^verifier_budget: 5\$/verifier_budget: 5\n$2/" "$1/INDEX.md"
  return 0
}
ttl_lib "$TMP/ttl-default"
case_run "agent_ttl: undeclared, it is a tenth of the horizon" 0 "agent TTL 9d" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/ttl-default"
case_run "agent_ttl: undeclared, a 20-day agent stamp is due" 0 "1 fact due for recheck" -- \
  "$ENGINE/scripts/kb-due" "$TMP/ttl-default" --nudge
ttl_lib "$TMP/ttl-30" "agent_ttl: 30d   # outlasts the monthly sweep"
case_run "agent_ttl: a declared value is used" 0 "agent TTL 30d" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/ttl-30"
case_run "agent_ttl: within it, a 20-day agent stamp is not due" 0 "" -- \
  bash -c '! "$1" "$2" --nudge | grep -q "due for recheck"' _ "$ENGINE/scripts/kb-due" "$TMP/ttl-30"
case_run "agent_ttl: a declared value passes check-kb" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/ttl-30"
# An agent TTL as long as the horizon erases the trust tier between agent and human stamps.
ttl_lib "$TMP/ttl-eq" "agent_ttl: 90d"
case_run "agent_ttl: not shorter than the horizon fails check-kb" 1 "agent_ttl" -- \
  "$ENGINE/scripts/check-kb" "$TMP/ttl-eq"
case_run "agent_ttl: not shorter than the horizon is refused by kb-verify" 2 "agent_ttl" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/ttl-eq"
case_run "agent_ttl: an invalid one is a kb-due warning, never a crash" 0 "agent_ttl" -- \
  "$ENGINE/scripts/kb-due" "$TMP/ttl-eq" --nudge
ttl_lib "$TMP/ttl-bad" "agent_ttl: a month"
case_run "agent_ttl: not <N>d fails check-kb" 1 "agent_ttl" -- "$ENGINE/scripts/check-kb" "$TMP/ttl-bad"

# Issue #80: importing an extensionless script as a module (an ad-hoc SourceFileLoader, as an
# agent or a person debugging does) writes scripts/__pycache__/, and the engine checkout then
# looks modified. The engine's own loaders turn bytecode off; anyone else's are covered here.
case_run "a bytecode cache under scripts/ is ignored by git (#80)" 0 "" -- \
  git -C "$ENGINE" check-ignore -q scripts/__pycache__/kb-sourcescpython-314.pyc

# kb_contract (ADR-0016): a root INDEX.md may declare the contract version it was built to,
# MAJOR.MINOR. Absent is read as 2.0, so a library that predates the field stays valid.
kc_lib() { # kc_lib <dir> <kb_contract line, or empty for none>
  build_clean "$1"
  sed -i '/^kb_contract:/d' "$1/INDEX.md"
  [ -n "$2" ] && sed -i "s/^verifier_budget: 5\$/verifier_budget: 5\n$2/" "$1/INDEX.md"
  return 0
}
kc_lib "$TMP/kc-none" ""
case_run "kb_contract: absent passes check-kb (read as 2.0)" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/kc-none"

# Version gating (ADR-0016 step 2). The engine knows the versions CONVENTIONS §14 lists.
case_run "kb_contract: absent is read as 2.0, and told it is behind" 0 "built to contract 2.0" -- \
  "$ENGINE/scripts/check-kb" "$TMP/kc-none"
case_run "kb_contract: the behind note says what the newer version adds" 0 "2.1: " -- \
  "$ENGINE/scripts/check-kb" "$TMP/kc-none"
build_clean "$TMP/kc-newest"
case_run "kb_contract: a library on the newest version gets no note" 0 "" -- \
  bash -c '"$1" "$2" | grep -q "built to contract" && exit 1; exit 0' _ "$ENGINE/scripts/check-kb" "$TMP/kc-newest"
# #71's rejection is contract 2.1: a 2.0 library is warned and passes; 2.1 fails (the srcraw case).
kc_lib "$TMP/kc-raw20" 'kb_contract: "2.0"'; mkdir -p "$TMP/kc-raw20/sources"
printf 'CREATE TABLE t (id int);\n' > "$TMP/kc-raw20/sources/t.sql"
case_run "contract 2.0: a raw artifact under sources/ is a warning, and the check passes" 0 "WARN" -- \
  "$ENGINE/scripts/check-kb" "$TMP/kc-raw20"
case_run "contract 2.0: the warning names the version that makes it a failure" 0 "fails from contract 2.1" -- \
  "$ENGINE/scripts/check-kb" "$TMP/kc-raw20"
# Ahead by a minor: checked by the newest rules this engine knows, and served.
kc_lib "$TMP/kc-ahead" 'kb_contract: "2.9"'
case_run "contract ahead by a minor: passes, and says to upgrade the engine" 0 "upgrade the engine" -- \
  "$ENGINE/scripts/check-kb" "$TMP/kc-ahead"
mkdir -p "$TMP/kc-ahead/sources"; printf 'CREATE TABLE t (id int);\n' > "$TMP/kc-ahead/sources/t.sql"
case_run "contract ahead by a minor: the newest known rules apply" 1 "archive it under documents/" -- \
  "$ENGINE/scripts/check-kb" "$TMP/kc-ahead"
# Unsupported majors: one this engine has not seen, and one it never published.
for v in 3.0 1.0; do
  kc_lib "$TMP/kc-major$v" "kb_contract: \"$v\""
  case_run "contract $v: an unsupported major fails check-kb" 1 "not supported" -- "$ENGINE/scripts/check-kb" "$TMP/kc-major$v"
done
kc_lib "$TMP/kc-quoted" 'kb_contract: "2.0"'
case_run "kb_contract: a quoted MAJOR.MINOR passes check-kb" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/kc-quoted"
kc_lib "$TMP/kc-comment" "kb_contract: '2.0'   # built to contract 2.0"
case_run "kb_contract: single-quoted with a comment passes check-kb" 0 "clean" -- \
  "$ENGINE/scripts/check-kb" "$TMP/kc-comment"
# Quoting is required: a YAML reader turns a bare 2.10 into the number 2.1.
kc_lib "$TMP/kc-bare" 'kb_contract: 2.0'
case_run "kb_contract: a bare (unquoted) value fails check-kb" 1 "quote" -- "$ENGINE/scripts/check-kb" "$TMP/kc-bare"
for bad in '"two"' '"2"' '"2.0.1"' '"2.01"' '"v2.0"' '""' '"2.0'; do
  kc_lib "$TMP/kc-bad" "kb_contract: $bad"
  case_run "kb_contract: '$bad' fails check-kb" 1 "kb_contract" -- "$ENGINE/scripts/check-kb" "$TMP/kc-bad"
done

# kb-verify's own --yes gate (§3 of its docstring): without it, a Recheck command
# is printed, never executed. Prove it with an observable side effect — a rewritten
# date can be missed by eye, a file that must-not-exist cannot.
build_clean "$TMP/vgate"
printf 'Recheck: touch "%s/vgate-sentinel"\n' "$TMP" >> "$TMP/vgate/widgets.md"
case_run "no --yes: the command is printed, not run" 0 "NOT run" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vgate" --all
case_run "no --yes: its side effect never happened" 1 "" -- test -e "$TMP/vgate-sentinel"

"$ENGINE/scripts/kb-verify" "$TMP/vgate" --all --yes >/dev/null 2>&1
case_run "--yes: the command actually runs" 0 "" -- test -e "$TMP/vgate-sentinel"

# ------------------------------------------- kb-verify: Verifier fixture ----
# Exit criterion (§5A "Testing the librarian agents"): against a fact seeded stale
# and wrong, the Verifier must produce a flag, not a false-fresh stamp. Deliberate
# divergence from the plan text: §9.13 records the built design — a failure is
# reported and the fact left untouched, never written to contradictions.md,
# because automating the choice between a stale fact, a wrong assertion and a
# real contradiction destroys the evidence a human needs; this fixture asserts
# the built design, not the plan's original wording.
#
# The fixture's "local system" is a config file beside the facts; each Recheck
# greps it. One default (non --all) run below exercises staleness filtering,
# the untouched wrong fact, and the restamped true fact together.
# Dates are computed, never typed: a literal "today" turns this into a test that
# fails on its own the next morning.
VTODAY=$(date +%F)
build_clean "$TMP/vfixture"
printf 'port=8080\n' > "$TMP/vfixture/system-config.txt"

fm stale-wrong general > "$TMP/vfixture/stale-wrong.md"
cat >> "$TMP/vfixture/stale-wrong.md" <<'EOF'
# Stale Wrong

## Port

The service listens on port 9090.

Source: manual
Verified: 2026-01-01 · by: human · method: query
Recheck: grep -q '^port=9090$' system-config.txt
EOF

fm stale-true general > "$TMP/vfixture/stale-true.md"
cat >> "$TMP/vfixture/stale-true.md" <<'EOF'
# Stale True

## Port

The service listens on port 8080.

Source: manual
Verified: 2026-01-01 · by: human · method: query
Recheck: grep -q '^port=8080$' system-config.txt
EOF

fm fresh-fact general > "$TMP/vfixture/fresh-fact.md"
cat >> "$TMP/vfixture/fresh-fact.md" <<EOF
# Fresh Fact

## Timeout

The request timeout is 30 seconds.

Source: manual
Verified: $VTODAY · by: agent · method: query
Recheck: touch "$TMP/vfixture-sentinel"
EOF

printf -- '- [stale-wrong](stale-wrong.md) — a stale, wrong fact\n- [stale-true](stale-true.md) — a stale, true fact\n- [fresh-fact](fresh-fact.md) — a fresh fact\n' >> "$TMP/vfixture/INDEX.md"
cp "$TMP/vfixture/stale-wrong.md" "$TMP/vfixture/stale-wrong.md.orig"

case_run "verifier fixture: stale wrong fact is reported failing, not false-fresh" 1 \
  "FAIL stale-wrong.md § Port" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vfixture" --yes --apply

case_run "verifier fixture: stale wrong fact's file is byte-for-byte unchanged" 0 "" -- \
  cmp -s "$TMP/vfixture/stale-wrong.md" "$TMP/vfixture/stale-wrong.md.orig"

case_run "verifier fixture: stale true fact is restamped to today" 0 "Verified: $VTODAY" -- \
  grep -F "Verified:" "$TMP/vfixture/stale-true.md"

case_run "verifier fixture: fresh fact's Recheck is not run when it is not due" 1 "" -- \
  test -e "$TMP/vfixture-sentinel"

# Negative control for the line above: on a separate copy (the run just above already
# restamped stale-true.md, so it cannot be reused), force selection with --all to prove
# the sentinel assertion CAN fire — an assertion that cannot fail is worse than none
# (§7, §9.13).
build_clean "$TMP/vfixture-all"
fm fresh-fact general > "$TMP/vfixture-all/fresh-fact.md"
cat >> "$TMP/vfixture-all/fresh-fact.md" <<EOF
# Fresh Fact

## Timeout

The request timeout is 30 seconds.

Source: manual
Verified: $VTODAY · by: agent · method: query
Recheck: touch "$TMP/vfixture-all-sentinel"
EOF
printf -- '- [fresh-fact](fresh-fact.md) — a fresh fact\n' >> "$TMP/vfixture-all/INDEX.md"
"$ENGINE/scripts/kb-verify" "$TMP/vfixture-all" --all --yes >/dev/null 2>&1
case_run "verifier fixture: --all forces the fresh fact's Recheck to run" 0 "" -- \
  test -e "$TMP/vfixture-all-sentinel"

# --yes without --apply: nothing is restamped at all. A fresh copy of the true fact
# is needed because the first run above already restamped its stale-true.md.
build_clean "$TMP/vfixture-noapply"
printf 'port=8080\n' > "$TMP/vfixture-noapply/system-config.txt"
fm stale-true general > "$TMP/vfixture-noapply/stale-true.md"
cat >> "$TMP/vfixture-noapply/stale-true.md" <<'EOF'
# Stale True

## Port

The service listens on port 8080.

Source: manual
Verified: 2026-01-01 · by: human · method: query
Recheck: grep -q '^port=8080$' system-config.txt
EOF
printf -- '- [stale-true](stale-true.md) — a stale, true fact\n' >> "$TMP/vfixture-noapply/INDEX.md"
"$ENGINE/scripts/kb-verify" "$TMP/vfixture-noapply" --yes >/dev/null 2>&1
case_run "verifier fixture: --yes without --apply restamps nothing" 0 "Verified: 2026-01-01" -- \
  grep -F "Verified:" "$TMP/vfixture-noapply/stale-true.md"

# ------------------------------------------- kb-verify: needs-attention queue ----
# Phase 5 (plan §6 exit: "stale or drifted facts surface as a queue rather than rotting
# silently"). Built on the Verifier fixture above: its first run (line ~532) already ran
# stale-wrong.md's failing assertion under --yes --apply, so this is the queue that run
# produced, not a fresh one — proving the queue write happens as a side effect of the
# same run the byte-for-byte-unchanged check above already exercises, not a separate path.
VQ="$TMP/vfixture/needs-attention.md"
case_run "queue: a failing assertion under --yes writes exactly one entry" 0 "" -- \
  sh -c "[ \$(grep -c '^- id:' '$VQ') = 1 ]"
case_run "queue: entry names the failing file" 0 "" -- grep -qF 'file: "stale-wrong.md"' "$VQ"
case_run "queue: entry names the section" 0 "" -- grep -qF 'section: "Port"' "$VQ"
case_run "queue: entry carries the assertion" 0 "" -- grep -qF "grep -q '^port=9090\$' system-config.txt" "$VQ"
case_run "queue: entry carries the stamp it carried when it failed" 0 "" -- \
  grep -qF 'stamp: "2026-01-01 · by: human · method: query"' "$VQ"
case_run "queue: entry is open, for a human to triage" 0 "" -- grep -qF 'status: "open"' "$VQ"
case_run "queue: an assertion that ran and returned false is category stale-recheck" 0 "" -- \
  grep -qF 'category: "stale-recheck"' "$VQ"
case_run "queue: not miscategorized as the command-error variant" 1 "" -- \
  grep -qF 'category: "stale-recheck-error"' "$VQ"
case_run "queue: the passing stale-true fact gets no entry" 1 "" -- grep -qF 'file: "stale-true.md"' "$VQ"
