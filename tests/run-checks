# Phase 4 step 6 (§5A "Never automated" + "Enforce it, don't just declare it"):
# detect deleting/renaming-away a fact file, removing a CONFLICTED marker,
# promoting a scope, and editing the engine's contract or decision record — so CI
# can gate a PR on the finding rather than a human happening to notice the diff.
# Detection only: these fixtures prove it fires on the right diff and only that
# diff, each one a committed base plus a single offending commit on top.

blast_base() { # blast_base <dir> [scope] -- a committed library, ready for a second commit
  build_clean "$1" "${2:-general}"
  git -C "$1" -c user.email=t@t -c user.name=t commit -qm base >/dev/null 2>&1
}

