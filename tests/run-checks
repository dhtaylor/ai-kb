grade() { # grade <name> <want-exit> <want-text> <Q1 record>
  printf '%s\nQ2||fact not found — check KB\nQ3||fact not found — check KB\n' "$4" > "$TMP/ge/answers"
  case_run "$1" "$2" "$3" -- "$ENGINE/scripts/grade-eval" "$TMP/ge/kb/fx" "$TMP/ge/answers"
}
