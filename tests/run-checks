# ------------------------------------------------------------ grade-routing ----
# The agent tier of the routing check, graded from a subagent transcript's tool calls. The
# transcripts are SYNTHETIC: assistant records whose message.content holds tool_use blocks,
# the shape Claude Code writes, built here and never copied from a real session.
mk_tr() { # mk_tr <out.jsonl> <Tool:arg[@@result]>...   Read:<file_path>  Glob:<pattern>  Grep:<path>[|<mode>]
  # @@NONE leaves the call unanswered; with no @@ the result is "ok"
  local out="$1"; shift
  python3 - "$out" "$@" <<'PY'
import json, sys
out, calls = sys.argv[1], sys.argv[2:]
key = {"Read": "file_path", "Glob": "pattern", "Grep": "path"}
recs = [{"type": "user", "message": {"role": "user", "content": "a question"}}]
for i, c in enumerate(calls):
    tool, arg = c.split(":", 1)
    arg, _, res = arg.partition("@@")
    inp = {key[tool]: arg}
    if tool == "Grep":
        inp["pattern"] = "x"
        if "|" in arg: inp["path"], inp["output_mode"] = arg.split("|", 1)
    recs.append({"type": "assistant", "message": {"role": "assistant", "content": [
        {"type": "text", "text": "looking"}, {"type": "tool_use", "id": f"t{i}", "name": tool, "input": inp}]}})
    if res != "NONE":
        recs.append({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": f"t{i}", "content": res or "ok"}]}})
open(out, "w").write("\n".join(json.dumps(r) for r in recs) + "\n")
PY
}
