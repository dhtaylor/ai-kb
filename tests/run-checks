# ------------------------------------------------- kb-capture refuses secrets ----
# Issue #9: a note holding a credential or identifier is refused BEFORE anything is
# written, because retrieval reads the working tree before any commit hook runs.
# Fixtures are assembled at run time, as above.
cap_tree() { mkdir -p "$1"; git init -q "$1"; "$ENGINE/scripts/kb-init" "$1" >/dev/null 2>&1; }
cap_snap() { (cd "$1" && find knowledge -type f -print0 | sort -z | xargs -0 sha256sum); }
CAPPW="Abc12#def!""45(ghXYZ"
cap_tree "$TMP/cap"
printf 'Tried the login.\n%s = %s\nDidn'"'"'t test the rotation.\n' "pass""word" "$CAPPW" > "$TMP/cap-secret.txt"
cp "$TMP/cap-secret.txt" "$TMP/cap-secret.orig"
cap_snap "$TMP/cap" > "$TMP/cap.before"
case_run "kb-capture --from refuses a labelled secret, showing SECRET? and the line" 1 "2:pass" -- \
  bash -c "cd '$TMP/cap' && '$ENGINE/scripts/kb-capture' --title 'login trouble' --from '$TMP/cap-secret.txt'"
case_run "kb-capture --from refusal prints SECRET?" 1 "SECRET?" -- \
  bash -c "cd '$TMP/cap' && '$ENGINE/scripts/kb-capture' --title 'login trouble' --from '$TMP/cap-secret.txt'"
case_run "refused capture leaves the tree byte-identical (no note, routers untouched)" 0 "" -- \
  bash -c "cd '$TMP' && cmp -s <(cd cap && find knowledge -type f -print0 | sort -z | xargs -0 sha256sum) cap.before"
case_run "refused capture leaves the --from file untouched, and says so" 1 "is untouched" -- \
  bash -c "cd '$TMP/cap' && '$ENGINE/scripts/kb-capture' --title 'login trouble' --from '$TMP/cap-secret.txt'; rc=\$?; cmp -s '$TMP/cap-secret.txt' '$TMP/cap-secret.orig' || exit 9; exit \$rc"

# stdin: the draft is kept, privately, outside the tree, and the printed path retries.
mkdir -p "$TMP/captmp"
out=$(cd "$TMP/cap" && TMPDIR="$TMP/captmp" "$ENGINE/scripts/kb-capture" --title 'login trouble' --from - < "$TMP/cap-secret.txt" 2>&1); rc=$?
draft=$(printf '%s\n' "$out" | sed -n 's/^  Your draft is saved, private (mode 0600), outside the tree: //p')
