#!/usr/bin/env bash
# run-checks — prove the guardrails still catch what they were written to catch.
#
# WHY: every check in scripts/ has been broken at least once, by its own author,
# and each time it was found by a person happening to look:
#
#   check-exec-bits matched `scripts/check-*` and missed two new scripts, which
#     were then "Permission denied" in every clone;
#   check-xlinks excluded episodic/ and called a live citation dead;
#   check-scope lost four spaces of indentation and silently checked only the
#     last library it was given;
#   check-golden counted a record that had drifted outside its code fence.
#
# Three of those passed CI. A guardrail nobody tests is a guardrail you hope
# about. Each case below breaks one thing on purpose and requires the check to
# notice — the negative control, applied to the checkers themselves.
#
# Fixtures are BUILT HERE, not committed: a tree full of deliberate defects
# sitting in the repo is something another check will eventually read and flag.
# Each one is a git repo where it must be, because check-scope tells a library
# from a project tree by whether it has its own .git.
#
# Usage: tests/run-checks [-v]
# Exit 0 when every case behaves as specified.
set -uo pipefail

ENGINE="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)"
VERBOSE=${1:-}
PASS=0; FAIL=0
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

fm() { # frontmatter: name, scope, [extra]
  printf -- '---\nname: %s\ndescription: a test fixture.\nmemory_type: reference\ndomain: fx\nscope: %s\n%smetadata:\n  type: topic\n  node_type: memory\n  created: 2026-09-22\ntags: [fx]\nkeywords: [fx]\n---\n' "$1" "$2" "${3:-}"
}

# A valid library: router, one fact, a conformant golden set. Every defect fixture
# below is this, with exactly one thing broken.
build_clean() {
  local d="$1" scope="${2:-general}"
  mkdir -p "$d"
  fm fx-index "$scope" $'freshness_horizon: 90d\nverifier_budget: 5\nsweep_interval: 30d\nlast_swept: never\n' > "$d/INDEX.md"
  printf '# fx\n\n- [widgets](widgets.md) — what widgets do\n' >> "$d/INDEX.md"
  fm widgets "$scope" > "$d/widgets.md"
  printf '# Widgets\n\n## Limits\n\nA widget holds up to 12 things.\n\nSource: manual\nVerified: 2026-09-22 · by: agent · method: manual\n' >> "$d/widgets.md"
  fm fx-golden "$scope" > "$d/fx-golden.md"
  cat >> "$d/fx-golden.md" <<'GOLDEN'
# fx golden set

Unresolved case: not applicable — no CONFLICTED section here.
Cross-root case: not applicable — this fixture links to no other library.

```yaml
- case: positive
  question: How many things does a widget hold?
  expected_file: widgets.md
  expected_excerpt: "up to 12 things"

- case: negative
  question: What is the deploy target?
  expected_file: ""
  expected_excerpt: "fact not found — check KB"

- case: negative
  question: Who owns the widget service?
  expected_file: ""
  expected_excerpt: "fact not found — check KB"
```
GOLDEN
  git init -q "$d" && git -C "$d" add -A 2>/dev/null
}

# case <name> <expected-exit> <expected-substring> -- <command...>
case_run() {
  local name="$1" want_exit="$2" want_text="$3"; shift 4
  local out rc
  out=$("$@" 2>&1); rc=$?
  # An empty want_text means the exit status is the whole claim — grep finds
  # nothing in empty output, so it cannot stand in for "no requirement".
  if [ "$rc" = "$want_exit" ] && { [ -z "$want_text" ] || printf '%s' "$out" | grep -qF -- "$want_text"; }; then
    PASS=$((PASS+1)); [ -n "$VERBOSE" ] && printf '  ok    %s\n' "$name"
  else
    FAIL=$((FAIL+1))
    printf '  FAIL  %s\n' "$name"
    printf '        wanted exit %s containing: %s\n' "$want_exit" "$want_text"
    printf '        got exit %s:\n' "$rc"
    printf '%s\n' "$out" | sed 's/^/          /' | head -6
  fi
}

echo "run-checks: $ENGINE"

# ---------------------------------------------------------------- check-kb ----
build_clean "$TMP/clean"
case_run "clean library passes check-kb" 0 "clean" -- "$ENGINE/scripts/check-kb" "$TMP/clean"

build_clean "$TMP/orphan"
fm stray general > "$TMP/orphan/stray.md"; printf '# Stray\n\nNothing routes here.\n' >> "$TMP/orphan/stray.md"
case_run "unrouted file is an orphan" 1 "orphan" -- "$ENGINE/scripts/check-kb" "$TMP/orphan"

build_clean "$TMP/subtree"
mkdir -p "$TMP/subtree/deep"
fm fx-sub general > "$TMP/subtree/deep/INDEX.md"; printf '# Deep\n\n- [buried](buried.md) — buried\n' >> "$TMP/subtree/deep/INDEX.md"
fm buried general > "$TMP/subtree/deep/buried.md"; printf '# Buried\n\nListed, but by an unrouted index.\n' >> "$TMP/subtree/deep/buried.md"
case_run "subtree under an unrouted sub-index is orphaned" 1 "deep/buried.md" -- "$ENGINE/scripts/check-kb" "$TMP/subtree"

build_clean "$TMP/badname"
sed -i 's/^name: widgets$/name: gadgets/' "$TMP/badname/widgets.md"
case_run "name that disagrees with filename" 1 "does not match filename" -- "$ENGINE/scripts/check-kb" "$TMP/badname"

build_clean "$TMP/deadlink"
printf '\nSee [[nowhere]].\n' >> "$TMP/deadlink/widgets.md"
case_run "dead [[slug]] link" 1 "dead" -- "$ENGINE/scripts/check-kb" "$TMP/deadlink"

build_clean "$TMP/collide"
mkdir -p "$TMP/collide/widgets"
fm inner general > "$TMP/collide/widgets/inner.md"; printf '# Inner\n\ntext\n' >> "$TMP/collide/widgets/inner.md"
printf -- '- [widgets-folder](widgets/inner.md) — inner\n' >> "$TMP/collide/INDEX.md"
case_run "file colliding with a folder name" 1 "collides with directory" -- "$ENGINE/scripts/check-kb" "$TMP/collide"

build_clean "$TMP/badfm"
sed -i 's/^domain: fx$/domain fx/' "$TMP/badfm/widgets.md"          # a key with no colon
case_run "malformed frontmatter is reported, not skipped" 1 "unparseable frontmatter" -- \
  "$ENGINE/scripts/check-kb" "$TMP/badfm"

# The toolchain runs in every commit hook on every machine, and on CI runners that
# install nothing. check-kb once imported PyYAML: it worked for its author and was
# a traceback everywhere else, including on the runner, which had never exercised
# it because the engine holds no knowledge for it to read.
case_run "no script depends on a third-party module" 1 "" -- \
  grep -rlE "^import (yaml|requests|jinja2)|^from (yaml|requests|jinja2) " "$ENGINE/scripts"

# ------------------------------------------------------------- check-scope ----
build_clean "$TMP/scopeok"
case_run "clean library passes check-scope" 0 "clean" -- "$ENGINE/scripts/check-scope" "$TMP/scopeok"

build_clean "$TMP/scopemix"
sed -i 's/^scope: general$/scope: product:acme/' "$TMP/scopemix/widgets.md"
case_run "file scope disagreeing with its library" 1 "disagrees with its library" -- "$ENGINE/scripts/check-scope" "$TMP/scopemix"

build_clean "$TMP/libwithrepo" "repo:fx"
case_run "library declaring a repo: tier" 1 "general-tier home" -- "$ENGINE/scripts/check-scope" "$TMP/libwithrepo"

# A project tree is one with no .git of its own, sitting inside a repository.
mkdir -p "$TMP/proj"; git init -q "$TMP/proj"
build_clean "$TMP/proj/knowledge" "general"; rm -rf "$TMP/proj/knowledge/.git"
case_run "project tree declaring a general tier" 1 "project tree" -- "$ENGINE/scripts/check-scope" "$TMP/proj/knowledge"

build_clean "$TMP/escape"
printf '\nSee [the engine](../../CONVENTIONS.md).\n' >> "$TMP/escape/widgets.md"
case_run "relative link climbing out of a library" 1 "climbs out" -- "$ENGINE/scripts/check-scope" "$TMP/escape"

# ------------------------------------------------------------ check-golden ----
build_clean "$TMP/goldok"
case_run "conformant golden set passes" 0 "clean" -- "$ENGINE/scripts/check-golden" "$TMP/goldok"

build_clean "$TMP/goldexcerpt"
sed -i 's/up to 12 things/up to 20 things/' "$TMP/goldexcerpt/fx-golden.md"
case_run "golden excerpt not in the file it names" 1 "excerpt not found" -- "$ENGINE/scripts/check-golden" "$TMP/goldexcerpt"

build_clean "$TMP/goldfile"
sed -i 's/expected_file: widgets.md/expected_file: nowhere.md/' "$TMP/goldfile/fx-golden.md"
case_run "golden record naming a missing file" 1 "does not exist" -- "$ENGINE/scripts/check-golden" "$TMP/goldfile"

build_clean "$TMP/goldneg"
python3 - "$TMP/goldneg/fx-golden.md" <<'PY'
import sys, pathlib, re
p = pathlib.Path(sys.argv[1]); t = p.read_text()
p.write_text(t[:t.index("- case: negative\n  question: Who owns")] + "```\n")
PY
case_run "golden set with fewer than two negatives" 1 "negative case" -- "$ENGINE/scripts/check-golden" "$TMP/goldneg"

# ----------------------------------------------------------- check-xlinks ----
mkdir -p "$TMP/kb"; build_clean "$TMP/kb/alpha"; build_clean "$TMP/kb/beta"
printf '\nSee [[beta:widgets]].\n' >> "$TMP/kb/alpha/widgets.md"
case_run "live cross-library link resolves" 0 "0 dead" -- "$ENGINE/scripts/check-xlinks" "$TMP/kb"

printf '\nAnd [[beta:no-such-thing]].\n' >> "$TMP/kb/alpha/widgets.md"
case_run "dead cross-library link fails" 1 "has no slug" -- "$ENGINE/scripts/check-xlinks" "$TMP/kb"

# episodic/ is a legitimate citation target: a session note is routed and citable.
# Excluding it from the slug index called a live citation dead — the bug that shipped.
mkdir -p "$TMP/kb/beta/episodic"
fm 2026-09-22-a-session-note general > "$TMP/kb/beta/episodic/2026-09-22-a-session-note.md"
printf '# A session note\n\nWhat happened.\n' >> "$TMP/kb/beta/episodic/2026-09-22-a-session-note.md"
fm episodic-index general > "$TMP/kb/beta/episodic/INDEX.md"
printf '# Episodic\n\n- [2026-09-22-a-session-note](2026-09-22-a-session-note.md) — a note\n' >> "$TMP/kb/beta/episodic/INDEX.md"
printf -- '- [episodic](episodic/INDEX.md) — session notes\n' >> "$TMP/kb/beta/INDEX.md"
build_clean "$TMP/kb/gammaless" >/dev/null 2>&1 || true
rm -rf "$TMP/kb/gammaless"
mkdir -p "$TMP/kb3"; build_clean "$TMP/kb3/alpha"; build_clean "$TMP/kb3/beta"
mkdir -p "$TMP/kb3/beta/episodic"
fm 2026-09-22-a-session-note general > "$TMP/kb3/beta/episodic/2026-09-22-a-session-note.md"
printf '# A session note\n\nWhat happened.\n' >> "$TMP/kb3/beta/episodic/2026-09-22-a-session-note.md"
fm episodic-index general > "$TMP/kb3/beta/episodic/INDEX.md"
printf '# Episodic\n\n- [2026-09-22-a-session-note](2026-09-22-a-session-note.md) — a note\n' >> "$TMP/kb3/beta/episodic/INDEX.md"
printf -- '- [episodic](episodic/INDEX.md) — session notes\n' >> "$TMP/kb3/beta/INDEX.md"
printf '\nSee [[beta:2026-09-22-a-session-note]].\n' >> "$TMP/kb3/alpha/widgets.md"
case_run "citation of another library's session note resolves" 0 "0 dead" -- "$ENGINE/scripts/check-xlinks" "$TMP/kb3"

mkdir -p "$TMP/kb2"; build_clean "$TMP/kb2/alpha"
printf '\nSee [[gamma:widgets]].\n' >> "$TMP/kb2/alpha/widgets.md"
case_run "link into an absent library only warns" 0 "unresolvable" -- "$ENGINE/scripts/check-xlinks" "$TMP/kb2"

# a project tree's links are resolved when it is passed as an extra tree
mkdir -p "$TMP/proj2"; git init -q "$TMP/proj2"
build_clean "$TMP/proj2/knowledge" "repo:proj2"; rm -rf "$TMP/proj2/knowledge/.git"
printf '\nSee [[beta:not-a-slug]].\n' >> "$TMP/proj2/knowledge/widgets.md"
case_run "project tree's cross-library link is checked" 1 "has no slug" -- \
  "$ENGINE/scripts/check-xlinks" "$TMP/kb" "$TMP/proj2/knowledge"

# ---------------------------------------- library pre-commit hook: xlinks ----
# check-xlinks is regression-tested above, but nothing had run it against real
# content at the point a link actually breaks: a library's own pre-commit hook
# never called it. These cases exercise the CANONICAL hook template embedded in
# kb-create-domain/SKILL.md — extracted from its fenced block, not retyped —
# so drift between the template and this test cannot hide a regression.

SKILL="$ENGINE/plugins/knowledge-tools/skills/kb-create-domain/SKILL.md"
TEMPLATE_HOOK="$TMP/template-pre-commit"
if ! python3 - "$SKILL" "$TEMPLATE_HOOK" <<'PY'
import re, sys
src_path, out_path = sys.argv[1], sys.argv[2]
src = open(src_path).read()
blocks = re.findall(r'```bash\n(.*?)```', src, re.S)
if len(blocks) != 1:
    sys.exit(f"expected exactly one ```bash fenced block in {src_path}, found {len(blocks)}")
body = blocks[0]
if not body.startswith("#!/usr/bin/env bash") or "find_engine" not in body:
    sys.exit(f"the ```bash block in {src_path} no longer looks like the pre-commit hook template")
open(out_path, "w").write(body)
PY
then
  echo "run-checks: FATAL — could not extract the pre-commit hook template from $SKILL" >&2
  exit 2
fi
chmod +x "$TEMPLATE_HOOK"

install_hook() { # install_hook <library-dir> -- stage the template as its hook
  mkdir -p "$1/.githooks"
  cp "$TEMPLATE_HOOK" "$1/.githooks/pre-commit"
  chmod +x "$1/.githooks/pre-commit"
  git -C "$1" add -A
  git -C "$1" update-index --chmod=+x .githooks/pre-commit
}

# A hermetic HOME: this machine's real ~/.gitconfig sets kb.engineRoot to the
# real engine, and KB_ENGINE_ROOT is commonly set in the shell too (kb-bootstrap
# sets both) — either would make find_engine resolve to the real engine
# instead of the fixture below. env -i plus a HOME with no .gitconfig is the
# same hermetic pattern kb-verify's own Recheck assertions use.
FAKEHOME="$TMP/fakehome"; mkdir -p "$FAKEHOME"

# Case A: two libraries live under one engine's kb/, exactly where the template
# expects. B cites a fact in A; A's own commit then renames that fact away,
# leaving A itself clean but B's citation dangling. A's hook must catch it.
XENGINE="$TMP/xhook/engine"; mkdir -p "$XENGINE/kb"
ln -s "$ENGINE/scripts" "$XENGINE/scripts"
build_clean "$XENGINE/kb/alpha"
fm gadgets general > "$XENGINE/kb/alpha/gadgets.md"
printf '# Gadgets\n\nA gadget is a small useful thing.\n' >> "$XENGINE/kb/alpha/gadgets.md"
printf -- '- [gadgets](gadgets.md) — what a gadget is\n' >> "$XENGINE/kb/alpha/INDEX.md"
git -C "$XENGINE/kb/alpha" add -A
build_clean "$XENGINE/kb/beta"
printf '\nSee [[alpha:gadgets]].\n' >> "$XENGINE/kb/beta/widgets.md"
git -C "$XENGINE/kb/beta" add -A
install_hook "$XENGINE/kb/alpha"

# Break the cited fact — A's commit removes gadgets.md and its route.
rm -f "$XENGINE/kb/alpha/gadgets.md"
sed -i '/gadgets.md) — what a gadget is/d' "$XENGINE/kb/alpha/INDEX.md"
git -C "$XENGINE/kb/alpha" add -A

case_run "library hook blocks a commit that breaks a sibling's citation" 1 "has no slug" -- \
  sh -c "cd '$XENGINE/kb/alpha' && env -i HOME='$FAKEHOME' PATH='$PATH' ./.githooks/pre-commit"

# Case B: the same library, cloned OUTSIDE any engine's kb/ (KB_ENGINE_ROOT set
# by hand, the documented escape hatch) — siblings are not visible, so the
# hook must skip the cross-library check and say so, without failing.
mkdir -p "$TMP/standalone"
build_clean "$TMP/standalone"
install_hook "$TMP/standalone"
case_run "library outside the engine's kb/ skips cross-library links, does not fail" 0 \
  "cross-library links not checked" -- \
  sh -c "cd '$TMP/standalone' && env -i HOME='$FAKEHOME' PATH='$PATH' KB_ENGINE_ROOT='$XENGINE' ./.githooks/pre-commit"

# Case C: re-confirm, through the hook this time rather than the bare script,
# that a link into a library that simply is not installed only warns.
mkdir -p "$TMP/xhook3/engine/kb"
ln -s "$ENGINE/scripts" "$TMP/xhook3/engine/scripts"
build_clean "$TMP/xhook3/engine/kb/solo"
printf '\nSee [[gamma:widgets]].\n' >> "$TMP/xhook3/engine/kb/solo/widgets.md"
git -C "$TMP/xhook3/engine/kb/solo" add -A
install_hook "$TMP/xhook3/engine/kb/solo"
case_run "library hook warns, but does not fail, on a link into an absent library" 0 "unresolvable" -- \
  sh -c "cd '$TMP/xhook3/engine/kb/solo' && env -i HOME='$FAKEHOME' PATH='$PATH' ./.githooks/pre-commit"

# -------------------------------------------------------- check-exec-bits ----
mkdir -p "$TMP/bits/.githooks"; git init -q "$TMP/bits"
printf '#!/usr/bin/env bash\ntrue\n' > "$TMP/bits/.githooks/pre-commit"
git -C "$TMP/bits" add -A >/dev/null 2>&1
git -C "$TMP/bits" update-index --chmod=-x .githooks/pre-commit 2>/dev/null
case_run "hook recorded non-executable" 1 "NOT EXECUTABLE" -- "$ENGINE/scripts/check-exec-bits" "$TMP/bits"

mkdir -p "$TMP/bits2/scripts"; git init -q "$TMP/bits2"
printf '#!/usr/bin/env python3\nprint(1)\n' > "$TMP/bits2/scripts/do-thing"
git -C "$TMP/bits2" add -A >/dev/null 2>&1
git -C "$TMP/bits2" update-index --chmod=-x scripts/do-thing 2>/dev/null
case_run "shebang script recorded non-executable, whatever its name" 1 "do-thing" -- \
  "$ENGINE/scripts/check-exec-bits" "$TMP/bits2"

# ------------------------------------------------------------- kb-verify ----
build_clean "$TMP/vpass"
printf 'Recheck: true\n' >> "$TMP/vpass/widgets.md"
case_run "passing assertion is reported, not applied" 0 "still hold" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vpass" --all --yes

build_clean "$TMP/vfail"
printf 'Recheck: false\n' >> "$TMP/vfail/widgets.md"
case_run "failing assertion exits 1" 1 "FAILED" -- "$ENGINE/scripts/kb-verify" "$TMP/vfail" --all --yes

build_clean "$TMP/vfail2"
printf 'Recheck: false\n' >> "$TMP/vfail2/widgets.md"
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: agent · method: manual/' "$TMP/vfail2/widgets.md"
"$ENGINE/scripts/kb-verify" "$TMP/vfail2" --all --yes --apply >/dev/null 2>&1
# the old date must survive --apply: a verifier that restamps what it just
# contradicted destroys the evidence that something changed.
case_run "a failing assertion's stamp is never rewritten" 0 "Verified: 2026-01-01" -- \
  grep -F "Verified:" "$TMP/vfail2/widgets.md"

build_clean "$TMP/vnone"
sed -i 's/^Verified: .*$/Verified: 2026-01-01 · by: agent · method: manual/' "$TMP/vnone/widgets.md"
case_run "stale section with no assertion is named, not skipped" 0 "no assertion" -- \
  "$ENGINE/scripts/kb-verify" "$TMP/vnone" --all

# ---------------------------------------------------------------- kb-due ----
build_clean "$TMP/due"
sed -i 's/^last_swept: never$/last_swept: 2026-09-21/' "$TMP/due/INDEX.md"
case_run "recently swept tree is not due" 0 "0 of 1" -- "$ENGINE/scripts/kb-due" /nonexistent "$TMP/due"

build_clean "$TMP/overdue"
sed -i 's/^last_swept: never$/last_swept: 2026-01-01/' "$TMP/overdue/INDEX.md"
case_run "long-unswept tree is due" 0 "1 of 1" -- "$ENGINE/scripts/kb-due" /nonexistent "$TMP/overdue"

# --------------------------------------------------------- check-secrets ----
# The check with the most expensive failure, and until now the only one with no
# case here. The fixture's credential is ASSEMBLED at run time: written literally,
# it would sit in this file and trip check-secrets over the engine itself.
mkdir -p "$TMP/sec"; git init -q "$TMP/sec"
printf 'key = "%s%s"\n' "AKIA" "ABCDEFGHIJKLMNOP" > "$TMP/sec/config.txt"
git -C "$TMP/sec" add -A >/dev/null 2>&1
case_run "staged credential is caught" 1 "" -- \
  sh -c "cd '$TMP/sec' && '$ENGINE/scripts/check-secrets'"

mkdir -p "$TMP/sec2"; git init -q "$TMP/sec2"
printf 'key = "not-a-credential"\n' > "$TMP/sec2/config.txt"
git -C "$TMP/sec2" add -A >/dev/null 2>&1
case_run "ordinary staged text is not a credential" 0 "clean" -- \
  sh -c "cd '$TMP/sec2' && '$ENGINE/scripts/check-secrets'"

# A credential removed in a later commit is still in history — the fact
# secret-governance.md states, and the reason --all walks every blob.
git -C "$TMP/sec" -c user.email=t@t -c user.name=t commit -qm add >/dev/null 2>&1
rm "$TMP/sec/config.txt"; git -C "$TMP/sec" add -A >/dev/null 2>&1
git -C "$TMP/sec" -c user.email=t@t -c user.name=t commit -qm remove >/dev/null 2>&1
case_run "credential deleted but still in history is caught by --all" 1 "" -- \
  sh -c "cd '$TMP/sec' && '$ENGINE/scripts/check-secrets' --all"

# ---------------------------------------------------------- check-stamps ----
# An agent commits under the human's git identity, so identity proves nothing.
# What is observable: a commit that announces agent co-authorship AND stamps a
# fact as human-verified, which buys ten times the TTL (CONVENTIONS §7).
mkdir -p "$TMP/stamp"; git init -q "$TMP/stamp"
fm claim general > "$TMP/stamp/claim.md"
printf '# Claim\n\n## A\n\nx\n\nSource: manual\nVerified: 2026-01-01 · by: agent · method: manual\n' >> "$TMP/stamp/claim.md"
git -C "$TMP/stamp" add -A; git -C "$TMP/stamp" -c user.email=t@t -c user.name=t commit -qm seed >/dev/null 2>&1
sed -i 's/by: agent/by: human/' "$TMP/stamp/claim.md"; git -C "$TMP/stamp" add -A
git -C "$TMP/stamp" -c user.email=t@t -c user.name=t commit -qm "restamp

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>" >/dev/null 2>&1
case_run "agent-authored commit claiming human verification" 1 "by: human" -- \
  sh -c "cd '$TMP/stamp' && '$ENGINE/scripts/check-stamps' HEAD~1..HEAD"

sed -i 's/by: human/by: agent/' "$TMP/stamp/claim.md"; git -C "$TMP/stamp" add -A
git -C "$TMP/stamp" -c user.email=t@t -c user.name=t commit -qm undo >/dev/null 2>&1
sed -i 's/by: agent/by: human/' "$TMP/stamp/claim.md"; git -C "$TMP/stamp" add -A
git -C "$TMP/stamp" -c user.email=t@t -c user.name=t commit -qm "a person checked it" >/dev/null 2>&1
case_run "human stamp without an agent trailer is allowed" 0 "clean" -- \
  sh -c "cd '$TMP/stamp' && '$ENGINE/scripts/check-stamps' HEAD~1..HEAD"

# ------------------------------------------------------------- kb-owner ----
# GitHub resolves ownership by the LAST matching pattern, not the most specific.
# A sweep that parses CODEOWNERS by eye gets this backwards and files findings
# against the wrong person.
mkdir -p "$TMP/own/.github"
printf '*  @alice\n/scripts/  @bob\n' > "$TMP/own/.github/CODEOWNERS"
case_run "last matching pattern wins" 0 "@bob" -- "$ENGINE/scripts/kb-owner" "$TMP/own" scripts/x.sh
case_run "an earlier broad pattern still owns what no later one matches" 0 "@alice" -- \
  "$ENGINE/scripts/kb-owner" "$TMP/own" README.md

printf '/scripts/  @bob\n*  @alice\n' > "$TMP/own/.github/CODEOWNERS"
case_run "reversing the order reverses the answer" 0 "@alice" -- \
  "$ENGINE/scripts/kb-owner" "$TMP/own" scripts/x.sh

mkdir -p "$TMP/own2"
case_run "no CODEOWNERS resolves to unassigned, never a guess" 0 "unassigned" -- \
  "$ENGINE/scripts/kb-owner" "$TMP/own2" anything.md

# -------------------------------------------------------------- grade-eval ----
# A retrieval agent cites a file by whatever path it walked to reach it — library-
# relative, library-prefixed or kb-rooted. The grader must resolve that path, not
# string-match it: the first intelligence-analysis run failed five correct citations
# on the prefix alone. Resolving must not become suffix-matching, though — a file of
# the same name in ANOTHER library is a wrong citation and has to stay one.
build_clean "$TMP/ge/kb/fx"
build_clean "$TMP/ge/kb/other"
grade() { # grade <name> <want-exit> <want-text> <Q1 record>
  printf '%s\nQ2||fact not found — check KB\nQ3||fact not found — check KB\n' "$4" > "$TMP/ge/answers"
  case_run "$1" "$2" "$3" -- "$ENGINE/scripts/grade-eval" "$TMP/ge/kb/fx" "$TMP/ge/answers"
}
grade "grounded answer, library-relative citation, passes" 0 "3/3 passed" \
  "Q1|widgets.md|A widget holds up to 12 things."
grade "library-prefixed citation resolves to the same file" 0 "3/3 passed" \
  "Q1|fx/widgets.md|A widget holds up to 12 things."
grade "kb-rooted citation resolves to the same file" 0 "3/3 passed" \
  "Q1|kb/fx/widgets.md|A widget holds up to 12 things."
grade "same-named file in another library is a wrong citation" 1 "expected 'widgets.md'" \
  "Q1|other/widgets.md|A widget holds up to 12 things."
grade "paraphrase of the excerpt is not grounded" 1 "excerpt not in answer" \
  "Q1|widgets.md|Widgets take a dozen items at most."

# ------------------------------------------------------------------- done ----
echo
if [ "$FAIL" -eq 0 ]; then
  echo "run-checks: $PASS case(s), all as specified"
  exit 0
fi
echo "run-checks: $FAIL of $((PASS+FAIL)) case(s) FAILED"
echo "A guardrail that no longer catches what it was written to catch is worse than none:"
echo "it reports clean over the defect it was built for."
exit 1
