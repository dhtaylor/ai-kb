# The identifier lines are split in two so this file does not trip the rule it tests.
IDENTS="$(printf '%s\n' 'USE [AcmeErp2019''SalesHistoryArchive]' \
  'EXEC dbo.usp_GetOrderLines''2019ByCustomerId @CustomerId' \
  'SELECT oh.OrderHeaderId2, ol.LineItem''Qty2019Adj FROM x')"
