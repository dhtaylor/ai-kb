# ------------------------------------------------- schedulable commands (#95) ----
# A command a person may run unattended (cron, a systemd timer, kb-schedule) must work from `/`
# with a stripped environment, tell clean (0) from findings (1) from a tool error (2), and never
# print a fact's or source's content into a log. An assertion's command text is not content: it is
# the check's own definition, and the queue records it. Every fixture below carries the canary
# SCHED-CANARY in the text a careless command would echo; finding it in output is a leak.
sched() { # sched <cmd...>: run from / with a stripped environment; prints exit=N, or LEAKED
  local out rc
  out=$(cd / && env -i HOME="$HOME" PATH=/usr/bin:/bin "$@" 2>&1); rc=$?
  if printf '%s' "$out" | grep -q 'SCHED-CANARY'; then
    printf 'LEAKED: %s\n' "$(printf '%s' "$out" | grep -m1 'SCHED-CANARY')"; return 99
  fi
  printf 'exit=%s\n' "$rc"; return "$rc"
}

