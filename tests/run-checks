case_run "KB_TODAY: ...and in kb-due, which does not fall back to the real date" 2 "KB_TODAY" -- env KB_TODAY=tomorrow "$ENGINE/scripts/kb-due" "$CK/clocklib"
case_run "KB_TODAY: ...and in kb-verify" 2 "KB_TODAY" -- env KB_TODAY=tomorrow "$ENGINE/scripts/kb-verify" "$CK/clocklib" --yes
cap_tree "$CK/cap"
case_run "KB_TODAY: kb-capture dates the note it files" 0 "" -- \
  bash -c 'cd "$1" && echo "Saw a thing." | KB_TODAY=2026-03-04 "$2/scripts/kb-capture" --title "clocked" --from - >/dev/null 2>&1; ls "$1"/knowledge/episodic/2026-03-04-* >/dev/null' _ "$CK/cap" "$ENGINE"
mkdir -p "$CK/init"; git init -q "$CK/init"
case_run "KB_TODAY: kb-init dates the router it scaffolds" 0 "" -- \
  bash -c 'KB_TODAY=2026-03-04 "$1/scripts/kb-init" "$2" >/dev/null 2>&1; grep -q "created: 2026-03-04" "$2/knowledge/INDEX.md"' _ "$ENGINE" "$CK/init"

# ------------------- the bash one-liners agree with kbengine.env about where things are (ADR-0021) ----
# kb-session-start and kb-bootstrap are bash and cannot import kbengine.env, so each repeats a path in
# one line. Python resolves the same path in one place; these cases fail the day the two differ, with
# or without the overrides and with XDG_* set to somewhere else, which neither may follow.
SY="$TMP/sync"; mkdir -p "$SY/home" "$SY/cwd"
git config --file "$SY/home/.config/ai-kb/libraries" kb.migrated true 2>/dev/null || { mkdir -p "$SY/home/.config/ai-kb"; git config --file "$SY/home/.config/ai-kb/libraries" kb.migrated true; }
sy_py() { # sy_py <env --path name> [VAR=value ...]: what kbengine.env resolves, under the test's HOME
  local n="$1"; shift
  env -i HOME="$SY/home" PATH="$PATH" PYTHONPATH="$ENGINE/scripts" XDG_STATE_HOME="$SY/xdg" XDG_CONFIG_HOME="$SY/xdg" ${@+"$@"} python3 -m kbengine.env --path "$n"
}
sy_expr() { # sy_expr <script> <ERE> [VAR=value ...]: the first quoted expression in the script matching ERE, as bash resolves it
  local s="$1" re="$2"; shift 2
  env -i HOME="$SY/home" PATH="$PATH" XDG_STATE_HOME="$SY/xdg" XDG_CONFIG_HOME="$SY/xdg" ${@+"$@"} \
    bash -c 'tok=$(grep -oE -m1 "$2" "$1" | head -1); [ -n "$tok" ] || exit 1; eval "printf %s $tok"' _ "$s" "$re"
}
sy_agree() { # sy_agree <what> <bash value> <python value>
  [ -n "$2" ] && [ "$2" = "$3" ] && echo "agree: $1" || { echo "DIVERGE $1: bash says '$2', kbengine.env says '$3'"; return 1; }
}
SY_REPORTS='"\$\{KB_REPORTS:-[^}]*\}"'; SY_REGISTRY='"\$HOME/\.config/ai-kb/libraries"'; SY_BACKUPS='"\$HOME/\.local/state/ai-kb/backups"'
case_run "sync: kb-session-start's registry is kbengine.env's" 0 "agree" -- \
  sy_agree registry "$(sy_expr "$ENGINE/scripts/kb-session-start" "$SY_REGISTRY")" "$(sy_py registry)"
case_run "sync: kb-bootstrap's registry is kbengine.env's" 0 "agree" -- \
  sy_agree registry "$(sy_expr "$ENGINE/scripts/kb-bootstrap" "$SY_REGISTRY")" "$(sy_py registry)"
case_run "sync: kb-bootstrap's backup folder is under kbengine.env's state folder" 0 "agree" -- \
  sy_agree backups "$(sy_expr "$ENGINE/scripts/kb-bootstrap" "$SY_BACKUPS")" "$(sy_py state)/backups"
case_run "sync: kb-session-start's reports folder is kbengine.env's, by default" 0 "agree" -- \
  sy_agree reports "$(sy_expr "$ENGINE/scripts/kb-session-start" "$SY_REPORTS")" "$(sy_py reports)"
case_run "sync: ...and with KB_REPORTS set" 0 "agree" -- \
  sy_agree reports "$(sy_expr "$ENGINE/scripts/kb-session-start" "$SY_REPORTS" KB_REPORTS="$SY/mine")" "$(sy_py reports KB_REPORTS="$SY/mine")"
# And the running hook finds the report where kb-report writes it, the same two ways.
sy_latest() { # sy_latest [VAR=value ...]: the "Latest kb-report" path session start names
  (cd "$SY/cwd" && env -i HOME="$SY/home" PATH="$PATH" KB_NUDGE=weekly:mon KB_TODAY=2026-11-10 KB_ENGINE_ROOT="$ENGINE" XDG_STATE_HOME="$SY/xdg" ${@+"$@"} "$ENGINE/scripts/kb-session-start") |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' | sed -n 's/.*Latest kb-report: //p'
}
mkdir -p "$(sy_py reports)" "$SY/mine"; touch "$(sy_py reports)/2026-W45.md" "$SY/mine/2026-W45.md"
case_run "sync: session start names the report in kbengine.env's reports folder" 0 "agree" -- \
  sy_agree latest "$(sy_latest)" "$(sy_py reports)/2026-W45.md"
case_run "sync: ...and in KB_REPORTS when it is set" 0 "agree" -- \
  sy_agree latest "$(sy_latest KB_REPORTS="$SY/mine")" "$SY/mine/2026-W45.md"

# ------------------------------------------- a home directory managed by Stow or similar (#138) ----
# A dotfiles manager links files, or whole folders, from a repository synced across machines. Every
# engine write goes through the link, so this machine's paths land in that repository. The engine
# says so, and keeps its backups out of the linked folder.
LH="$TMP/linkhome"; LD="$TMP/linkdot"; mkdir -p "$LH" "$LD/claude" "$LD/config"
printf '[user]\n\tname = x\n' > "$LD/gitconfig"; printf '# rc\n' > "$LD/bashrc"; printf '{}\n' > "$LD/claude/settings.json"
ln -s "$LD/gitconfig" "$LH/.gitconfig"; ln -s "$LD/bashrc" "$LH/.bashrc"
ln -s "$LD/claude" "$LH/.claude"; ln -s "$LD/config" "$LH/.config"
mkdir -p "$LD/config/ai-kb"; printf '[kb]\n\tmigrated = true\n' > "$LD/config/ai-kb/libraries"
lboot() { env -i HOME="$LH" SHELL=/bin/bash PATH="$PATH" "$BFX/scripts/kb-bootstrap" "$@"; }
case_run "linked home: --check names a linked ~/.gitconfig and its real file" 1 "is a link to $LD/gitconfig" -- lboot --check
case_run "linked home: --check names settings.json under a linked ~/.claude" 1 "is a link to $LD/claude/settings.json" -- lboot --check
case_run "linked home: --check names a linked shell rc" 1 "is a link to $LD/bashrc" -- lboot --check
lboot --apply >/dev/null 2>&1
case_run "linked home: --apply leaves no settings backup in the linked folder" 0 "" -- \
  bash -c '! ls "$1"/settings.json.bak-kb-* >/dev/null 2>&1' _ "$LD/claude"
case_run "linked home: --apply keeps the settings backup in the state folder" 0 "" -- \
  bash -c 'ls "$1"/settings.json.bak-kb-* >/dev/null 2>&1' _ "$LH/.local/state/ai-kb/backups"
case_run "linked home: --apply keeps the rc backup in the state folder, not beside the rc" 0 "" -- \
  bash -c '! ls "$1"/.bashrc.bak-kb-* >/dev/null 2>&1 && ls "$2"/.bashrc.bak-kb-* >/dev/null 2>&1' _ "$LH" "$LH/.local/state/ai-kb/backups"
case_run "linked home: --apply still writes through every link" 0 "" -- \
  bash -c '[ -L "$1/.gitconfig" ] && [ -L "$1/.bashrc" ] && [ -L "$1/.claude" ] && grep -q engineRoot "$2/gitconfig"' _ "$LH" "$LD"
case_run "plain home: no link is reported" 0 "Everything is configured." -- \
  bash -c 'out=$(env -i HOME="$1" PATH="$PATH" "$2" --check 2>&1); printf "%s" "$out" | grep -q "is a link" && exit 1; printf "%s" "$out"' _ "$BHOME" "$BFX/scripts/kb-bootstrap"
mkdir -p "$TMP/realhome"; ln -s "$TMP/realhome" "$TMP/homelink"
case_run "a HOME that is itself a link is not reported" 1 "would-set" -- \
  bash -c 'out=$(env -i HOME="$1" PATH="$PATH" "$2" --check 2>&1); printf "%s" "$out" | grep -q "is a link" && exit 3; printf "%s" "$out"; exit 1' _ "$TMP/homelink" "$BFX/scripts/kb-bootstrap"
build_clean "$TMP/linklib"
case_run "linked home: kb-library add names a registry under a linked ~/.config" 0 "is a link to $LD/config/ai-kb/libraries" -- \
  env HOME="$LH" "$ENGINE/scripts/kb-library" add "$TMP/linklib"
case_run "linked home: kb-schedule install names its units under a linked ~/.config" 0 "is a link to $LD/config/systemd/user/ai-kb-schedule.timer" -- \
  env HOME="$LH" KS_LOG="$KS/log" KS_CRON="$KS/cron" KB_SYSTEMCTL="$KS/bin/systemctl" KB_CRONTAB="$KS/bin/crontab" "$ENGINE/scripts/kb-schedule" install --backend systemd
env HOME="$LH" KS_LOG="$KS/log" KS_CRON="$KS/cron" KB_SYSTEMCTL="$KS/bin/systemctl" KB_CRONTAB="$KS/bin/crontab" "$ENGINE/scripts/kb-schedule" remove >/dev/null 2>&1
case_run "kb-libraries --linked: a plain path prints nothing" 0 "" -- \
  bash -c 'o=$("$1" --linked "$2/.gitconfig") && [ -z "$o" ]' _ "$ENGINE/scripts/kb-libraries" "$BHOME"

# The contract's header names the newest version §14 defines. It said 2.3 through three releases
# of §14 (2.4 to 2.6), and a reader takes the header as the contract's version.
contract_header() {
  local head newest
  head=$(sed -n 's/^\*\*Contract version \([0-9][0-9]*\.[0-9][0-9]*\)\*\*.*/\1/p' "$ENGINE/CONVENTIONS.md" | head -1)
  newest=$(awk '/^## [0-9]+\. Contract versions/{p=1;next} /^## /{p=0} p && /^### [0-9]+\.[0-9]+ *$/{print $2}' "$ENGINE/CONVENTIONS.md" | sort -t. -k1,1n -k2,2n | tail -1)
  [ -n "$head" ] && [ "$head" = "$newest" ] && echo "header $head matches §14" || { echo "header says ${head:-nothing}, §14's newest is $newest"; return 1; }
}
case_run "CONVENTIONS: the header names the newest contract version in §14" 0 "matches §14" -- contract_header

# kb-init writes the contract version a new library declares, as a literal in a heredoc. Publishing a
# version means raising it by hand, so a version published without it would scaffold libraries that
# are born behind (#203). The second case is the negative control: a stale literal is caught.
init_contract() { # init_contract <kb-init> <CONVENTIONS.md>
  local init newest
  init=$(sed -n 's/^kb_contract: "\([0-9][0-9]*\.[0-9][0-9]*\)"$/\1/p' "$1" | head -1)
  newest=$(awk '/^## [0-9]+\. Contract versions/{p=1;next} /^## /{p=0} p && /^### [0-9]+\.[0-9]+ *$/{print $2}' "$2" | sort -t. -k1,1n -k2,2n | tail -1)
  [ -n "$init" ] && [ "$init" = "$newest" ] && echo "kb-init writes $init, the newest in §14" || { echo "kb-init writes ${init:-nothing}, §14's newest is $newest"; return 1; }
}
case_run "kb-init: the contract version it writes is the newest in §14" 0 "the newest in §14" -- \
  init_contract "$ENGINE/scripts/kb-init" "$ENGINE/CONVENTIONS.md"
sed 's/^kb_contract: "[0-9.]*"$/kb_contract: "2.0"/' "$ENGINE/scripts/kb-init" > "$TMP/kb-init-stale"
case_run "kb-init: a stale contract version is caught" 1 "writes 2.0" -- init_contract "$TMP/kb-init-stale" "$ENGINE/CONVENTIONS.md"

# ------------------------------------------- real-clock canaries: the frozen clock unset (#205) ----
# The suite runs on KB_TODAY. These run with it unset, so the engine reads the real calendar, to
# catch a script that only works when it is told the day (or that ignores the real one).
RCL="$TMP/realclock"; build_clean "$RCL/lib" --swept "$(date +%F)" --stamp "$(date +%F)"
case_run "real clock: a library stamped and swept today is not due" 0 "" -- \
  bash -c '[ -z "$(env -u KB_TODAY HOME="$3" KB_PACKETS="$3/packets" "$1" "$2" --nudge)" ]' _ "$ENGINE/scripts/kb-due" "$RCL/lib" "$RCL/home"
case_run "real clock: ...and check-kb finds no stamp dated in the future" 0 "clean" -- \
  env -u KB_TODAY "$ENGINE/scripts/check-kb" "$RCL/lib"
case_run "real clock: kb-report names its file for the real ISO week, whatever KB_TODAY says" 0 "" -- \
  bash -c 'env -u KB_TODAY HOME="$1" "$2" "$3" --out "$4" >/dev/null 2>&1; test -f "$4/$(date +%G-W%V).md"' _ "$TLH" "$ENGINE/scripts/kb-report" "$RCL/lib" "$RCL/reports"

if [ "$FAIL" -eq 0 ]; then
  echo "run-checks: $PASS case(s), all as specified"
  exit 0
fi
echo "run-checks: $FAIL of $((PASS+FAIL)) case(s) FAILED"
echo "A guardrail that no longer catches what it was written to catch is worse than none:"
echo "it reports clean over the defect it was built for."
exit 1
