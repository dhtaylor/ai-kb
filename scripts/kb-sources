#!/usr/bin/env python3
"""kb-sources — do the external URLs the facts cite still resolve? Reports and queues; never edits.

`check-links` proves internal `[[slug]]`s. Nothing proved that the web pages a source stub
points at still exist — and a fact whose only evidence has vanished reads exactly like one
whose evidence is intact. This asks the question (CONVENTIONS §6, "provenance rots").

Where URLs live: a library's source stubs (`sources/*.md`) carry the URL on a labelled line —
`- **URL:** …`, `- **URL (as stated by the immediate source):** …`, or
`- **Artifact location:** …` — and fact sections cite the stub with `Source: [[stub-slug]]`.
Those are the only three forms in use, so they are the only three read. The *dependants* of a
URL are the fact sections whose `Source:` citation (the line and any lines it wraps onto)
names that stub.

THREE RULES, and they are the design:

  1. NOTHING IS FETCHED WITHOUT --yes. Without it the tool lists every URL, its stub and its
     dependants, says nothing was fetched, and exits 0; the network module is not even
     imported. A library is content that travels between people, so the URLs in it are
     someone else's choice of where your machine connects (the same trust question as
     kb-verify's printed commands). Approval is per run, by the person running it.
  2. DETECTION ONLY. A dead URL never edits a fact, never edits a stub, and never marks a
     section `provenance: BROKEN`. Whether the source is gone, moved, or merely down is a
     judgement, and a tool that stamped BROKEN on a transient 503 would manufacture the
     very distrust it exists to detect (ADR-0005: detection is automatic, mutation is gated).
  3. A HUMAN TRIAGES. Findings go to the owning library's `needs-attention.md`, and a URL
     that later comes back alive does not resolve its entry — nothing but a person does.

CLASSIFICATION (one HEAD per unique URL; GET if HEAD answers any HTTP error but 429, and
GET's answer decides, since some servers mishandle HEAD (issue #74); redirects followed;
10s timeout; User-Agent names the tool):

    alive         2xx after redirects. A redirect to a different final URL is printed as a
                  note: the source moved, and the stub may want a new address. Not a failure.
    dead          404 or 410 on GET — the server says the source is gone.
                  category: source-dead
    unreachable   DNS failure, timeout, refused connection, TLS error, 5xx, 403, 429, any
                  other status. We could not decide, and "unreachable" is never conflated
                  with "dead" or with "unchanged" (§6).
                  category: source-unreachable

THE QUEUE reuses kb-watch's primitives exactly as kb-verify does (imported from
`scripts/kb-watch`, not re-specified): `new_queue_file`, `yaml_scalar` (the URL and error
text are untrusted), `existing_ids`, `ensure_routed`. One record per dead or unreachable
stub URL, in the library that owns the stub:

    id          8 hex chars of sha1(f"{category}|{stub}|{url}") — a rerun reproduces it and
                does not duplicate; a URL that changes class (unreachable, then dead) is a
                new finding and is added
    stub, url, detail (status or error), dependants (count, then `file § section` list), date

Usage: kb-sources <library-or-tree> [--yes]
  <library-or-tree>  a library root (has INDEX.md), or a directory of libraries (kb/)
  --yes              approve this run's network access: fetch each unique URL once
Exit 0 when every URL is alive (or nothing was fetched), 1 when any was dead or unreachable,
2 on usage error.
"""
import hashlib, importlib.machinery, importlib.util, os, pathlib, re, sys

UA = "kb-sources/1 (knowledge-base liveness check; HEAD only unless refused)"
TIMEOUT = 10
NON_KB = {"documents", "plugins", "scripts", ".github", ".githooks",
          ".claude-plugin", ".claude", ".git", "episodic"}
URL_LINE = re.compile(r"^\s*-\s*\*\*(?:URL[^:*]*|Artifact location):\*\*\s*(https?://[^\s<>`]+)")
HEADING = re.compile(r"^#{1,6}\s+(.*)$")
SOURCE_LINE = re.compile(r"^Source:")
STOP = re.compile(r"^(Source:|Verified:|Recheck:|#{1,6}\s)")
LINK = re.compile(r"\[\[([^\]|#]+)")
TODAY = __import__("datetime").date.today().isoformat()


def load_kb_watch():
    """Import scripts/kb-watch byte-identical (no .py suffix, so an explicit loader), without
    writing bytecode next to it — the queue template, escaping and dedupe live in one place."""
    path = pathlib.Path(__file__).resolve().parent / "kb-watch"
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("kb_watch", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def markdown_files(root):
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in NON_KB]
        out += [pathlib.Path(dirpath) / n for n in filenames
                if n.endswith(".md") and not n.endswith("-golden.md")
                and n not in ("INDEX.md", "needs-attention.md")]
    return sorted(out)


def stub_urls(lib):
    """{stub_slug: (relative path, url)} from labelled URL lines in the library's sources/ dirs."""
    out = {}
    for f in markdown_files(lib):
        if "sources" not in f.relative_to(lib).parts[:-1]:
            continue
        for line in f.read_text(errors="replace").split("\n"):
            m = URL_LINE.match(line)
            if m:
                # A ')' is prose wrapping the URL only when it has no '(' to close inside
                # it: ms188676(v=sql.105) and Foo_(bar) end in their own ')'.
                url = m.group(1).rstrip(".,;:")
                while url.endswith(")") and url.count(")") > url.count("("):
                    url = url[:-1].rstrip(".,;:")
                out[f.stem] = (str(f.relative_to(lib)), url)
                break
    return out


def dependants(lib, slugs):
    """{slug: ["file § section", ...]} — fact sections whose Source: citation names the stub."""
    deps = {s: [] for s in slugs}
    for f in markdown_files(lib):
        if "sources" in f.relative_to(lib).parts[:-1]:
            continue
        heading, lines, i = "(file)", f.read_text(errors="replace").split("\n"), 0
        rel = str(f.relative_to(lib))
        while i < len(lines):
            m = HEADING.match(lines[i])
            if m:
                heading = m.group(1).strip()
            if SOURCE_LINE.match(lines[i]):
                j, cite = i, lines[i]
                while j + 1 < len(lines) and lines[j + 1].strip() and not STOP.match(lines[j + 1]):
                    j += 1; cite += "\n" + lines[j]
                for slug in set(LINK.findall(cite)):
                    entry = f"{rel} § {heading}"
                    if slug in deps and entry not in deps[slug]:
                        deps[slug].append(entry)
                i = j
            i += 1
    return deps


def libraries(root):
    if (root / "INDEX.md").is_file():
        return [root]
    return sorted(d for d in root.iterdir() if d.is_dir() and (d / "INDEX.md").is_file()) if root.is_dir() else []


def fetch(url):
    """(class, detail, final_url). The network module is imported here and nowhere else, so a
    run without --yes cannot reach it."""
    import urllib.request, urllib.error
    def attempt(method):
        req = urllib.request.Request(url, method=method, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            return r.status, r.geturl()
    try:
        try:
            code, final = attempt("HEAD")
        except urllib.error.HTTPError as e:
            if e.code == 429:       # asked to back off: a second request would be rude
                raise
            code, final = attempt("GET")
    except urllib.error.HTTPError as e:
        code, final = e.code, url
        if code in (404, 410):
            return "dead", f"HTTP {code}", url
        return "unreachable", f"HTTP {code}", url
    except Exception as e:          # DNS, timeout, refused, TLS, redirect loop: undecided, not dead
        reason = getattr(e, "reason", e)
        return "unreachable", f"{type(reason).__name__}: {reason}", url
    if 200 <= code < 300:
        return "alive", f"HTTP {code}", final
    return "unreachable", f"HTTP {code}", final


def render_record(rec, kb_watch):
    lines = [f"- id: {rec['id']}"]
    for key in ("category", "status", "stub"):
        lines.append(f"  {key}: {kb_watch.yaml_scalar(rec[key], untrusted=False)}")
    for key in ("url", "detail", "dependants"):
        lines.append(f"  {key}: {kb_watch.yaml_scalar(rec[key], untrusted=True)}")
    lines.append(f"  date: {kb_watch.yaml_scalar(rec['date'], untrusted=False)}")
    return "\n".join(lines) + "\n\n"


def append_records(queue_path, records, kb_watch):
    """kb-verify's file-level behaviour: create from kb-watch's template and route it from the
    INDEX, or splice into the last ```yaml fence."""
    body = "".join(render_record(r, kb_watch) for r in records)
    if not queue_path.is_file():
        domain, scope, err = kb_watch.library_domain_scope(queue_path.parent)
        if err:
            return err
        queue_path.write_text(
            kb_watch.new_queue_file(domain, scope)[:-len(kb_watch.FENCE_CLOSE)] + body + kb_watch.FENCE_CLOSE)
        return kb_watch.ensure_routed(queue_path.parent)
    text = queue_path.read_text(errors="replace")
    spans = list(re.finditer(r"```yaml\n(?:.*?\n)?```\n", text, re.S))
    if spans:
        at = spans[-1].end() - len(kb_watch.FENCE_CLOSE)
        text = text[:at] + body + text[at:]
    else:
        text = text.rstrip("\n") + "\n\n" + kb_watch.FENCE_OPEN + body + kb_watch.FENCE_CLOSE
    queue_path.write_text(text)
    return None


def stable_id(category, stub, url):
    return hashlib.sha1(f"{category}|{stub}|{url}".encode()).hexdigest()[:8]


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    flags = {a for a in argv if a.startswith("--")}
    if len(args) != 1 or flags - {"--yes"}:
        print(__doc__.strip().split("\n\n")[-1], file=sys.stderr); return 2
    root = pathlib.Path(args[0])
    libs = libraries(root)
    if not libs:
        print(f"kb-sources: {root} is neither a library (no INDEX.md) nor a directory of libraries",
              file=sys.stderr); return 2

    found = []                       # (lib, slug, stub_rel, url, [dependants])
    for lib in libs:
        stubs = stub_urls(lib)
        deps = dependants(lib, stubs)
        found += [(lib, slug, rel, url, deps[slug]) for slug, (rel, url) in sorted(stubs.items())]
    urls = sorted({f[3] for f in found})

    print(f"kb-sources: {root}  ({len(libs)} librar{'y' if len(libs) == 1 else 'ies'}, "
          f"{len(found)} stub URL(s), {len(urls)} unique)")
    for lib, slug, rel, url, deps in found:
        print(f"\n  {url}\n    stub: {lib.name}/{rel}")
        print("    dependants: " + ("; ".join(deps) if deps else "(no fact section cites this stub directly)"))
    if not found:
        print("\nNo external URLs found.")
        return 0
    if "--yes" not in flags:
        print(f"\nNo network access was requested, so nothing was fetched. Approving this run would "
              f"send one HEAD request (and a GET if HEAD fails) to each of the {len(urls)} URL(s) above, from "
              f"this machine.\nRead the list. To approve: kb-sources {args[0]} --yes")
        return 0

    results = {u: fetch(u) for u in urls}
    print()
    for u in urls:
        cls, detail, final = results[u]
        print(f"  {cls.upper():<11} {detail}  {u}")
        if cls == "alive" and final != u:
            print(f"    note: redirected to {final} — the stub may want the new address")

    kb_watch = load_kb_watch()
    bad, queued, dupes = 0, 0, 0
    for lib in libs:
        queue_path, records = lib / "needs-attention.md", []
        seen = kb_watch.existing_ids(queue_path)
        for l, slug, rel, url, deps in found:
            cls, detail, _ = results[url]
            if l != lib or cls == "alive":
                continue
            bad += 1
            category = "source-dead" if cls == "dead" else "source-unreachable"
            rid = stable_id(category, rel, url)
            if rid in seen:
                dupes += 1; continue
            seen.add(rid)
            records.append({"id": rid, "category": category, "status": "open", "stub": rel,
                            "url": url, "detail": detail, "date": TODAY,
                            "dependants": f"{len(deps)}: " + "; ".join(deps) if deps else "0"})
        if records:
            err = append_records(queue_path, records, kb_watch)
            if err:
                print(f"kb-sources: could not queue to {queue_path}: {err}", file=sys.stderr)
            else:
                queued += len(records)
    if not bad:
        print("\nAll URLs alive. Nothing queued.")
        return 0
    print(f"\n{bad} stub URL(s) dead or unreachable. Nothing was edited and nothing marked BROKEN: "
          f"queued {queued} new finding(s) to needs-attention.md"
          + (f" ({dupes} already queued)" if dupes else "") + ". A human triages them.")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
