#!/usr/bin/env python3
"""check-scope — the scope attribute is only a rule if something enforces it.

check-kb proves `scope:` is PRESENT. This proves it is right: that the value is
well-formed, that it agrees with the library holding it, and that nothing reaches
outside the library to fetch knowledge by relative path.

Why the agreement rule matters more than it looks: a library is one domain, and a
domain is one tier. A `repo:` fact filed in a general-tier library is a claim
about every deployment made from one, and a `product:` fact filed as `general` is
a claim about every product made from one. Both read as ordinary facts. Neither
announces itself.

NOT covered: the CODEOWNER audit on promotion to a shared tier (dormant — there
is one owner), and cross-library slug uniqueness, which is obsolete: every
cross-library reference carries a mandatory prefix, so nothing can collide.

TWO KINDS OF TREE, told apart by structure rather than by name or path:
  * a LIBRARY is its own git repository (it has .git at its root). It is a
    general-tier home, so a repo: scope there is a misfiled deployment fact.
  * a PROJECT TREE is not — it sits inside the project's repository. It is the
    repo-tier home, so anything BUT repo: there is a general fact misfiled into
    one project, which is how a shared fact becomes N drifting copies.
The rules are mirror images, and applying the library rule to a project tree
rejects exactly the tree kb-init creates.

Usage: check-scope <tree-root> [more-tree-roots...]
Exit 0 clean, 1 on any defect.
"""
import pathlib, re, sys

NON_KB = {"documents", "plugins", "scripts", ".github", ".githooks",
          ".claude-plugin", ".claude", ".git"}
VALID = re.compile(r"^(general|product:[a-z0-9][a-z0-9-]*|org:[a-z0-9][a-z0-9-]*|repo:[a-z0-9][a-z0-9-]*)$")
# A relative link that climbs out of the library it is written in.
ESCAPE = re.compile(r"\]\(\s*(\.\./[^)]*)\)|\[\[\s*(\.\.[^\]]*)\]\]")


def classify(root: pathlib.Path) -> str:
    """A library is its own repository; a project tree lives inside one."""
    if (root / ".git").exists():
        return "library"
    probe = root.resolve()
    for parent in probe.parents:
        if (parent / ".git").exists():
            return "project"
    return "library"   # outside any repository: apply the stricter, general-tier rule


def scope_of(text):
    m = re.search(r"^scope:\s*(\S+)\s*$", text, re.M)
    return m.group(1) if m else None


def main(roots) -> int:
    defects = []
    total = 0
    for root in roots:
        root = pathlib.Path(root)
        idx = root / "INDEX.md"
        if not idx.is_file():
            defects.append(f"{root}: no INDEX.md — not a library root"); continue
        lib_scope = scope_of(idx.read_text())
        if lib_scope is None:
            defects.append(f"{idx}: library router declares no scope:"); continue
        if not VALID.match(lib_scope):
            defects.append(f"{idx}: library scope '{lib_scope}' is not a valid value")

        kind = classify(root)
        if kind == "library" and lib_scope.startswith("repo:"):
            defects.append(
                f"{idx}: this is a library (its own repository), which is a general-tier home, but it "
                f"declares '{lib_scope}'. Repo-tier knowledge lives in the project it describes")
        elif kind == "project" and not lib_scope.startswith("repo:"):
            defects.append(
                f"{idx}: this is a project tree, which is the repo-tier home, but it declares "
                f"'{lib_scope}'. A fact true beyond this deployment belongs in a shared library — "
                f"filed here it becomes one of N copies that drift")

        label = root.name or root.resolve().name   # a trailing slash leaves .name empty
        for f in sorted(root.rglob("*.md")):
            rel = f.relative_to(root)
            if NON_KB & set(rel.parts):
                continue
            total += 1
            text = f.read_text(errors="replace")
            s = scope_of(text)
            if s is None:
                defects.append(f"{label}/{rel}: no scope:")
            elif not VALID.match(s):
                defects.append(f"{label}/{rel}: scope '{s}' is not one of "
                               f"general | product:<vendor> | org:<company> | repo:<project>")
            elif s != lib_scope and kind == "project":
                defects.append(f"{label}/{rel}: scope '{s}' disagrees with its project tree "
                               f"('{lib_scope}'). A project tree holds only facts true of this "
                               f"deployment — one true beyond it belongs in a shared library")
            elif s != lib_scope:
                defects.append(f"{label}/{rel}: scope '{s}' disagrees with its library "
                               f"('{lib_scope}'). A library is one domain and a domain is one tier — "
                               f"this fact belongs in a different library")

            for m in ESCAPE.finditer(text):
                target = (m.group(1) or m.group(2)).strip()
                defects.append(f"{label}/{rel}: link '{target}' climbs out of the library. "
                               f"Cross-library references use [[library:slug]]; a relative path across "
                               f"a boundary resolves only in one layout")

    for d in defects:
        print(f"FAIL {d}")
    kinds = [classify(pathlib.Path(r)) for r in roots]
    n_lib, n_proj = kinds.count("library"), kinds.count("project")
    parts = ([f"{n_lib} librar{'y' if n_lib == 1 else 'ies'}"] if n_lib else []) + \
            ([f"{n_proj} project tree{'' if n_proj == 1 else 's'}"] if n_proj else [])
    print(f"\n{total} file(s) across {' and '.join(parts) or '0 trees'} — "
          + ("clean" if not defects else f"{len(defects)} defect(s)"))
    return 1 if defects else 0


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("usage: check-scope <library-root> [more...]", file=sys.stderr); sys.exit(2)
    sys.exit(main(sys.argv[1:]))
