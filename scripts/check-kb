#!/usr/bin/env python3
"""check-kb — partial implementation of the CONVENTIONS §13 check table.

Covers, within a single root:
  * frontmatter lint  — required fields present, name matches filename
  * check-links       — [[slug]] and relative router links resolve
  * slug uniqueness   — within-root filename uniqueness; no [[slug]] at a path-addressed file
  * orphans           — every file reachable from the root INDEX.md by router links

ORPHANS are the defect nothing else catches at commit time: an unrouted file
passes every other check and is invisible to retrieval, which descends routers
and never searches. Reachability, not mere mention: a file listed only by a
sub-INDEX that is itself unrouted is as lost as one listed nowhere, and a
[[slug]] from a topic file is a cross-reference, not a route. Exempt, per §3:
the root INDEX.md (the entry point), the golden set (routing it would hand the
retrieval agent its answer key) and documents/ (evidence, already excluded).

Elsewhere (§13): scope values (check-scope), [[library:slug]] (check-xlinks),
golden-set integrity (check-golden), secrets, exec bits, embedded facts.

Usage: check-kb <knowledge-root>

The root is REQUIRED. This checks a domain library; the engine repository holds
no knowledge content, so there is no sensible default and a silent one would
report a clean run over zero files.
Exit 0 clean, 1 on any defect.
"""
import pathlib, re, sys
from collections import Counter

import yaml

# §5: reached by relative path, never a [[slug]] target, so exempt from the
# filename-uniqueness and name-matches-filename rules.
PATH_ADDRESSED = {"INDEX.md", "CONVENTIONS.md"}
# Directories inside the knowledge repo that are NOT part of the knowledge base:
# decision records, the behaviour plugin, tooling and CI config. They are ordinary
# files with no frontmatter contract, and linting them would fail every run.
NON_KB_DIRS = {"documents", "plugins", "scripts", ".github", ".githooks",
               ".claude-plugin", ".claude", ".git"}

# Illustrative syntax inside the contract's own examples, not real links.
EXAMPLE_LINKS = {"child.md", "subfolder/INDEX.md"}
EXAMPLE_SLUGS = {"slug", "general:slug", "general:some-fact", "cross-link",
                 "source", "YYYY-MM-DD-domain-notes"}
REQUIRED = ("name", "description", "domain", "scope")


ROUTER_LINK = re.compile(r"\[([^\]]+)\]\(([^)#]+\.md)\)")


def orphans(root: pathlib.Path, files: list) -> list:
    """Files not reachable from root/INDEX.md by following links out of routers."""
    entry = root / "INDEX.md"
    if not entry.exists():
        return [f"{root}: no INDEX.md at the root — nothing in it is reachable"]
    known = {f.resolve() for f in files}
    reached, queue = {entry.resolve()}, [entry.resolve()]
    while queue:
        router = queue.pop()
        for _, target in ROUTER_LINK.findall(router.read_text()):
            if target.startswith("http"):
                continue
            t = (router.parent / target).resolve()
            if t in known and t not in reached:
                reached.add(t)
                if t.name == "INDEX.md":
                    queue.append(t)
    return [f"{f}: orphan — no router reaches it from {entry}, so retrieval never will"
            for f in files
            if f.resolve() not in reached
            and f.name not in PATH_ADDRESSED - {"INDEX.md"}
            and not f.name.endswith("-golden.md")]


def main(root: pathlib.Path) -> int:
    files = sorted(f for f in root.rglob("*.md")
                   if not NON_KB_DIRS & set(f.relative_to(root).parts))
    if not files:
        print(f"no markdown files under {root}")
        return 1
    slugs = {f.stem for f in files}
    defects = []

    for f in files:
        text = f.read_text()
        if not text.startswith("---\n"):
            defects.append(f"{f}: no frontmatter")
            continue
        try:
            fm = yaml.safe_load(text.split("---\n", 2)[1]) or {}
        except yaml.YAMLError as e:
            defects.append(f"{f}: unparseable frontmatter ({e})")
            continue

        for key in REQUIRED:
            if key not in fm:
                defects.append(f"{f}: frontmatter missing '{key}'")
        if f.name not in PATH_ADDRESSED and fm.get("name") != f.stem:
            defects.append(f"{f}: name '{fm.get('name')}' does not match filename '{f.stem}'")

        for _, target in re.findall(r"\[([^\]]+)\]\(([^)#]+\.md)\)", text):
            if target in EXAMPLE_LINKS or target.startswith("http"):
                continue
            if not (f.parent / target).resolve().exists():
                defects.append(f"{f}: dead router link -> {target}")

        for link in re.findall(r"\[\[([^\]]+)\]\]", text):
            # <angle brackets> mark a template placeholder, not a real link target.
            if link in EXAMPLE_SLUGS or "<" in link or ">" in link:
                continue
            bare = link.split(":", 1)[-1]
            if bare in {p.removesuffix(".md") for p in PATH_ADDRESSED}:
                defects.append(f"{f}: [[{link}]] targets a path-addressed file — cite it by path")
            elif ":" in link:
                pass  # cross-root; not resolvable from one root yet (§13)
            elif bare not in slugs:
                defects.append(f"{f}: dead [[{link}]]")

    for name, count in Counter(f.name for f in files).items():
        if count > 1 and name not in PATH_ADDRESSED:
            defects.append(f"filename '{name}' appears {count}x — slugs must be unique within a root")

    # A folder name is a slug too (CONVENTIONS §5), so a file may not share a directory's name.
    dir_slugs = {d.name: d for d in root.rglob("*") if d.is_dir()}
    for f in files:
        if f.name in PATH_ADDRESSED:
            continue
        if f.stem in dir_slugs:
            defects.append(
                f"{f}: slug '{f.stem}' collides with directory '{dir_slugs[f.stem]}' — "
                f"a folder name is a slug too, so [[{f.stem}]] is ambiguous")

    defects += orphans(root, files)

    for d in defects:
        print(f"FAIL {d}")
    print(f"\n{len(files)} files checked — " + ("clean" if not defects else f"{len(defects)} defect(s)"))
    return 1 if defects else 0


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__.strip().split("\n\n")[-2], file=sys.stderr)
        sys.exit(2)
    sys.exit(main(pathlib.Path(sys.argv[1])))
