#!/usr/bin/env python3
"""check-kb — partial implementation of the CONVENTIONS §13 check table.

Covers, within a single root:
  * frontmatter lint  — required fields present, name matches filename
  * check-links       — [[slug]] and relative router links resolve
  * slug uniqueness   — within-root filename uniqueness; no [[slug]] at a path-addressed file
  * orphans           — every file reachable from the root INDEX.md by router links
  * stamp placement   — no indented Verified:/Recheck: line outside a code fence
  * verified: floor   — a declared floor equals the one derived from the section stamps (§7);
                        no stamp is dated in the future
  * agent_ttl         — if the root INDEX.md declares one, it is <N>d and shorter than
                        freshness_horizon (§7)
  * kb_contract       — if the root INDEX.md declares one, it is a quoted MAJOR.MINOR (§3, ADR-0016)
  * contract gating   — rules apply by the declared contract version (§14): a rule newer than it
                        is a WARN, not a failure; a library behind the newest version gets a NOTE
                        of what the newer versions add; one ahead by a minor is checked by the
                        newest rules known; an unsupported major fails

ORPHANS are the defect nothing else catches at commit time: an unrouted file
passes every other check and is invisible to retrieval, which descends routers
and never searches. Reachability, not mere mention: a file listed only by a
sub-INDEX that is itself unrouted is as lost as one listed nowhere, and a
[[slug]] from a topic file is a cross-reference, not a route. Exempt, per §3:
the root INDEX.md (the entry point), the golden set (routing it would hand the
retrieval agent its answer key) and documents/ (evidence, already excluded).

Elsewhere (§13): scope values (check-scope), [[library:slug]] (check-xlinks),
golden-set integrity (check-golden), secrets, exec bits, embedded facts.

Usage: check-kb <knowledge-root>

The root is REQUIRED. This checks a domain library; the engine repository holds
no knowledge content, so there is no sensible default and a silent one would
report a clean run over zero files.
Exit 0 clean, 1 on any defect.
"""
import datetime, pathlib, re, sys
from collections import Counter

# §5: reached by relative path, never a [[slug]] target, so exempt from the
# filename-uniqueness and name-matches-filename rules.
PATH_ADDRESSED = {"INDEX.md", "CONVENTIONS.md"}
# Directories inside the knowledge repo that are NOT part of the knowledge base:
# decision records, the behaviour plugin, tooling and CI config. They are ordinary
# files with no frontmatter contract, and linting them would fail every run.
NON_KB_DIRS = {"documents", "plugins", "scripts", ".github", ".githooks",
               ".claude-plugin", ".claude", ".git"}

# Illustrative syntax inside the contract's own examples, not real links.
EXAMPLE_LINKS = {"child.md", "subfolder/INDEX.md"}
EXAMPLE_SLUGS = {"slug", "general:slug", "general:some-fact", "cross-link",
                 "source", "YYYY-MM-DD-domain-notes"}
REQUIRED = ("name", "description", "domain", "scope")
TODAY = datetime.date.today().isoformat()


ROUTER_LINK = re.compile(r"\[([^\]]+)\]\(([^)#]+\.md)\)")
# kb-verify reads a stamp or an assertion only at column 0. Indented, it looks stamped and
# certifies nothing, and its Recheck never runs (§7). Inside a code fence it is an example.
INDENTED_STAMP = re.compile(r"^\s+(Verified|Recheck):")
FENCE = re.compile(r"^\s*(```|~~~)")
HEADING = re.compile(r"^#{1,6}\s")
SOURCE = re.compile(r"^Source:")
STAMP_DATE = re.compile(r"^Verified:\s*(\d{4}-\d{2}-\d{2})")
CONFLICTED = re.compile(r"^\s*status:\s*CONFLICTED\b")
UNCORROBORATED = re.compile(r"^\s*status:\s*UNCORROBORATED\b")


def marked_sections(body: str, marker=UNCORROBORATED) -> list:
    """The text of each section a status marker sits directly under (§8: a marker applies to
    the heading it sits under, never to the headings enclosing it). check-golden reads an
    uncorroborated case's excerpt through this, so the case tests the claim that is marked."""
    sections, cur, fenced = [], [], False
    for line in body.split("\n"):
        if FENCE.match(line):
            fenced = not fenced
        elif not fenced and HEADING.match(line):
            sections.append(cur); cur = []
        cur.append(line)
    sections.append(cur)
    out, fenced = [], False
    for s in sections:
        marked = False
        for line in s:
            if FENCE.match(line):
                fenced = not fenced
            elif not fenced and marker.match(line):
                marked = True
        if marked:
            out.append("\n".join(s))
    return out


def served_sections(body: str) -> list:
    """The sections of a file's body that are served — not CONFLICTED (§8) — each as
    {sourced, dates, sources}. `sources` holds one flag per Source: line, true once a Verified:
    stamp follows it before the next Source: line: §6 stacks one stamp per source, so a second
    source under one stamp is unstamped though its section is not (issue #64). derived_floor
    and kb-due's unstamped count read sections through this, so "unstamped" means one thing
    everywhere."""
    new = lambda: {"sourced": False, "dates": [], "conflicted": False, "sources": []}
    sections, cur, fenced = [], new(), False
    for line in body.split("\n"):
        if FENCE.match(line):
            fenced = not fenced
        elif fenced:
            continue
        elif HEADING.match(line):
            sections.append(cur)
            cur = new()
        elif SOURCE.match(line):
            cur["sourced"] = True
            cur["sources"].append(False)
        elif m := STAMP_DATE.match(line):
            cur["dates"].append(m.group(1))
            if cur["sources"]:
                cur["sources"][-1] = True
        elif CONFLICTED.match(line):
            cur["conflicted"] = True
    sections.append(cur)
    return [s for s in sections if not s["conflicted"]]


def unstamped(body: str) -> int:
    """Source: lines in served sections with no Verified: stamp of their own: unknown, not
    fresh (§7). Counted per source, not per section (§6 stacks one stamp per source; #64)."""
    return sum(s["sources"].count(False) for s in served_sections(body))


def derived_floor(body: str) -> str:
    """The frontmatter verified: floor a file's body supports (§7): the oldest stamp among its
    sections that are not CONFLICTED, or 'unknown' when one of those sections cites a Source:
    that carries no stamp of its own, or when nothing is stamped. Absent is not fresh. kb-verify imports
    this to move the floor when it restamps, so there is one derivation, not two."""
    served = served_sections(body)
    if unstamped(body):
        return "unknown"
    return min((d for s in served for d in s["dates"]), default="unknown")


def agent_ttl(declared, horizon: int) -> int:
    """Days an agent stamp stays fresh (§7): the root INDEX.md's agent_ttl: if it declares one,
    else a tenth of the horizon. Declared because a derived value surprised: a vendor-product
    horizon of 90-180d gives 9-18d, so agent stamps expired before every monthly sweep, and
    stretching the horizon to fix that stretched the human TTL too (issue #30). Raises
    ValueError unless it is <N>d and shorter than the horizon: an agent TTL as long as the
    horizon erases the trust tier between agent and human stamps. kb-verify and kb-due import
    this, so the one rule has one copy."""
    if declared is None:
        return max(1, horizon // 10)
    value = declared.split(" #")[0].strip().strip('"').strip("'")
    m = re.fullmatch(r"(\d+)d", value)
    if not m or not 0 < int(m.group(1)) < horizon:
        raise ValueError(f"agent_ttl: {value!r} must be <N>d and shorter than freshness_horizon "
                         f"({horizon}d), or an agent stamp is trusted as long as a human one")
    return int(m.group(1))


def contract_version(declared) -> tuple:
    """The contract version a root INDEX.md declares, as (major, minor) (ADR-0016). `declared`
    is the raw text after `kb_contract:`, quotes included. Absent is 2.0: every library that
    predates the field was built to engine v0.2.0's rules, which are contract 2.0. Raises
    ValueError unless it is a quoted MAJOR.MINOR in plain digits. Quoted, because a YAML reader
    turns a bare 2.10 into the number 2.1; plain digits (no leading zero, patch or prefix), so
    "2.01" and "2.1" cannot both name one version."""
    if declared is None:
        return (2, 0)
    value = declared.split(" #")[0].strip()
    q = re.fullmatch(r'"([^"]*)"|\'([^\']*)\'', value)
    if not q:
        raise ValueError(f"kb_contract: {value} must be quoted, e.g. \"2.0\": a YAML reader turns "
                         f"a bare 2.10 into the number 2.1 (ADR-0016)")
    m = re.fullmatch(r"(0|[1-9]\d*)\.(0|[1-9]\d*)", q.group(1) if q.group(1) is not None else q.group(2))
    if not m:
        raise ValueError(f"kb_contract: {value} must be MAJOR.MINOR, e.g. \"2.0\" (ADR-0016)")
    return (int(m.group(1)), int(m.group(2)))


ENGINE = pathlib.Path(__file__).resolve().parent.parent
CONTRACT_SECTION = re.compile(r"^## \d+\. Contract versions\n(.*?)(?=^## |\Z)", re.M | re.S)
CONTRACT_HEADING = re.compile(r"^### (0|[1-9]\d*)\.(0|[1-9]\d*)\s*$")


def known_contracts() -> dict:
    """{(major, minor): what it adds} for every contract version this engine knows: the `### X.Y`
    headings of CONVENTIONS §14, each with the first paragraph under it. The spec is the one
    copy, so publishing a version is writing its §14 entry (ADR-0016). Raises RuntimeError if
    §14 lists nothing: an engine that cannot name its versions cannot gate by them."""
    m = CONTRACT_SECTION.search((ENGINE / "CONVENTIONS.md").read_text(errors="replace"))
    known, cur, para = {}, None, []
    for line in (m.group(1) if m else "").split("\n"):
        if h := CONTRACT_HEADING.match(line):
            cur, para = (int(h.group(1)), int(h.group(2))), []
            known[cur] = ""
        elif cur and not known[cur]:
            if line.strip():
                para.append(line.strip())
            elif para:
                known[cur] = " ".join(para)
    if cur and not known[cur]:
        known[cur] = " ".join(para)
    if not known:
        raise RuntimeError(f"{ENGINE / 'CONVENTIONS.md'} lists no contract versions (§14)")
    return known


def declared_contract(root: pathlib.Path):
    """The raw text after `kb_contract:` in a root INDEX.md's frontmatter, or None."""
    try:
        text = (root / "INDEX.md").read_text(errors="replace")
    except OSError:
        return None
    block = text.split("---\n", 2)
    if not text.startswith("---\n") or len(block) < 3:
        return None
    m = re.search(r"^kb_contract:[ \t]*(.*?)[ \t]*$", block[1], re.M)
    return m.group(1) if m else None


def fmt(v: tuple) -> str:
    return f"{v[0]}.{v[1]}"


def contract_status(declared) -> tuple:
    """(state, version, newest, newer) for a declared kb_contract (ADR-0016). state is current,
    behind (older than the newest known: `newer` lists (version, what it adds) above it), ahead
    (a newer minor of a supported major: checked by the newest rules known) or unsupported (a
    major outside the last two this engine has published). Raises ValueError if malformed."""
    v = contract_version(declared)
    known = known_contracts()
    newest = max(known)
    supported = {newest[0], newest[0] - 1} & {k[0] for k in known}
    if v[0] not in supported:
        return "unsupported", v, newest, []
    if v > newest:
        return "ahead", v, newest, []
    newer = [(k, known[k]) for k in sorted(known) if k > v]
    return ("behind" if newer else "current"), v, newest, newer


def supported_majors() -> str:
    known = known_contracts()
    newest = max(known)
    return " and ".join(f"{m}.x" for m in sorted({newest[0], newest[0] - 1} & {k[0] for k in known}))


def kb_files(root: pathlib.Path) -> list:
    """The markdown files that are part of the knowledge base (everything but NON_KB_DIRS)."""
    return sorted(f for f in root.rglob("*.md")
                  if not NON_KB_DIRS & set(f.relative_to(root).parts))


def reachable(root: pathlib.Path, files: list) -> set:
    """Resolved paths of the files reachable from root/INDEX.md by following links out of
    routers. Empty when the root has no INDEX.md. check-golden asks the same question of
    every expected_file, so the answer lives here once."""
    entry = root / "INDEX.md"
    if not entry.exists():
        return set()
    known = {f.resolve() for f in files}
    reached, queue = {entry.resolve()}, [entry.resolve()]
    while queue:
        router = queue.pop()
        for _, target in ROUTER_LINK.findall(router.read_text()):
            if target.startswith("http"):
                continue
            t = (router.parent / target).resolve()
            if t in known and t not in reached:
                reached.add(t)
                if t.name == "INDEX.md":
                    queue.append(t)
    return reached


def orphans(root: pathlib.Path, files: list) -> list:
    """Files not reachable from root/INDEX.md by following links out of routers."""
    entry = root / "INDEX.md"
    if not entry.exists():
        return [f"{root}: no INDEX.md at the root — nothing in it is reachable"]
    reached = reachable(root, files)
    return [f"{f}: orphan — no router reaches it from {entry}, so retrieval never will"
            for f in files
            if f.resolve() not in reached
            and f.name not in PATH_ADDRESSED - {"INDEX.md"}
            and not f.name.endswith("-golden.md")]


# STDLIB ONLY, deliberately. PyYAML is not installed everywhere, and this runs in
# every commit hook on every machine: an import nobody has is a traceback where a
# guardrail should be. It bit CI, which had never run this check (the engine holds
# no knowledge for it to read) and so had never noticed the dependency.
#
# It parses only what the contract needs — `key: value` at the top level, and
# `key:` introducing an indented block, which it records as present and does not
# descend into. A line that is neither is reported rather than skipped: silence
# about a malformed file is how a malformed file survives.
KEY = re.compile(r"^([A-Za-z_][\w-]*):\s*(.*)$")


def frontmatter(block: str):
    fm, bad = {}, None
    for n, line in enumerate(block.split("\n"), 1):
        if not line.strip() or line.startswith("#") or line[0] in " \t-":
            continue                      # blank, comment, nested value, or list item
        m = KEY.match(line)
        if not m:
            bad = (n, line); break
        fm[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    return fm, bad


def main(root: pathlib.Path) -> int:
    files = kb_files(root)
    if not files:
        print(f"no markdown files under {root}")
        return 1
    slugs = {f.stem for f in files}
    defects, warnings, notes = [], [], []

    # Rules apply by the contract version the library declares (§14, ADR-0016). A malformed
    # version is a defect below; until it is fixed, the newest rules apply.
    index = root / "INDEX.md"
    try:
        state, version, newest, newer = contract_status(declared_contract(root))
    except ValueError:
        state, version, newest, newer = "malformed", None, max(known_contracts()), []
    rules = newest if state in ("ahead", "unsupported", "malformed") else version
    if state == "behind":
        notes.append(f"{index}: built to contract {fmt(version)}; this engine knows {fmt(newest)}. "
                     f"Raise kb_contract to adopt what is newer — "
                     + "; ".join(f"{fmt(k)}: {what}" for k, what in newer))
    elif state == "ahead":
        notes.append(f"{index}: declares contract {fmt(version)}, newer than this engine knows "
                     f"({fmt(newest)}); checked by {fmt(newest)}'s rules — upgrade the engine to "
                     f"check the rest")
    elif state == "unsupported":
        defects.append(f"{index}: declares contract {fmt(version)}, which is not supported by this "
                       f"engine (it supports {supported_majors()}) — it is not served; see the "
                       f"migration notes in CONVENTIONS §14, or upgrade the engine")

    def rule(since: tuple, message: str):
        """A defect if the library's rules include `since`, else a warning naming it."""
        if rules >= since:
            defects.append(message)
        else:
            warnings.append(f"{message} — fails from contract {fmt(since)} (this library declares "
                            f"{fmt(version)})")

    # sources/ holds only .md citation stubs (§6); the artifacts they cite are archived under
    # documents/. Only .md files are read below, so a raw file here would pass unseen (issue #71).
    for p in sorted((root / "sources").rglob("*")) if (root / "sources").is_dir() else []:
        if p.is_file() and p.suffix != ".md" and not p.name.startswith("."):
            rule((2, 1), f"{p}: raw artifact in sources/, which holds only .md citation stubs — "
                         f"archive it under documents/ and cite it with a stub here (§6)")

    for f in files:
        text = f.read_text()
        if not text.startswith("---\n"):
            defects.append(f"{f}: no frontmatter")
            continue
        block = text.split("---\n", 2)
        if len(block) < 3:
            defects.append(f"{f}: frontmatter is not closed by a --- line")
            continue
        fm, bad = frontmatter(block[1])
        if bad:
            defects.append(f"{f}: unparseable frontmatter line {bad[0]}: {bad[1]!r}")
            continue

        for key in REQUIRED:
            if key not in fm:
                defects.append(f"{f}: frontmatter missing '{key}'")
        if f.name not in PATH_ADDRESSED and fm.get("name") != f.stem:
            defects.append(f"{f}: name '{fm.get('name')}' does not match filename '{f.stem}'")

        for _, target in re.findall(r"\[([^\]]+)\]\(([^)#]+\.md)\)", text):
            if target in EXAMPLE_LINKS or target.startswith("http"):
                continue
            if not (f.parent / target).resolve().exists():
                defects.append(f"{f}: dead router link -> {target}")

        for link in re.findall(r"\[\[([^\]]+)\]\]", text):
            # <angle brackets> mark a template placeholder, not a real link target.
            if link in EXAMPLE_SLUGS or "<" in link or ">" in link:
                continue
            bare = link.split(":", 1)[-1]
            if bare in {p.removesuffix(".md") for p in PATH_ADDRESSED}:
                defects.append(f"{f}: [[{link}]] targets a path-addressed file — cite it by path")
            elif ":" in link:
                pass  # cross-root; not resolvable from one root yet (§13)
            elif bare not in slugs:
                defects.append(f"{f}: dead [[{link}]]")

        fenced = False
        for n, line in enumerate(text.split("\n"), 1):
            if FENCE.match(line):
                fenced = not fenced
            elif not fenced and (m := INDENTED_STAMP.match(line)):
                defects.append(f"{f}:{n}: indented {m.group(1)}: line — kb-verify reads it only "
                               f"at the start of a line, so this one certifies nothing")
            elif not fenced and (m := STAMP_DATE.match(line)) and m.group(1) > TODAY:
                defects.append(f"{f}:{n}: stamp dated in the future ({m.group(1)})")

        if f == root / "INDEX.md" and "agent_ttl" in fm:
            h = re.match(r"(\d+)d", fm.get("freshness_horizon", ""))
            try:
                agent_ttl(fm["agent_ttl"], int(h.group(1)) if h else 0)
            except ValueError as e:
                defects.append(f"{f}: {e}")

        if f == root / "INDEX.md" and "kb_contract" in fm:
            try:
                raw = re.search(r"^kb_contract:[ \t]*(.*?)[ \t]*$", block[1], re.M)
                contract_version(raw.group(1))
            except ValueError as e:
                defects.append(f"{f}: {e}")

        if "verified" in fm:
            declared = fm["verified"].split(" #")[0].strip()      # a trailing YAML comment
            floor = derived_floor(block[2])
            if declared != floor:
                defects.append(f"{f}: frontmatter verified: {declared}, but the derived floor is "
                               f"{floor} (§7: oldest non-CONFLICTED stamp; unknown if a sourced "
                               f"section is unstamped)")

    for name, count in Counter(f.name for f in files).items():
        if count > 1 and name not in PATH_ADDRESSED:
            defects.append(f"filename '{name}' appears {count}x — slugs must be unique within a root")

    # A folder name is a slug too (CONVENTIONS §5), so a file may not share a directory's name.
    dir_slugs = {d.name: d for d in root.rglob("*")
                 if d.is_dir() and not NON_KB_DIRS & set(d.relative_to(root).parts)}
    for f in files:
        if f.name in PATH_ADDRESSED:
            continue
        if f.stem in dir_slugs:
            defects.append(
                f"{f}: slug '{f.stem}' collides with directory '{dir_slugs[f.stem]}' — "
                f"a folder name is a slug too, so [[{f.stem}]] is ambiguous")

    defects += orphans(root, files)

    for n in notes:
        print(f"NOTE {n}")
    for w in warnings:
        print(f"WARN {w}")
    for d in defects:
        print(f"FAIL {d}")
    print(f"\n{len(files)} files checked — " + ("clean" if not defects else f"{len(defects)} defect(s)"))
    return 1 if defects else 0


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__.strip().split("\n\n")[-2], file=sys.stderr)
        sys.exit(2)
    sys.exit(main(pathlib.Path(sys.argv[1])))
