#!/usr/bin/env python3
"""kb-report — the weekly report of what needs a person's decision, and nothing else (ADR-0017, #102).

Keeping libraries current leaves its results in several places: review packets (kb-prepare), each
library's needs-attention.md (kb-verify, kb-sources, kb-watch, kb-audit), and the contract version.
Reading all of them is a chore. This reads them and writes one file a week, outside every library,
listing per library only what a person has to decide:

- a review packet waiting, and how to act on it;
- each open queue item: its category, and where (file § section, source stub or watched source),
  and how many records of the queue could not be read at all;
- rechecks that are due but marked `Recheck (attended):`, which only a person can run;
- a sweep due, or notes awaiting distillation, that no packet covers yet;
- while a sweep is due, the source stubs marked `Liveness: manual`, which only a person can check;
- a library behind the contract, ahead of this engine's, or on one this engine cannot serve;
- anything about a library this could not work out, named as an item under it: a failure in one
  library never stops the report, so a person finds out instead of reading a report that left it out;
- kb-retrieve runs in the past 7 days that answered `fact not found` (kb-telemetry, #147): an absent
  topic named in the root `Not covered here:` line makes the next such question far cheaper. The
  report gives the count and cost; `kb-telemetry --not-found` lists the questions.

A library declaring `archived:` that is not registered is left out, as `kb-due` leaves it out (#141).
A library with nothing to decide gets no section. When no library has anything, the report says so
in one line. Either way the file is written, so a quiet week can be told from a week the job did not
run. It never holds a fact's, a source's or a packet's text: paths, counts, headings and ids only.

The report is <out>/<ISO year>-W<ISO week>.md; a rerun in the same week replaces it. The default
<out> is $KB_REPORTS, or ~/.local/state/ai-kb/reports (ADR-0021). `kb-due --nudge` names the
latest report while it is under eight days old and lists decisions.

Usage: kb-report [tree ...] [--out DIR]
  With no tree, every registered library. Schedulable (#95): exit 0 nothing to decide, 1 decisions
  written, 2 could not run (the engine's readers would not load, or the report's own folder is inside a
  library). A library that cannot be read is an item under its name, not a failure.
"""
import datetime, importlib.machinery, importlib.util, os, pathlib, re, sys

from kbengine import attention, contract, env
from kbengine.attention import Failed

SCRIPTS = pathlib.Path(__file__).resolve().parent


def load_module(name: str, filename: str):
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader(name, str(SCRIPTS / filename))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def reports_dir(out=None) -> pathlib.Path:
    if out:
        return pathlib.Path(out)
    return env.reports_dir()


def latest(out=None):
    """(path, decisions, age in days) of the newest report, or None."""
    root = reports_dir(out)
    found = sorted(root.glob("*-W*.md")) if root.is_dir() else []
    if not found:
        return None
    path = found[-1]
    m = re.search(r"^decisions: (\d+)$", path.read_text(errors="replace"), re.M)
    age = (datetime.datetime.now().timestamp() - path.stat().st_mtime) / 86400
    return path, int(m.group(1)) if m else 0, age


def where(rec: dict) -> str:
    """A queue record's location, from its structural fields only, never its values."""
    if rec.get("file"):
        return rec["file"] + (f" § {rec['section']}" if rec.get("section") else "")
    for key in ("stub", "source_id"):
        if rec.get(key):
            return rec[key] + (f" ({rec['field']})" if rec.get("field") not in (None, "", "-") else "")
    return "(no location recorded)"


def not_found_week(mods: dict) -> dict:
    """{library root: its fact-not-found kb-retrieve runs in the past 7 days}, from kb-telemetry,
    which names a library by its registered name. Never fails the report: no transcripts, or none
    readable, is no runs."""
    try:
        roots = {n: pathlib.Path(p).resolve() for n, p in mods["kb_libraries"].installed().items()}
        today = datetime.datetime.now(datetime.timezone.utc).date()   # transcripts are stamped in UTC
        runs, _evals = mods["kb_telemetry"].collect(env.claude_projects(),
                                                    today - datetime.timedelta(days=6), today)
    except Exception:
        return {}
    out = {}
    for r in runs:
        if r["not_found"] and r["library"] in roots:
            out.setdefault(roots[r["library"]], []).append(r)
    return out


def computed(value, what: str, out: list):
    """`value`, or None after listing under the library that `what` could not be worked out (#204): a
    failure in one library is an item for a person, not the end of the report."""
    if isinstance(value, Failed):
        out.append(f"Could not compute {what} ({value.kind}). Run check-kb on the library to see why.")
        return None
    return value


def decisions_for(att, names: dict, gaps=None) -> list:
    root, out = att.root, []
    for p, h in att.packets:
        out.append(f"Review packet: {h.get('packet', '?')}, prepared {h.get('prepared', '?')[:10]}. "
                   f"Ask a session to review it (`kb-apply show {p}`).")

    for r in computed(att.queue, "the open queue items", out) or []:
        out.append(f"Queue item {r.get('id', '?')} [{r.get('category', '?')}]: {where(r)}. "
                   f"Triage it in needs-attention.md.")

    bad = att.queue_unreadable   # records the queue reader skips are named, not lost (#168, #204)
    if not (isinstance(bad, Failed) and bad == att.queue):   # a queue that cannot be read is listed once
        bad = computed(bad, "the unreadable queue records", out)
        if bad:
            out.append(f"{len(bad)} unreadable queue record(s) in needs-attention.md, which the report cannot "
                       f"list: check-kb names the lines.")

    rechecks = computed(att.rechecks, "the facts due for recheck", out)
    attended = rechecks.attended if rechecks else []
    if attended:
        out.append(f"{len(attended)} attended recheck(s) due, which need you there: "
                   f"`kb-verify {root} --yes`.")

    if att.sweep.due and not att.sweep_covered:
        out.append("Sweep due and no audit packet drafted: run kb-audit, or enable preparation in kb-schedule.")
    if att.sweep.due:
        # Once per sweep interval: listed while the sweep is due, gone once it is done (#120).
        manual = computed(att.manual_stubs, "the source stubs marked Liveness: manual", out)
        if manual:
            out.append(f"{len(manual)} source(s) marked Liveness: manual, which only a person can check: "
                       f"{', '.join(manual)}. Open each and confirm it still holds what its facts cite.")
    notes = computed(att.episodic, "the notes awaiting distillation", out)
    if notes and not att.distill_covered:
        out.append(f"{notes} note(s) awaiting distillation and no packet drafted: run kb-distill.")

    found = computed(att.contract, "the contract version", out)
    state, v, newest, _newer = found or (None, None, None, None)
    if state == "behind":
        out.append(f"Built to contract {contract.fmt(v)}; this engine knows {contract.fmt(newest)}. "
                   f"Decide whether to adopt it (CONVENTIONS §14).")
    elif state == "ahead":
        out.append(f"Declares contract {contract.fmt(v)}, newer than this engine ({contract.fmt(newest)}). "
                   f"Upgrade the engine.")
    elif state in ("unsupported", "malformed"):
        out.append("Its contract version cannot be served by this engine; check-kb says why.")

    mine = (gaps or {}).get(root, [])
    name = names.get(root)
    if mine and name:
        limit = sum(r["limit"] for r in mine)
        out.append(f"{len(mine)} kb-retrieve run(s) this week answered `fact not found`, costing "
                   f"{sum(r['tokens'] for r in mine)} new tokens" + (f" ({limit} hit the search limit)" if limit else "")
                   + f". Name each absent topic in the root `Not covered here:` line, or fill the gap: "
                   f"`kb-telemetry --not-found --library {name}` lists the questions.")
    return out


def main(argv) -> int:
    trees, out, i = [], None, 0
    while i < len(argv):
        if argv[i] == "--out":
            if i + 1 >= len(argv):
                print("kb-report: --out needs a directory", file=sys.stderr); return 2
            out = argv[i + 1]; i += 2; continue
        if argv[i].startswith("--"):
            print(__doc__.strip().split("\n\n")[-1], file=sys.stderr); return 2
        trees.append(pathlib.Path(argv[i])); i += 1
    try:
        kl = load_module("kb_libraries", "kb-libraries")
        attention.script("kb-verify"), attention.script("kb-sources")   # attention's readers: fail here, not per library
        mods = {"kb_telemetry": load_module("kb_telemetry", "kb-telemetry"), "kb_libraries": kl}
        packets = load_module("kb_apply", "kb-apply").pending()
    except Exception as e:
        print(f"kb-report: could not load the engine's readers ({type(e).__name__})", file=sys.stderr)
        return 2
    installed, consumed = {}, set()
    try:   # the registry's one reader; an unreadable registry must not stop the report (#204)
        installed = kl.installed()
        # A read-only library is curated by its publisher, so nothing in it is this machine's
        # decision (ADR-0020).
        consumed = {e["path"].resolve() for e in kl.entries() if e["read_only"]}
    except Exception as e:
        print(f"kb-report: library registry unreadable, registered libraries skipped: {e}", file=sys.stderr)
    if not trees:
        trees = list(installed.values())
    names = {}   # the registered name of each library, the first when it is registered twice
    for n, p in installed.items():
        names.setdefault(pathlib.Path(p).resolve(), n)
    registered = set(names)
    trees = [t for t in trees if t.resolve() not in consumed]

    dest_dir = reports_dir(out).resolve()
    for t in trees:
        if dest_dir == t.resolve() or t.resolve() in dest_dir.parents:
            print(f"kb-report: the report must be kept outside every library, not in {dest_dir}", file=sys.stderr)
            return 2

    sections, total, gaps = [], 0, not_found_week(mods)
    for t in trees:
        if not (t / "INDEX.md").is_file():
            continue
        try:
            att = attention.attention(t, packets, consumed)
            if attention.shelved(att, registered):   # a read-only archive cannot act on a decision (#141)
                continue
            items = decisions_for(att, names, gaps)
        except Exception as e:
            items = [f"Could not compute what needs a decision here ({type(e).__name__}). "
                     f"Run check-kb on the library to see why."]
        if items:
            total += len(items)
            sections.append(f"## {attention.label(t)}\n\n" + "\n".join(f"- {x}" for x in items) + "\n")

    now = datetime.datetime.now(datetime.timezone.utc)
    year, week, _ = now.date().isocalendar()
    name = f"{year}-W{week:02d}"
    text = (f"---\nreport: kb-decisions\nweek: {name}\ngenerated: {now.strftime('%Y-%m-%dT%H:%M:%SZ')}\n"
            f"decisions: {total}\n---\n\n# Knowledge base decisions, {name}\n\n")
    if total:
        text += (f"{total} decision(s) waiting across {len(sections)} library(ies). Paths, counts and "
                 f"headings only: open the file or packet named to see the text.\n\n" + "\n".join(sections))
    else:
        text += "Nothing needs a decision this week.\n"
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / f"{name}.md"
    tmp = dest.with_name(f".{dest.name}.tmp")
    tmp.write_text(text)
    os.replace(tmp, dest)
    print(f"kb-report: {total} decision(s) waiting; report written to {dest}")
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
