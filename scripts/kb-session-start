#!/usr/bin/env bash
# kb-session-start — SessionStart hook: resolve the knowledge engine and its libraries.
#
# Registered by kb-bootstrap, and it lives IN the engine so it is versioned with
# it: the engine is wherever this script is, so there is nothing to configure and
# nothing to drift. Behaviour and content are separate repositories:
#   engine     <engine>/            the contract, the tooling, the skills
#   libraries  anywhere             one repository per domain, each portable, installed by
#                                   being registered on this machine (ADR-0014, kb-library)
#
# Agents receive RESOLVED absolute paths: the Read tool does not expand
# environment variables, and its "file does not exist" error volunteers the
# working directory, which invites a relative retry that succeeds by coincidence
# in one workspace and breaks everywhere else.
#
# Absence is graceful at every level. No engine, no libraries, or neither — the
# session still starts, and says so.
#
# --subagent: the same context as a SubagentStart event, for kb-retrieve. A subagent never
# sees the SessionStart context, and without the engine path a retrieval agent searched
# whatever other knowledge tree its workspace held (issue #40). The librarian's nudge is
# left out: it is for the person's session, not for a retrieval.
set -uo pipefail

event=SessionStart
[ "${1:-}" = --subagent ] && event=SubagentStart

emit() {
  local ctx="$1" msg="${2:-}"
  esc() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "${s//$'\n'/\\n}"; }
  if [ -n "$msg" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"},"systemMessage":"%s"}\n' "$event" "$(esc "$ctx")" "$(esc "$msg")"
  else
    printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$event" "$(esc "$ctx")"
  fi
}

engine="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)"
if [ ! -r "$engine/CONVENTIONS.md" ]; then
  emit "Knowledge engine: UNRESOLVED. The session hook runs from ${engine}, but ${engine}/CONVENTIONS.md is not readable, so the contract cannot be loaded. Treat the engine as absent: warn and continue, never guess a path." \
       "No contract found under ${engine} — the knowledge engine is unavailable."
  exit 0
fi

# The libraries are the registered ones, wherever they live. A registered library that is not
# servable (moved, renamed, emptied) is named, never dropped: a library that silently vanishes
# turns every answer it held into a "fact not found" that looks correct.
libs=""; count=0; broken=""; nbroken=0
registry=$("$engine/scripts/kb-libraries" 2>&1) || registry="unreadable	$registry"
while IFS=$'\t' read -r state name path; do
  case "$state" in
    "") ;;
    ok) libs="${libs}
  - ${name} -> ${path}"; count=$((count+1)) ;;
    unreadable) broken="${broken}
  ! the library registry could not be read: ${name}"; nbroken=$((nbroken+1)) ;;
    *) broken="${broken}
  ! ${name}: ${state} at ${path}"; nbroken=$((nbroken+1)) ;;
  esac
done <<< "$registry"

# A machine set up before ADR-0014 installed libraries by putting them in <engine>/kb/. Until
# kb-bootstrap --apply registers them once, they are not installed — and saying nothing would turn
# every answer they hold into a silent "fact not found".
unmigrated=""
if [ "$(git config --file "$HOME/.config/ai-kb/libraries" --get kb.migrated 2>/dev/null)" != true ] \
   && ls "$engine"/kb/*/INDEX.md >/dev/null 2>&1; then
  unmigrated="
NOT YET MIGRATED: libraries sit in ${engine}/kb/ but this machine has not registered them, so they are not served. Tell the person to run kb-bootstrap --apply. Until then, say a library is unavailable rather than \"fact not found\"."
fi

if [ "$count" -eq 0 ] && [ -n "$unmigrated" ]; then
  libs="
  (none yet — see NOT YET MIGRATED below)"
elif [ "$count" -eq 0 ]; then
  libs="
  (none — no domain libraries are registered on this machine. Answer \"fact not found — check KB\" rather than answering from memory.)"
fi
if [ "$nbroken" -gt 0 ]; then
  broken="
Registered but NOT served — anything they hold is unavailable, so say so rather than \"fact not found\":${broken}
Fix with kb-library add <path> (moved), or kb-library remove <name>. For unsupported-contract, check-kb <path> names the contract versions this engine supports."
fi

# The libraries, plus this session's own project tree if it is in one.
proj=""
if root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f "$root/knowledge/INDEX.md" ]; then
  proj="$root/knowledge"
fi
due=""
[ "$event" = SessionStart ] && due=$("$engine/scripts/kb-due" ${proj:+"$proj"} --nudge 2>/dev/null || true)
[ -n "$due" ] && due="
Due for a librarian's attention — nothing printed here means nothing is due:
${due}"

msg=""
[ "$nbroken" -gt 0 ] && [ "$event" = SessionStart ] && \
  msg="${nbroken} registered knowledge librar$([ "$nbroken" -eq 1 ] && echo y || echo ies) not available — run kb-library list."
case "$registry" in unreadable*) [ "$event" = SessionStart ] && msg="The knowledge library registry could not be read — run kb-library list." ;; esac
[ -n "$unmigrated" ] && [ "$event" = SessionStart ] && msg="Knowledge libraries in ${engine}/kb/ are not registered yet — run kb-bootstrap --apply."
emit "Knowledge engine resolves to: ${engine}
Contract: ${engine}/CONVENTIONS.md — load it before curating or retrieving. Use these absolute paths directly with the Read tool; it does not expand \$KB_ENGINE_ROOT.
Domain libraries registered on this machine (${count}):${libs}${broken}${unmigrated}
Each library is its own repository and is self-contained: its facts, its sources, its evidence and its golden set travel together. A reference of the form repo:path (e.g. ai-kb:CONVENTIONS.md) names another repository and is not a filesystem path.${due}" "$msg"
