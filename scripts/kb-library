#!/usr/bin/env python3
"""kb-library — register, unregister and list the domain libraries on this machine (ADR-0014).

A library is installed by being registered, wherever it lives. Registering NEVER writes to the
library: it is one repository shared by people who do not own it. What `add` changes is this
machine's registry and the clone's own local git config (core.hooksPath, pointed at the
engine's library hook), which git never commits or clones.

  add <path>      register the library at <path> under the name its root INDEX.md declares
                  (domain:), and wire its clone to the engine's library hook. Re-adding the same
                  path is a no-op. A name already registered at another path is refused while
                  that path is still `ok`; if it is not (the library moved), the entry is updated.
  add <git-url> [--into DIR]
                  clone it into the library home (or DIR), then register it as above. Never
                  clones over an existing folder.
  add ... --read-only
                  register it as a consumer's copy of someone else's library (ADR-0020): served
                  as usual, but never curated here. The hook refuses commits in it, nothing writes
                  into it, and nothing nudges about it. Re-adding the same path with or without
                  the flag changes it.
  add <git-url> --read-only --ref <tag>
                  clone it at that release tag (a detached HEAD) and record the tag in the
                  registry, which `list` then shows. Refused, and nothing cloned, if the remote
                  has no such tag. --ref goes with --read-only: a copy at a tag can't take commits.
  add <path> --read-only --ref <tag>
                  record the tag for a copy already registered or cloned. It checks that the
                  clone's HEAD is at the tag and changes nothing if not. To move to a newer
                  release: check out the tag in the clone yourself, then re-add it with --ref.
                  Re-adding without --ref clears the recorded tag. `list` says so on the row if
                  the checkout is no longer at the tag.
  remove <name>   unregister, and unwire the hook if it points at this engine. Never deletes files.
  list            every registered library: state, name, path (see kb-libraries for the states).
  home            where new libraries are cloned: $KB_LIBRARY_HOME, else kb.libraryHome in the
                  registry (kb-bootstrap records it), else <engine>/kb.
  export          every registered library's name and origin, never its path (paths differ
                  between machines), in git-config format. A library with no origin is a comment.
                  A read-only library also gets `readOnly = true`, and a pinned one its `ref`.
  import <file> [--into DIR]
                  clone every library in an export that is not registered here into the library
                  home (or DIR), and register it. A name registered here with another origin is
                  reported and skipped, never overwritten. A library the export marks `readOnly`
                  is registered read-only, and one with a `ref` is cloned at that tag (and pinned
                  to it); a tag the remote no longer has refuses that library alone, and the rest
                  are still imported. An export without those keys imports as it always did.

When `add` registers a library, it compares the library's root `keywords:` and `tags:` with every
other registered library's, and warns when two overlap enough to blur routing (see OVERLAP below).
The warning is advice: it never refuses, never changes the exit status, and writes nothing.

The registry is read only through kb-libraries; this is the only thing that writes it.
Exit 0 on success, 1 on a refusal, 2 on a usage error.
"""
import importlib.machinery, importlib.util, pathlib, re, subprocess, sys, tempfile

ENGINE = pathlib.Path(__file__).resolve().parent.parent
HOOKS = ENGINE / "library-hooks"


def load_kb_libraries():
    path = pathlib.Path(__file__).resolve().parent / "kb-libraries"
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("kb_libraries", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


KL = load_kb_libraries()


# OVERLAP. Two libraries are neighbours when they share at least MIN_SHARED terms AND those terms
# are at least MIN_RATIO of the smaller library's terms. Terms are the normalized root keywords and
# tags (kb-libraries.declared_terms), minus each library's own domain name (every library lists
# itself) and GENERIC (words any library may carry). The count stops two short lists matching on
# one word; the ratio (overlap coefficient, shared / smaller set) is used rather than Jaccard
# because Jaccard hides a small library sitting inside a big neighbour's vocabulary, which is
# the pair routing confuses.
MIN_SHARED = 3
MIN_RATIO = 0.25
GENERIC = {"knowledge", "kb", "library", "doc", "documentation", "guide", "reference", "overview",
           "index", "general", "fact", "note", "topic"}


def link_count(path: pathlib.Path, lib: str) -> int:
    """[[lib:slug]] links in a library, outside code spans and fences, by check-xlinks' reader."""
    loader = importlib.machinery.SourceFileLoader("check_xlinks", str(ENGINE / "scripts" / "check-xlinks"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    xl = importlib.util.module_from_spec(spec)
    loader.exec_module(xl)
    return sum(1 for f in path.rglob("*.md") if not xl.NON_KB & set(f.relative_to(path).parts)
               for link, span in xl.links(f.read_text(errors="replace"))
               if not span and link.partition(":")[0] == lib and ":" in link)


def warn_dependencies(name: str, path: pathlib.Path, own: str, others: dict):
    """Warn when a dependency named in links_to (ADR-0020) is absent here or from another origin,
    both for the library being added and for registered libraries that link to it. Advice only."""
    for lib, expected in sorted(KL.links_to(path).items()):
        e = others.get(lib)
        n = link_count(path, lib)
        if not e or e["state"] != "ok":
            print(f"kb-library: warning: {name} links to {lib} ({n} link(s)), from {expected}, which is "
                  f"not registered here, so those links won't resolve: kb-library add {expected}")
        elif e["origin"] and not same_origin(expected, e["origin"]):
            print(f"kb-library: warning: dependency mismatch — {name} expects {lib} from {expected}, but "
                  f"{lib} here is from {e['origin']}: its {n} link(s) into {lib} won't resolve as written "
                  f"(check-xlinks --installed names them)")
    for other in sorted(others):
        e = others[other]
        if other == name or e["state"] != "ok":
            continue
        expected = KL.links_to(e["path"]).get(name)
        if expected and own and not same_origin(expected, own):
            print(f"kb-library: warning: dependency mismatch — {other} expects {name} from {expected}, "
                  f"but this {name} is from {own}: {other}'s {link_count(e['path'], name)} link(s) into "
                  f"{name} won't resolve as written (check-xlinks --installed names them)")


def terms_of(name: str, path: pathlib.Path) -> set:
    return KL.declared_terms(path) - GENERIC - {KL.normalize_term(name)}


def warn_overlap(name: str, path: pathlib.Path, others: dict):
    """Print a warning for each other registered library (state ok) whose terms overlap."""
    mine = terms_of(name, path)
    for other in sorted(others):
        if other == name or others[other]["state"] != "ok":
            continue
        theirs = terms_of(other, others[other]["path"])
        shared = sorted(mine & theirs)
        if len(shared) >= MIN_SHARED and len(shared) / min(len(mine), len(theirs)) >= MIN_RATIO:
            print(f"kb-library: warning: {name} overlaps {other} — {len(shared)} shared "
                  f"keywords/tags: {', '.join(shared)}")
            print("  Routing fails at the boundary between neighbouring libraries. Consider a "
                  "`Not covered here` line in each root INDEX.md naming the other, then re-run "
                  "the routing sample. Registered anyway.")


def git(*args, cwd=None):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)


_noted = []


def reg(*args):
    if not _noted:
        _noted.append(True)
        note = KL.linked_note("kb-library", KL.REGISTRY)
        if note:
            print(note, file=sys.stderr)
    KL.REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    r = git("config", "--file", str(KL.REGISTRY), *args)
    if r.returncode not in (0, 5):          # 5: unsetting something that is not set
        sys.exit(f"kb-library: cannot write {KL.REGISTRY}: {r.stderr.strip()}")


def is_repo(path: pathlib.Path) -> bool:
    top = git("rev-parse", "--show-toplevel", cwd=path)
    return top.returncode == 0 and pathlib.Path(top.stdout.strip()).resolve() == path


URL = re.compile(r"^[a-z][a-z0-9+.-]*://|^[\w.-]+@[\w.-]+:")


same_origin = KL.same_origin   # one comparison for import and the link checks (ADR-0020)


def clone(url: str, dest: pathlib.Path, branch=None):
    """Clone url into dest (at branch, a branch or tag, if given), a folder that must not exist
    yet. The clone path, or None."""
    if dest.exists():
        print(f"kb-library: {dest} already exists — not cloned over "
              f"(kb-library add {dest} registers what is there)")
        return None
    dest.parent.mkdir(parents=True, exist_ok=True)
    r = git("clone", "--quiet", *(["--branch", branch] if branch else []), url, str(dest))
    if r.returncode != 0:
        print(f"kb-library: cannot clone {url}: {r.stderr.strip()}")
        return None
    if not KL.declared_name(dest.resolve()):
        print(f"kb-library: cloned {url} to {dest}, but it is not a library (no root INDEX.md "
              f"declaring domain:) — nothing registered; delete {dest} if you do not want it")
        return None
    return dest


def tag_on_remote(url: str, ref: str) -> bool:
    """Whether url has tag ref; says why and returns False when it cannot tell or it has not."""
    r = git("ls-remote", "--tags", url, f"refs/tags/{ref}")
    if r.returncode != 0:
        print(f"kb-library: cannot read tags of {url}: {r.stderr.strip()} — nothing cloned"); return False
    if not r.stdout.strip():
        print(f"kb-library: {url} has no tag {ref} — nothing cloned"); return False
    return True


def add_url(url: str, into, read_only=False, ref="") -> int:
    if ref and not tag_on_remote(url, ref):
        return 1
    into = pathlib.Path(into).expanduser() if into else KL.library_home(ENGINE)
    name = re.sub(r"\.git$", "", url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1])
    path = clone(url, into / name, ref or None)
    if not path:
        return 1
    rc = add(str(path), read_only, ref)
    if rc:
        print(f"kb-library: the clone at {path} was left in place")
    return rc


def set_mode(name: str, read_only: bool) -> None:
    if read_only:
        reg(f"library.{name}.readOnly", "true")
    else:
        reg("--unset", f"library.{name}.readOnly")


def set_ref(name: str, ref: str) -> None:
    if ref:
        reg(f"library.{name}.ref", ref)
    else:
        reg("--unset", f"library.{name}.ref")


def head_of(path: pathlib.Path) -> str:
    """The commit the clone's HEAD is at, or ''."""
    return git("rev-parse", "--verify", "-q", "HEAD^{commit}", cwd=path).stdout.strip()


def tag_commit(path: pathlib.Path, ref: str) -> str:
    """The commit tag ref names in the clone, or ''."""
    return git("rev-parse", "--verify", "-q", f"refs/tags/{ref}^{{commit}}", cwd=path).stdout.strip()


def at_tag(path: pathlib.Path, ref: str) -> bool:
    """Whether --ref is true of the clone: refuses, saying what HEAD is, when it is not."""
    head, tag = head_of(path), tag_commit(path, ref)
    if tag and head == tag:
        return True
    if not tag:
        print(f"kb-library: {path} has no tag {ref} — fetch it (git fetch --tags) and check it out; "
              f"HEAD is {head[:12] or 'not a commit'}. Nothing changed")
    else:
        print(f"kb-library: HEAD of {path} is {head[:12] or 'not a commit'}, not {ref} ({tag[:12]}) — "
              f"check out {ref} first. Nothing changed")
    return False


def add(arg: str, read_only=False, ref="") -> int:
    path = pathlib.Path(arg).expanduser()
    if not path.is_dir():
        print(f"kb-library: {arg} is not a directory"); return 1
    path = path.resolve()
    name = KL.declared_name(path)
    if not (path / "INDEX.md").is_file():
        print(f"kb-library: {path} has no root INDEX.md — not a library"); return 1
    if not name:
        print(f"kb-library: {path}/INDEX.md declares no domain: — a library names itself there"); return 1

    if ref and not at_tag(path, ref):
        return 1
    current = {e["name"]: e for e in KL.entries()}
    old = current.get(name)
    if old and old["path"].resolve() == path:
        mode_changed, ref_changed = old.get("read_only") != read_only, old.get("ref", "") != ref
        if mode_changed:
            set_mode(name, read_only)
        if ref_changed:
            set_ref(name, ref)
        pin = f", pinned to {ref}" if ref else ""
        if mode_changed:
            print(f"kb-library: {name} at {path} is now "
                  + (f"read-only: served, never curated here{pin}" if read_only else "curated here"))
        elif ref_changed:
            print(f"kb-library: {name} at {path} is now pinned to {ref}" if ref
                  else f"kb-library: {name} at {path} is no longer pinned (was {old['ref']})")
        else:
            print(f"kb-library: {name} is already registered at {path}"
                  + (" (read-only" + (f", pinned to {ref}" if ref else "") + ")" if read_only else ""))
    elif old and old["state"] == "ok":
        print(f"kb-library: {name} is already registered at {old['path']}, which is still a "
              f"library — one name, one library. Remove it first: kb-library remove {name}")
        return 1
    else:
        # The same folder under another name: its library renamed itself (name-mismatch).
        for e in current.values():
            if e["name"] != name and e["path"].exists() and e["path"].resolve() == path:
                reg("--remove-section", f"library.{e['name']}")
                print(f"kb-library: unregistered {e['name']} — {path} now declares {name}")
        reg(f"library.{name}.path", str(path))
        set_mode(name, read_only)
        set_ref(name, ref)
        origin = git("remote", "get-url", "origin", cwd=path) if is_repo(path) else None
        if origin is not None and origin.returncode == 0 and origin.stdout.strip():
            reg(f"library.{name}.origin", origin.stdout.strip())
        else:
            reg("--unset", f"library.{name}.origin")
        print(f"kb-library: registered {name} at {path}"
              + (" read-only: served, never curated here" if read_only else "")
              + (f", pinned to {ref}" if ref else "")
              + (f" (was {old['state']} at {old['path']})" if old else ""))
        try:
            warn_overlap(name, path, current)
        except Exception as e:       # advice only: it must never change registration's outcome
            print(f"kb-library: overlap check skipped: {e}", file=sys.stderr)
        try:
            own = origin.stdout.strip() if origin is not None and origin.returncode == 0 else ""
            warn_dependencies(name, path, own, current)
        except Exception as e:       # advice too
            print(f"kb-library: dependency check skipped: {e}", file=sys.stderr)

    if is_repo(path):
        if git("config", "--get", "core.hooksPath", cwd=path).stdout.strip() != str(HOOKS):
            git("config", "core.hooksPath", str(HOOKS), cwd=path)
            print(f"kb-library: {name}'s pre-commit hook is the engine's ({HOOKS})")
    else:
        print(f"kb-library: {path} is not the root of a git repository — no hook wired")
    return 0


def remove(name: str) -> int:
    entry = {e["name"]: e for e in KL.entries()}.get(name)
    if not entry:
        print(f"kb-library: {name} is not registered"); return 1
    reg("--remove-section", f"library.{name}")
    path = entry["path"]
    if path.is_dir() and is_repo(path.resolve()) and \
            git("config", "--get", "core.hooksPath", cwd=path).stdout.strip() == str(HOOKS):
        git("config", "--unset", "core.hooksPath", cwd=path)
    print(f"kb-library: unregistered {name} — nothing at {path} was deleted")
    return 0


def export() -> int:
    rows = KL.entries()
    with tempfile.TemporaryDirectory() as d:
        out = pathlib.Path(d) / "export"
        out.touch()
        for e in rows:
            if e["origin"]:
                git("config", "--file", str(out), f"library.{e['name']}.origin", e["origin"])
                if e["read_only"]:
                    git("config", "--file", str(out), f"library.{e['name']}.readOnly", "true")
                if e["ref"]:
                    git("config", "--file", str(out), f"library.{e['name']}.ref", e["ref"])
        body = out.read_text()
    print("# kb-library export: name and origin of each library registered on a machine, and its read-only mode and pinned ref when it has them.")
    print("# Paths are left out, because they differ between machines. On another machine:")
    print("#   kb-library import <this file> [--into DIR]")
    for e in rows:
        if not e["origin"]:
            print(f"# {e['name']}: no origin (no git remote) — it cannot be reproduced elsewhere")
    print(body, end="")
    return 0


def import_(file: str, into) -> int:
    r = git("config", "--file", file, "--null", "--list")
    if r.returncode != 0:
        print(f"kb-library: cannot read {file}: {r.stderr.strip()}"); return 1
    wanted, modes, pins = {}, {}, {}
    for rec in r.stdout.split("\0"):
        key, _, value = rec.partition("\n")
        if key.startswith("library.") and key.endswith(".origin"):
            wanted[key[len("library."):-len(".origin")]] = value
        elif key.startswith("library.") and key.endswith(".readonly"):   # git lowercases the variable
            modes[key[len("library."):-len(".readonly")]] = value.lower() == "true"
        elif key.startswith("library.") and key.endswith(".ref"):
            pins[key[len("library."):-len(".ref")]] = value
    into = pathlib.Path(into).expanduser() if into else KL.library_home(ENGINE)
    current = {e["name"]: e for e in KL.entries()}
    done = already = refused = 0
    for name, url in sorted(wanted.items()):
        e = current.get(name)
        if e and same_origin(e["origin"], url):
            print(f"kb-library: {name} is already registered at {e['path']}"); already += 1
            continue
        if e:
            print(f"kb-library: {name} is already registered at {e['path']} from "
                  f"{e['origin'] or 'no origin'} — not imported from {url}"); refused += 1
            continue
        ref, read_only = pins.get(name, ""), modes.get(name, False)
        if ref and not read_only:
            print(f"kb-library: {name} is pinned to {ref} in the export but not read-only — "
                  f"a copy at a tag can't take commits; not imported"); refused += 1
            continue
        if ref and not tag_on_remote(url, ref):
            refused += 1
            continue
        path = clone(url, into / name, ref or None)
        if path and add(str(path), read_only, ref) == 0:
            done += 1
        else:
            refused += 1
    print(f"kb-library import: {done} registered, {already} already registered, "
          f"{refused} not imported")
    return 1 if refused else 0


def list_() -> int:
    rows = KL.entries()
    if not rows:
        print(f"kb-library: no libraries registered ({KL.REGISTRY})")
    for e in rows:
        mode = ""
        if e["read_only"]:
            mode = "  read-only"
            if e["ref"]:
                mode += f" @{e['ref']}"
                if e["path"].is_dir() and (not tag_commit(e["path"], e["ref"])
                                           or head_of(e["path"]) != tag_commit(e["path"], e["ref"])):
                    mode += f" (checkout moved: HEAD {head_of(e['path'])[:7] or 'unknown'})"
        print(f"  {e['state']:<14} {e['name']:<28} {e['path']}" + mode)
    return 0


def main(argv) -> int:
    read_only = "--read-only" in argv
    argv = [a for a in argv if a != "--read-only"]
    if read_only and argv[:1] != ["add"]:
        print("kb-library: --read-only goes with add", file=sys.stderr); return 2
    ref = ""
    if "--ref" in argv:
        i = argv.index("--ref")
        if argv[:1] != ["add"] or i + 1 >= len(argv) or argv[i + 1].startswith("-"):
            print("kb-library: --ref <tag> goes with add", file=sys.stderr); return 2
        ref, argv = argv[i + 1], argv[:i] + argv[i + 2:]
        if not read_only:
            print("kb-library: --ref goes with --read-only: a copy pinned to a tag can't take commits",
                  file=sys.stderr); return 2
    into = None
    if len(argv) == 4 and argv[2] == "--into":
        into, argv = argv[3], argv[:2]
    if argv[:1] == ["add"] and len(argv) == 2:
        if URL.match(argv[1]):
            return add_url(argv[1], into, read_only, ref)
        if into is None:
            return add(argv[1], read_only, ref)
    if argv[:1] == ["import"] and len(argv) == 2:
        return import_(argv[1], into)
    if into is None:
        if argv[:1] == ["remove"] and len(argv) == 2:
            return remove(argv[1])
        if argv == ["list"]:
            return list_()
        if argv == ["home"]:
            print(KL.library_home(ENGINE)); return 0
        if argv == ["export"]:
            return export()
    print("usage: kb-library add <path> | add <git-url> [--into DIR] [--read-only [--ref <tag>]] (<path> too) | remove <name> | list\n"
          "                  | home | export | import <file> [--into DIR]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
