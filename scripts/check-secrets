#!/usr/bin/env bash
# check-secrets — pattern scan for credential-shaped strings.
#
# Phase 0 guardrail. Patterns live in secret-patterns.txt beside this script.
#
#   check-secrets            scan files STAGED for commit (pre-commit mode)
#   check-secrets --worktree scan the working tree
#   check-secrets --all      scan every blob in full git history AND the worktree
#
# Exit 0 clean, 1 on any hit.
#
# Three passes per file: the patterns in secret-patterns.txt (known credential
# shapes), then scripts/secret-entropy (a heuristic for secret-labelled values and
# high-entropy tokens that have no recognisable shape), then scripts/pii-scan
# (email addresses, domain-qualified Windows accounts, user home-directory paths).
# Any pass blocks. Put `lint-allow: <reason>` on a line to clear a legitimate match
# from all three. Standing identifiers (role aliases, service accounts, team lists)
# go in scripts/pii-allowlist.txt instead, shared by every repo that runs this
# script. PII hits are labelled `PII?` and need no rotation: remove the identifier.
#
# LIMITS, stated plainly: this is a pattern scan plus a heuristic, not a dedicated
# secret scanner. The heuristic is tuned to keep false positives low, so it will
# still miss short, low-entropy or oddly-shaped secrets. It is the committer-side
# half of the guardrail only — a pre-commit hook is bypassable with --no-verify, so
# the enforcement boundary is the server-side gate (GitHub push protection). Both
# are required. The PII pass sees identifiers only: it cannot detect a personal
# NAME in prose — that is a human call at review.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATTERNS="$HERE/secret-patterns.txt"
[ -r "$PATTERNS" ] || { echo "check-secrets: cannot read $PATTERNS" >&2; exit 2; }

mode="${1:-staged}"
hits=0; secret_hits=0; pii_hits=0

# NOTE: findings are captured via command substitution, never by piping into a
# function. A pipeline component runs in a subshell, so a counter incremented
# there is discarded and the script would print findings while exiting 0 —
# a guardrail that warns and then lets the commit through.
findings() {  # $1 = file; prints up to 3 secret hit lines (patterns + entropy), minus lint-allow
  { grep -nEI -f "$PATTERNS" -- "$1" 2>/dev/null | grep -v 'lint-allow'
    "$HERE/secret-entropy" "$1"; } | head -3
}
pii() {  # $1 = file; prints up to 3 hit lines from scripts/pii-scan
  "$HERE/pii-scan" "$1"
}
report() {  # $1 = path, $2 = suffix, $3 = file to scan; sets $hits, prints findings
  local out
  out=$(findings "$3") || true
  if [ -n "$out" ]; then
    printf 'SECRET? %s%s\n' "$1" "$2"; printf '%s\n' "$out" | sed 's/^/        /'
    hits=$((hits+1)); secret_hits=$((secret_hits+1))
  fi
  out=$(pii "$3") || true
  if [ -n "$out" ]; then
    printf 'PII? %s%s\n' "$1" "$2"; printf '%s\n' "$out" | sed 's/^/        /'
    hits=$((hits+1)); pii_hits=$((pii_hits+1))
  fi
}
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT

scan() {  # $1 = label, stdin = content; prints findings, returns 1 if any
  local label="$1" out
  out=$(grep -nEI -f "$PATTERNS" 2>/dev/null | head -3) || true
  [ -z "$out" ] && return 0
  printf 'SECRET? %s\n' "$label"
  printf '%s\n' "$out" | sed 's/^/        /'
  return 1
}

case "$mode" in
  staged)
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      git show ":$path" > "$tmp" 2>/dev/null
      report "$path" " (staged)" "$tmp"
    done < <(git diff --cached --name-only --diff-filter=ACM)
    ;;
  --worktree)
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      [ -f "$path" ] || continue
      report "$path" "" "$path"
    done < <(git ls-files)
    ;;
  --all)
    while IFS= read -r line; do
      sha="${line%% *}"; path="${line#* }"
      [ "$(git cat-file -t "$sha" 2>/dev/null)" = blob ] || continue
      git cat-file -p "$sha" > "$tmp" 2>/dev/null
      report "$path" " (history $sha)" "$tmp"
    done < <(git rev-list --objects --all | awk 'NF==2')
    "$0" --worktree || hits=$((hits+1))
    ;;
  *) echo "usage: check-secrets [--worktree|--all]" >&2; exit 2 ;;
esac

if [ "$hits" -gt 0 ]; then
  echo
  echo "check-secrets: $hits finding(s). Nothing is committed."
  if [ "$secret_hits" -gt 0 ]; then
    echo "A real leak needs rotation AND history rewrite — rotation alone does not"
    echo "erase it from git history; every existing clone still holds it."
  fi
  if [ "$pii_hits" -gt 0 ]; then
    echo "PII? is a personal identifier, not a credential: no rotation needed. Remove it,"
    echo "or add \`lint-allow: <reason>\` to the line, or an entry in scripts/pii-allowlist.txt."
  fi
  exit 1
fi
echo "check-secrets: clean ($mode)"
