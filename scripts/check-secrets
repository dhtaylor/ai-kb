#!/usr/bin/env bash
# check-secrets — pattern scan for credential-shaped strings.
#
# Phase 0 guardrail. Patterns live in secret-patterns.txt beside this script.
#
#   check-secrets            scan files STAGED for commit (pre-commit mode)
#   check-secrets --worktree scan the working tree: tracked files AND untracked,
#                            non-ignored ones (retrieval reads the tree, tracked or not)
#   check-secrets --file PATH scan one file, the same three passes (kb-capture uses it)
#   check-secrets --all      scan every blob in full git history AND the worktree
#   check-secrets --redact   a FILTER, not a gate: stdin to stdout, every line any pass flags
#                            replaced by `[redacted: secret]` or `[redacted: personal identifier]`,
#                            a count on stderr, the matched text nowhere (#101). lint-allow exempts
#                            nothing here: in text being filtered it is just more input. Exit 0
#                            nothing redacted, 1 something was (stdout is still safe to keep), 2 the
#                            input could not be scanned (UTF-16, binary, a pass failed) and nothing
#                            was passed through, so a caller holds the input.
#
# Exit 0 clean, 1 on any hit.
#
# Three passes per file: the patterns in secret-patterns.txt (known credential
# shapes), then scripts/secret-entropy (a heuristic for secret-labelled values and
# high-entropy tokens that have no recognisable shape), then scripts/pii-scan
# (email addresses, domain-qualified Windows accounts, user home-directory paths).
# Any pass blocks. Put `lint-allow: <reason>` on a line to clear a legitimate match
# from all three. Standing identifiers (role aliases, service accounts, team lists)
# go in scripts/pii-allowlist.txt instead, shared by every repo that runs this
# script. PII hits are labelled `PII?` and need no rotation: remove the identifier.
#
# Two exceptions, both for raw artifacts archived as evidence (CONVENTIONS §6, issue #56):
#  - a non-.md file under documents/ in a LIBRARY repo (root INDEX.md declares `domain:`)
#    skips secret-entropy's bare rule, which flags its long identifiers on nearly every
#    line. The patterns, the labelled rule and PII still run on every line of it. In
#    --file mode the path is not resolved against a repo, so no file is exempt.
#  - UTF-16 text (it starts with a byte-order mark) reads as binary to every pass and so
#    would be skipped unseen. It is reported `UNSCANNED` and blocks until converted to UTF-8.
# A SECRET? finding shows its first three lines and says how many more there are.
#
# LIMITS, stated plainly: this is a pattern scan plus a heuristic, not a dedicated
# secret scanner. The heuristic is tuned to keep false positives low, so it will
# still miss short, low-entropy or oddly-shaped secrets. It is the committer-side
# half of the guardrail only — a pre-commit hook is bypassable with --no-verify, so
# the enforcement boundary is the server-side gate (GitHub push protection). Both
# are required. The PII pass sees identifiers only: it cannot detect a personal
# NAME in prose — that is a human call at review.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATTERNS="$HERE/secret-patterns.txt"
[ -r "$PATTERNS" ] || { echo "check-secrets: cannot read $PATTERNS" >&2; exit 2; }

mode="${1:-staged}"
hits=0; secret_hits=0; pii_hits=0; utf16_hits=0

# NOTE: findings are captured via command substitution, never by piping into a
# function. A pipeline component runs in a subshell, so a counter incremented
# there is discarded and the script would print findings while exiting 0 —
# a guardrail that warns and then lets the commit through.
findings() {  # $1 = file, $2 = optional secret-entropy flag; prints every secret hit line
  # (patterns + entropy) minus lint-allow, one per line number
  { grep -nEI -f "$PATTERNS" -- "$1" 2>/dev/null | grep -v 'lint-allow'
    "$HERE/secret-entropy" ${2:+"$2"} "$1"; } | sort -t: -k1,1n -u
}
show() {  # stdin = hit lines; prints the first three, then a count of the rest
  awk 'NR<=3 { print "        " $0 } END { if (NR>3) printf "        ... and %d more line(s)\n", NR-3 }'
}
# A library repo's root INDEX.md declares `domain:` in its frontmatter; the engine has none.
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=""
prefix=$(git rev-parse --show-prefix 2>/dev/null) || prefix=""
library=""
[ -n "$top" ] && [ -f "$top/INDEX.md" ] &&
  awk 'NR==1 && !/^---$/ {exit} NR>1 && /^---$/ {exit} /^domain:/ {f=1} END {exit !f}' "$top/INDEX.md" &&
  library=1
archived() {  # $1 = repo-relative path; true for a raw artifact archived in a library
  [ -n "$library" ] || return 1
  case "$1" in documents/*.md) return 1 ;; documents/*) return 0 ;; esac
  return 1
}
pii() {  # $1 = file; prints up to 3 hit lines from scripts/pii-scan
  "$HERE/pii-scan" "$1"
}
report() {  # $1 = path, $2 = suffix, $3 = file to scan, $4 = repo-relative path (empty
  # in --file mode); sets $hits, prints findings
  local out flag=""
  case "$(od -An -tx1 -N2 -- "$3" 2>/dev/null | tr -d ' \n')" in
    fffe|feff)
      printf 'UNSCANNED %s%s\n        UTF-16 text reads as binary and no pass can scan it\n' "$1" "$2"
      hits=$((hits+1)); utf16_hits=$((utf16_hits+1)); return ;;
  esac
  [ -n "${4:-}" ] && archived "$4" && flag=--no-bare
  out=$(findings "$3" "$flag") || true
  if [ -n "$out" ]; then
    printf 'SECRET? %s%s\n' "$1" "$2"; printf '%s\n' "$out" | show
    hits=$((hits+1)); secret_hits=$((secret_hits+1))
  fi
  out=$(pii "$3") || true
  if [ -n "$out" ]; then
    printf 'PII? %s%s\n' "$1" "$2"; printf '%s\n' "$out" | sed 's/^/        /'
    hits=$((hits+1)); pii_hits=$((pii_hits+1))
  fi
}
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT

scan() {  # $1 = label, stdin = content; prints findings, returns 1 if any
  local label="$1" out
  out=$(grep -nEI -f "$PATTERNS" 2>/dev/null | head -3) || true
  [ -z "$out" ] && return 0
  printf 'SECRET? %s\n' "$label"
  printf '%s\n' "$out" | sed 's/^/        /'
  return 1
}

redact_fail() { echo "check-secrets --redact: $1; nothing passed through" >&2; exit 2; }

case "$mode" in
  --redact)
    cat > "$tmp" || redact_fail "could not read standard input"
    case "$(od -An -tx1 -N2 -- "$tmp" 2>/dev/null | tr -d ' \n')" in
      fffe|feff) redact_fail "UTF-16 input cannot be scanned (convert it to UTF-8)" ;;
    esac
    [ "$(tr -d '\000' < "$tmp" | wc -c)" = "$(wc -c < "$tmp")" ] || redact_fail "binary input cannot be scanned"
    pat=$(grep -nE -f "$PATTERNS" -- "$tmp"); [ $? -le 1 ] || redact_fail "the pattern pass failed"
    ent=$("$HERE/secret-entropy" --redact "$tmp") || redact_fail "the entropy pass failed"
    per=$("$HERE/pii-scan" --redact "$tmp") || redact_fail "the personal-identifier pass failed"
    awk 'FILENAME == ARGV[1] { s[$1] = 1; next }
         FILENAME == ARGV[2] { p[$1] = 1; next }
         FNR in s { print "[redacted: secret]"; ns++; next }
         FNR in p { print "[redacted: personal identifier]"; np++; next }
         { print }
         END { printf "check-secrets --redact: %d line(s) redacted (%d secret, %d personal identifier)\n",
                      ns + np, ns, np > "/dev/stderr"
               exit (ns + np > 0) }' \
      <({ printf '%s\n' "$pat" | cut -d: -f1; printf '%s\n' "$ent"; } | grep -x '[0-9][0-9]*') \
      <(printf '%s\n' "$per" | grep -x '[0-9][0-9]*') "$tmp"
    exit $?
    ;;
  staged)
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      git show ":$path" > "$tmp" 2>/dev/null
      report "$path" " (staged)" "$tmp" "$path"
    done < <(git diff --cached --name-only --diff-filter=ACM)
    ;;
  --worktree)
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      [ -f "$path" ] || continue
      report "$path" "" "$path" "$prefix$path"
    done < <({ git ls-files; git ls-files -o --exclude-standard; } | sort -u)
    ;;
  --file)
    f="${2:-}"
    [ -f "$f" ] || { echo "check-secrets: --file needs a readable file: ${f:-<none>}" >&2; exit 2; }
    report "$f" "" "$f"
    ;;
  --all)
    while IFS= read -r line; do
      sha="${line%% *}"; path="${line#* }"
      [ "$(git cat-file -t "$sha" 2>/dev/null)" = blob ] || continue
      git cat-file -p "$sha" > "$tmp" 2>/dev/null
      report "$path" " (history $sha)" "$tmp" "$path"
    done < <(git rev-list --objects --all | awk 'NF==2')
    "$0" --worktree || hits=$((hits+1))
    ;;
  *) echo "usage: check-secrets [--worktree|--all|--file PATH|--redact]" >&2; exit 2 ;;
esac

if [ "$hits" -gt 0 ]; then
  echo
  if [ "$mode" = "--file" ]; then echo "check-secrets: $hits finding(s)."
  else echo "check-secrets: $hits finding(s). Nothing is committed."; fi
  # A single file has not touched git, so the history half of the advice does not apply.
  if [ "$secret_hits" -gt 0 ] && [ "$mode" = "--file" ]; then
    echo "If this is a live credential, rotate it at the source — it is live wherever"
    echo "it was copied from, whether or not this file is ever committed."
  elif [ "$secret_hits" -gt 0 ]; then
    echo "A real leak needs rotation AND history rewrite — rotation alone does not"
    echo "erase it from git history; every existing clone still holds it."
  fi
  if [ "$pii_hits" -gt 0 ]; then
    echo "PII? is a personal identifier, not a credential: no rotation needed. Remove it,"
    echo "or add \`lint-allow: <reason>\` to the line, or an entry in scripts/pii-allowlist.txt."
  fi
  if [ "$utf16_hits" -gt 0 ]; then
    echo "UNSCANNED is UTF-16 text, which no pass can read. Convert it to UTF-8 and rescan:"
    echo "iconv -f UTF-16 -t UTF-8 FILE > FILE.utf8 && mv FILE.utf8 FILE (CONVENTIONS §6)."
  fi
  exit 1
fi
echo "check-secrets: clean ($mode)"
