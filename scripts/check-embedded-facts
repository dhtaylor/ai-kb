#!/usr/bin/env python3
"""check-embedded-facts — the lock on "retrieve, don't embed".

The golden set is a fire alarm: an agent with an inlined schema still routes
correctly and passes every retrieval eval. This lint is what actually stops a
fact being frozen into the behavior layer.

Scans agent and command files (default: .claude/agents/, .claude/commands/) for
patterns that indicate an embedded fact rather than retrieved knowledge:

  * absolute filesystem paths  — CONVENTIONS §1: no file holds a literal KB path
  * IP addresses and host:port — environment-specific values
  * fully-qualified hostnames  — environment-specific values
  * credential shapes          — via secret-patterns.txt
  * bare numeric constants     — thresholds, ports, IDs (years excluded)

Escape hatch: put `lint-allow` in a comment on the line, with a reason.

HONEST LIMIT: identifier-level facts — a table name, a column, an enum value —
are not reliably machine-detectable and are NOT caught here. Those remain a
human review responsibility. This lint raises the floor; it is not the ceiling.

Usage: check-embedded-facts [path ...]
Exit 0 clean, 1 on any finding.
"""
import pathlib, re, sys

DEFAULT_DIRS = [".claude/agents", ".claude/commands"]

RULES = [
    ("absolute path",
     re.compile(r"(?<![\w.])(/(?:mnt|home|Users|opt|var|etc|srv|usr/local)/[\w./-]+|[A-Za-z]:\\\\[\w.\\\\-]+)")),
    ("ip address / host:port",
     re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}(?::\d{2,5})?\b")),
    ("fully-qualified hostname",
     re.compile(r"\b[a-z0-9-]+(?:\.[a-z0-9-]+){2,}\b(?<!\.md)(?<!\.py)(?<!\.sh)")),
    ("numeric constant",
     re.compile(r"(?<![\w.$-])(?!19\d{2}\b|20\d{2}\b)\d{4,}(?![\w.-])")),
]


def load_secret_rules(here: pathlib.Path):
    pf = here / "secret-patterns.txt"
    if not pf.is_file():
        return []
    pats = [ln.strip() for ln in pf.read_text().splitlines() if ln.strip()]
    return [("credential shape", re.compile(p)) for p in pats]


def targets(args):
    out = []
    for a in (args or DEFAULT_DIRS):
        p = pathlib.Path(a)
        if p.is_file():
            out.append(p)
        elif p.is_dir():
            out += [f for f in sorted(p.rglob("*")) if f.is_file() and f.suffix in {".md", ".txt", ""}]
    return out


def main(argv):
    here = pathlib.Path(__file__).resolve().parent
    rules = RULES + load_secret_rules(here)
    files = targets(argv[1:])
    findings = []
    in_fence = False
    for f in files:
        in_fence = False
        for n, line in enumerate(f.read_text(errors="replace").splitlines(), 1):
            if line.lstrip().startswith("```"):
                in_fence = not in_fence
                continue
            if in_fence or "lint-allow" in line:
                continue
            for label, rx in rules:
                m = rx.search(line)
                if m:
                    findings.append((f, n, label, m.group(0)[:60], line.strip()[:90]))
                    break
    for f, n, label, hit, line in findings:
        print(f"EMBEDDED-FACT {f}:{n}  [{label}]  {hit!r}")
        print(f"              {line}")
    scanned = f"{len(files)} file(s) scanned"
    if not files:
        print(f"check-embedded-facts: no agent/command files yet ({', '.join(argv[1:] or DEFAULT_DIRS)}) — nothing to check")
        return 0
    if findings:
        print(f"\ncheck-embedded-facts: {len(findings)} finding(s), {scanned}.")
        print("Facts belong in the KB and are retrieved at runtime. If a hit is a false")
        print("positive, add `lint-allow: <reason>` to the line.")
        return 1
    print(f"check-embedded-facts: clean ({scanned})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
