#!/usr/bin/env python3
"""grade-eval — the answer-grounding half of the retrieval eval.

check-golden proves the oracle is well-formed. This proves the AGENT is grounded:
it takes what an agent actually answered and verifies, by grep rather than by
judgement, that the expected excerpt appears in the answer AND in the file the
agent cited.

That conjunction is the whole point. An answer can be correct and ungrounded —
right substance, no file, or the wrong file — and that is a failure here, because
the claim under test is not "can it answer" but "did it retrieve". An LLM judge
would forgive it; grep does not.

An uncorroborated case also requires the answer to BEGIN "uncorroborated — single source": a
one-source fact is served caveat first (CONVENTIONS §8), and a caveat after the value is read past.

A record with `expected_evidence: check` requires the answer to say "carries a check"; `word`
requires "someone's word", ahead of the quoted fact (ADR-0022).

Answers file: one record per line,  Q<n>|<cited-files, comma-separated>|<answer text>
A cited file may be library-relative (x.md), library-prefixed (<lib>/x.md) or
kb-rooted (kb/<lib>/x.md); it is resolved to a file, not matched as text.

--transcripts grades subagent transcripts instead, through the mapping file grade-routing
reads: one record per line, Q<n>|<transcript>, a path relative to the mapping file or
absolute; # starts a comment. The answer is the message of the agent's SubagentHandback
call, or, in a transcript with none, its last text block: text written before a hand-back is
preamble, and grading it fails a correct answer (issue #32). The cited files are the answer's
last `Sources:` line, comma-separated; `Sources: none`, or no such line, cites nothing. A
note in parentheses on that line ("(reached via INDEX.md)") names no file the answer rests
on, and is dropped.
Only mapped cases are graded, as in grade-routing: a run is sampled.

Usage: grade-eval <library-root> <answers-file>
       grade-eval <library-root> --transcripts <mapping-file>
Exit 0 if every record passes, 1 otherwise, 2 on a usage error.
"""
import pathlib, sys

from kbengine import golden, transcripts


def main(lib: pathlib.Path, answers_file: pathlib.Path, by_transcript: bool = False) -> int:
    try:
        recs = golden.load(lib)
    except golden.NoGoldenSet as e:
        print(f"grade-eval: {e}", file=sys.stderr); sys.exit(2)
    answers = {}
    if by_transcript:
        try:
            mapped = golden.read_mapping(answers_file, len(recs))
        except ValueError as e:
            print(f"grade-eval: {e}", file=sys.stderr); return 2
        for n, t in mapped.items():
            answers[f"Q{n}"] = transcripts.transcript_answer(t) or "no answer in the transcript"
    else:
        for line in answers_file.read_text().splitlines():
            if not line.strip() or "|" not in line: continue
            parts = line.split("|", 2)
            if len(parts) < 3:               # the agent dropped a field: fail that record, not the run
                answers[parts[0].strip()] = "malformed record — expected Q<n>|<cited>|<answer>"; continue
            q, f, a = parts
            answers[q.strip()] = (f.strip(), a)

    rows, npass, ngraded = [], 0, 0
    for i, r in enumerate(recs, 1):
        q = f"Q{i}"
        if by_transcript and q not in answers:
            continue
        ngraded += 1
        case = r.get("case", "?")
        if q not in answers:
            rows.append((q, case, "-", "-", "NO ANSWER")); continue
        if isinstance(answers[q], str):
            rows.append((q, case, "-", "-", "FAIL: " + answers[q])); continue
        v = golden.grade(lib, r, *answers[q])
        npass += v.passed
        rows.append((q, case, "yes" if v.grounded else "no", "yes" if v.cited_ok else "no",
                     "PASS" if v.passed else "FAIL: " + "; ".join(v.reasons)))

    print(f"{'':5}{'case':11}{'grounded':10}{'cited ok':10}verdict")
    print("-" * 78)
    for q, case, g, c, v in rows:
        print(f"{q:5}{case + ' ':11}{g:10}{c:10}{v}")
    print("-" * 78)
    print(f"answer-grounding: {npass}/{ngraded} passed")
    return 0 if npass == ngraded else 1


if __name__ == "__main__":
    args = sys.argv[1:]
    by_transcript = args[1:2] == ["--transcripts"]
    if by_transcript:
        del args[1]
    if len(args) != 2:
        print("usage: grade-eval <library-root> <answers-file>\n"
              "       grade-eval <library-root> --transcripts <mapping-file>", file=sys.stderr); sys.exit(2)
    sys.exit(main(pathlib.Path(args[0]), pathlib.Path(args[1]), by_transcript))
