#!/usr/bin/env python3
"""grade-eval — the answer-grounding half of the retrieval eval.

check-golden proves the oracle is well-formed. This proves the AGENT is grounded:
it takes what an agent actually answered and verifies, by grep rather than by
judgement, that the expected excerpt appears in the answer AND in the file the
agent cited.

That conjunction is the whole point. An answer can be correct and ungrounded —
right substance, no file, or the wrong file — and that is a failure here, because
the claim under test is not "can it answer" but "did it retrieve". An LLM judge
would forgive it; grep does not.

Answers file: one record per line,  Q<n>|<cited-files, comma-separated>|<answer text>
A cited file may be library-relative (x.md), library-prefixed (<lib>/x.md) or
kb-rooted (kb/<lib>/x.md); it is resolved to a file, not matched as text.

Usage: grade-eval <library-root> <answers-file>
Exit 0 if every record passes, 1 otherwise.
"""
import functools, importlib.machinery, importlib.util, pathlib, re, sys


def load_golden(lib: pathlib.Path):
    gs = sorted(lib.glob("*-golden.md"))
    if not gs:
        print(f"grade-eval: no golden set in {lib}", file=sys.stderr); sys.exit(2)
    recs, cur = [], None
    for line in gs[0].read_text().splitlines():
        s = line.strip()
        m = re.match(r"^-\s+case:\s*(\S+)", s)
        if m:
            if cur: recs.append(cur)
            cur = {"case": m.group(1)}
        elif cur is not None:
            kv = re.match(r'^(question|expected_file|expected_excerpt|alt_excerpt):\s*"?(.*?)"?\s*$', s)
            if kv and kv.group(1) == "alt_excerpt": cur.setdefault("alt_excerpt", []).append(kv.group(2))
            elif kv: cur[kv.group(1)] = kv.group(2)
    if cur: recs.append(cur)
    return recs


@functools.lru_cache(maxsize=None)
def installed():
    """{name: root} of the libraries registered on this machine (ADR-0014), read through
    kb-libraries, the registry's one reader."""
    path = pathlib.Path(__file__).resolve().parent / "kb-libraries"
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("kb_libraries", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod.installed(), mod.declared_name


def library_root(lib: pathlib.Path, name: str):
    """The root of the library called `name`: the library being graded, if that is the name it
    declares, else the registered one, else None (not installed on this machine)."""
    libs, declared = installed()
    lib = lib.resolve()
    return lib if declared(lib) == name else libs.get(name)


def expected_target(lib: pathlib.Path, expected: str):
    """(library root, path within it) of the file a golden record's expected_file names. A
    cross-root case may name a file in another installed library as <library>:<path> (issue
    #36); anything else is a path in the case's own library. The root is None when the named
    library is not installed on this machine."""
    m = re.fullmatch(r"([\w-]+):(.+)", expected)
    return (library_root(lib, m.group(1)), m.group(2)) if m else (lib.resolve(), expected)


def candidates(lib: pathlib.Path, cited: str):
    """Every file a cited path may name. An agent cites by whatever path it walked:
    library-relative (x.md), library-prefixed (<lib>/x.md), kb-rooted (kb/<lib>/x.md) or
    absolute. A library prefix resolves through the registry, wherever that library lives;
    the rest resolve against the library, its parent and its grandparent."""
    lib = lib.resolve()          # "." has no parent to anchor on until it is resolved
    p = pathlib.Path(cited)
    out = [a / p for a in (lib, lib.parent, lib.parent.parent)]
    parts = p.parts[1:] if p.parts[:1] == ("kb",) else p.parts
    if len(parts) > 1 and (root := library_root(lib, parts[0])):
        out.append(root.joinpath(*parts[1:]))
    return out


def resolves_to(lib: pathlib.Path, expected: str, cited) -> bool:
    """True if any cited path names the expected file. Each is RESOLVED and compared as a
    file — never matched as a suffix, which would let a same-named file in another library
    pass."""
    owner, rel = expected_target(lib, expected)
    if owner is None:
        return False
    want = (owner / rel).resolve()
    return any(f.resolve() == want for c in cited for f in candidates(lib, c))


def main(lib: pathlib.Path, answers_file: pathlib.Path) -> int:
    recs = load_golden(lib)
    answers = {}
    for line in answers_file.read_text().splitlines():
        if not line.strip() or "|" not in line: continue
        parts = line.split("|", 2)
        if len(parts) < 3:               # the agent dropped a field: fail that record, not the run
            answers[parts[0].strip()] = None; continue
        q, f, a = parts
        answers[q.strip()] = (f.strip(), a)

    # Whitespace, case and QUOTE CHARACTERS are not grounding. An agent quoting a
    # quotation escapes it (\"), nests it as '…', or gets curly quotes from a
    # renderer; the words are unchanged. Every quote character folds to one.
    QUOTES = str.maketrans({c: '"' for c in "'“”„‟″‘’‚‛′"})
    norm = lambda s: re.sub(r"\s+", " ", s.replace('\\"', '"').replace("\\'", "'")
                            .translate(QUOTES)).strip().lower()
    rows, npass = [], 0
    for i, r in enumerate(recs, 1):
        q = f"Q{i}"
        case = r.get("case", "?")
        exc  = r.get("expected_excerpt", "")
        ef   = r.get("expected_file", "")
        if q not in answers:
            rows.append((q, case, "-", "-", "NO ANSWER")); continue
        if answers[q] is None:
            rows.append((q, case, "-", "-", "FAIL: malformed record — expected Q<n>|<cited>|<answer>")); continue
        cited, ans = answers[q]

        # A quote may stop before the sentence's full stop; the excerpt's trailing
        # punctuation is not part of what it proves.
        # A fact the file states twice may be quoted from either sentence (alt_excerpt).
        excerpts  = [exc] + r.get("alt_excerpt", [])
        in_answer = any(norm(e).rstrip('.!?;:,"') in norm(ans) for e in excerpts)
        # An answer may legitimately cite SEVERAL files — a cross-library question is
        # answered from two, and the contract requires citing every file used. So the
        # expected file must be AMONG those cited, not the only one. Demanding an exact
        # match would fail the very case the contract tells the agent to produce.
        cited_set = {c.strip() for c in cited.split(",") if c.strip()}
        file_ok   = (resolves_to(lib, ef, cited_set)) if ef else (not cited_set)
        in_file   = True
        if ef:
            owner, rel = expected_target(lib, ef)
            target = owner / rel if owner else None
            # An unresolved case's excerpt is the refusal phrase, in no fact file; its file
            # must instead still hold the dispute. Every other excerpt must be in its file.
            probes  = ["status: conflicted"] if case == "unresolved" else [norm(e) for e in excerpts]
            in_file = target is not None and target.is_file() and all(pr in norm(target.read_text()) for pr in probes)

        ok = in_answer and file_ok and in_file
        npass += ok
        why = []
        if not in_answer: why.append("excerpt not in answer")
        if not file_ok:   why.append(f"cited {cited or '(none)'!r}, expected {ef or '(none)'!r}")
        if not in_file:   why.append("excerpt not in the expected file — ORACLE ROT")
        rows.append((q, case, "yes" if in_answer else "no", "yes" if file_ok else "no",
                     "PASS" if ok else "FAIL: " + "; ".join(why)))

    print(f"{'':5}{'case':11}{'grounded':10}{'cited ok':10}verdict")
    print("-" * 78)
    for q, case, g, c, v in rows:
        print(f"{q:5}{case:11}{g:10}{c:10}{v}")
    print("-" * 78)
    print(f"answer-grounding: {npass}/{len(recs)} passed")
    return 0 if npass == len(recs) else 1


if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("usage: grade-eval <library-root> <answers-file>", file=sys.stderr); sys.exit(2)
    sys.exit(main(pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])))
