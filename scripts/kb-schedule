#!/usr/bin/env python3
"""kb-schedule — the opt-in weekly job that keeps libraries current (ADR-0017, #103).

Nothing runs unless the user installs it. `install` writes a systemd user timer that runs on Monday
at 07:00 and catches up a missed week at the next start (Persistent=true), or a crontab line where
there is no systemd. `remove` takes it all out again.

The job, `kb-schedule run`, does for every registered library, in order:

  1. detection, which only ever queues: kb-verify --yes --unattended (assertions that need no
     person, run with no inherited credentials) and kb-sources --yes;
  2. preparation, only if chosen at install (`--prepare`), because it is a model run that costs
     money: kb-prepare distill and kb-prepare audit, each under the dollar cap chosen;

then, once: check-xlinks --installed, kb-watch on the allowlist chosen at install, and kb-report,
the weekly report of decisions. No fact is edited: every step queues, drafts or reports.

The log, ${XDG_STATE_HOME:-~/.local/state}/ai-kb/schedule.log, records each step's exit code and
nothing a step printed, so it never holds a fact's or a source's text. A run that finds another
still holding the lock does nothing.

Usage: kb-schedule install [--backend systemd|cron] [--prepare] [--budget-usd N] [--claude PATH]
                           [--watch ALLOWLIST|none]
       kb-schedule status | remove | run
  --prepare       also draft review packets with a headless, read-only model run (default: off)
  --budget-usd N  the dollar cap per model run (default 1.00)
  --claude PATH   the claude binary to run (default: the one on PATH now)
  --watch FILE    the kb-watch allowlist (default: the engine's watcher/allowlist.json, if any)
status exits 0 installed, 1 not installed. run exits 0 when every step ran (findings included), 2
when a step could not run. install and remove exit 0, or 2 on a usage or system error.
"""
import datetime, fcntl, os, pathlib, shutil, subprocess, sys

ENGINE = pathlib.Path(__file__).resolve().parent.parent
SCRIPTS = ENGINE / "scripts"
UNIT = "ai-kb-schedule"
MARK = "# ai-kb-schedule"
HOME = pathlib.Path.home()
CONFIG_HOME = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "ai-kb"
CONF = CONFIG_HOME / "ai-kb" / "schedule.conf"
UNIT_DIR = CONFIG_HOME / "systemd" / "user"
LOG = STATE / "schedule.log"
SYSTEMCTL = os.environ.get("KB_SYSTEMCTL", "systemctl")
CRONTAB = os.environ.get("KB_CRONTAB", "crontab")


def say(msg):
    print(f"kb-schedule: {msg}")


def fail(msg) -> int:
    print(f"kb-schedule: {msg}", file=sys.stderr)
    return 2


def read_conf() -> dict:
    if not CONF.is_file():
        return {}
    return dict(l.split("=", 1) for l in CONF.read_text().splitlines() if "=" in l)


def systemctl(*args) -> int:
    return subprocess.run([SYSTEMCTL, "--user", *args], capture_output=True).returncode


def has_systemd() -> bool:
    try:
        r = subprocess.run([SYSTEMCTL, "--user", "is-system-running"], capture_output=True, text=True)
    except OSError:
        return False
    return r.stdout.strip() in ("running", "degraded")


def cron_lines() -> list:
    r = subprocess.run([CRONTAB, "-l"], capture_output=True, text=True)
    return r.stdout.splitlines() if r.returncode == 0 else []


def cron_write(lines: list) -> int:
    return subprocess.run([CRONTAB, "-"], input="".join(l + "\n" for l in lines), text=True).returncode


def exec_line() -> str:
    cmd = str(SCRIPTS / "kb-schedule")
    return (f'"{cmd}"' if " " in cmd else cmd) + " run"


def uninstall(backend: str):
    if backend == "systemd":
        systemctl("disable", "--now", f"{UNIT}.timer")
        for ext in ("timer", "service"):
            (UNIT_DIR / f"{UNIT}.{ext}").unlink(missing_ok=True)
        systemctl("daemon-reload")
    elif backend == "cron":
        cron_write([l for l in cron_lines() if MARK not in l])


def install(opts: dict) -> int:
    backend = opts.get("--backend") or ("systemd" if has_systemd() else "cron")
    if backend not in ("systemd", "cron"):
        return fail(f"unknown backend {backend}: use systemd or cron")
    prepare = "--prepare" in opts
    claude = opts.get("--claude") or os.environ.get("KB_CLAUDE") or shutil.which("claude") or ""
    if prepare and not claude:
        return fail("--prepare needs claude: pass --claude PATH")
    budget = opts.get("--budget-usd", "1.00")
    try:
        if float(budget) <= 0:
            raise ValueError
    except ValueError:
        return fail("--budget-usd needs a positive amount")
    watch = opts.get("--watch")
    if watch is None:
        default = ENGINE / "watcher" / "allowlist.json"
        watch = str(default) if default.is_file() else "none"
    elif watch != "none":
        watch = str(pathlib.Path(watch).resolve())

    previous = read_conf().get("backend")
    if previous:
        uninstall(previous)

    if backend == "systemd":
        UNIT_DIR.mkdir(parents=True, exist_ok=True)
        (UNIT_DIR / f"{UNIT}.service").write_text(
            "[Unit]\nDescription=ai-kb weekly upkeep: detection, preparation and the decisions report\n\n"
            f"[Service]\nType=oneshot\nExecStart={exec_line()}\n")
        (UNIT_DIR / f"{UNIT}.timer").write_text(
            "[Unit]\nDescription=Run ai-kb weekly upkeep every Monday morning\n\n"
            "[Timer]\nOnCalendar=Mon *-*-* 07:00:00\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n")
        if systemctl("daemon-reload") != 0 or systemctl("enable", "--now", f"{UNIT}.timer") != 0:
            return fail("systemctl --user could not enable the timer")
    else:
        lines = [l for l in cron_lines() if MARK not in l]
        lines.append(f"0 7 * * 1 {exec_line()} >/dev/null 2>&1 {MARK}")
        if cron_write(lines) != 0:
            return fail("crontab could not be written")

    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(f"backend={backend}\nprepare={'yes' if prepare else 'no'}\nbudget_usd={budget}\n"
                    f"claude={claude}\nwatch={watch}\n")
    say(f"installed ({backend}, Mondays 07:00; preparation {'on, capped at $' + budget + ' a run' if prepare else 'off'}). "
        f"It queues, drafts and reports; it never edits a fact.")
    if backend == "systemd":
        r = subprocess.run(["loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger"],
                           capture_output=True, text=True)
        if "Linger=yes" not in r.stdout:
            say('note: without lingering, the timer runs only while you are logged in, and a missed '
                'week runs at your next login. `loginctl enable-linger "$USER"` lets it run while you '
                'are not. (Under WSL the distribution itself still stops when idle; a missed week then '
                'runs at its next start.)')
    return 0


def remove() -> int:
    conf = read_conf()
    if not conf:
        say("not installed; nothing to remove")
        return 0
    uninstall(conf.get("backend", ""))
    CONF.unlink(missing_ok=True)
    say(f"removed ({conf.get('backend')}); review packets and reports already written are kept")
    return 0


def status() -> int:
    conf = read_conf()
    if not conf:
        say("not installed. `kb-schedule install` sets up the weekly job.")
        return 1
    say(f"installed ({conf.get('backend')}), preparation {'on' if conf.get('prepare') == 'yes' else 'off'}")
    if conf.get("backend") == "systemd":
        r = subprocess.run([SYSTEMCTL, "--user", "list-timers", f"{UNIT}.timer", "--no-pager"],
                           capture_output=True, text=True)
        nxt = next((l for l in r.stdout.splitlines() if UNIT in l), None)
        if nxt:
            print(f"  next run: {nxt.split(UNIT)[0].strip()}")
    last = [l for l in LOG.read_text().splitlines() if "run finished" in l] if LOG.is_file() else []
    print(f"  last run: {last[-1]}" if last else "  last run: none yet")
    return 0


def run() -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "schedule.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        say("already running; this run does nothing")
        return 0
    conf = read_conf()
    log = open(LOG, "a")

    def note(text):
        log.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} {text}\n"); log.flush()

    def step(label, cmd, timeout=900):
        try:
            rc = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, timeout=timeout).returncode
        except (OSError, subprocess.TimeoutExpired):
            rc = 2
        note(f"{label} exit={rc}")
        return rc

    note("run started")
    try:
        libs = subprocess.run([str(SCRIPTS / "kb-libraries")], capture_output=True, text=True).stdout
    except OSError:
        libs = ""
    rcs = []
    for line in libs.splitlines():
        state, name, path = (line.split("\t") + ["", "", ""])[:3]
        if state != "ok":
            continue
        rcs.append(step(f"kb-verify {name}", [str(SCRIPTS / "kb-verify"), path, "--yes", "--unattended"]))
        rcs.append(step(f"kb-sources {name}", [str(SCRIPTS / "kb-sources"), path, "--yes"]))
        if conf.get("prepare") == "yes":
            for skill in ("distill", "audit"):
                rcs.append(step(f"kb-prepare {skill} {name}",
                                [str(SCRIPTS / "kb-prepare"), skill, path, "--claude", conf.get("claude", ""),
                                 "--budget-usd", conf.get("budget_usd", "1.00")], timeout=1800))
    rcs.append(step("check-xlinks", [str(SCRIPTS / "check-xlinks"), "--installed"]))
    if conf.get("watch", "none") != "none":
        rcs.append(step("kb-watch", [str(SCRIPTS / "kb-watch"), conf["watch"]]))
    rcs.append(step("kb-report", [str(SCRIPTS / "kb-report")]))
    failed = sum(1 for r in rcs if r not in (0, 1))
    note(f"run finished: {len(rcs)} step(s), {sum(1 for r in rcs if r == 1)} with findings, {failed} could not run")
    return 2 if failed else 0


def main(argv) -> int:
    if not argv or argv[0] not in ("install", "status", "remove", "run"):
        print(__doc__.strip().split("\n\n")[-1], file=sys.stderr)
        return 2
    if argv[0] != "install":
        if len(argv) != 1:
            return fail(f"{argv[0]} takes no options")
        return {"status": status, "remove": remove, "run": run}[argv[0]]()
    opts, i = {}, 1
    while i < len(argv):
        a = argv[i]
        if a in ("--backend", "--budget-usd", "--claude", "--watch") and i + 1 < len(argv):
            opts[a] = argv[i + 1]; i += 2
        elif a == "--prepare":
            opts[a] = True; i += 1
        else:
            return fail(f"unknown option {a}")
    return install(opts)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
