#!/usr/bin/env python3
"""kb-due — which knowledge trees are due for a hygiene sweep, and (with --nudge) everything
else a librarian should act on.

A cadence nobody is reminded of is a preference, not a cadence. The sweep itself
(`kb-audit`) needs an agent and cannot be automated, so the machinery is only this:
record when each tree was last swept, work out when it is due, and say so where an
agent is already standing — the session-start hook calls this.

WHAT IT READS, from each tree's INDEX.md:
  last_swept: YYYY-MM-DD    written by kb-audit when it finishes a sweep. It lives
                            here and not in needs-attention.md because a CLEAN sweep
                            writes no queue file at all, and would erase the only
                            evidence it had run.
  sweep_interval: <N>d      how long a sweep stays good for. Explicit, not derived
                            from freshness_horizon: a 90d horizon would imply a 9d
                            nag and a 14d project a 1.4d one, surprising in both
                            directions. Default when absent: 30d.

SILENCE IS THE POINT. Nothing due prints nothing (exit 0) in --quiet or --nudge: a
reminder that fires every session is ignored by the time it matters.

--NUDGE (Phase 5): the owner's cadence decision for kb-audit AND kb-distill is "surfaced
when due, never run unattended" — one nudge, not two. --quiet's sweep-only report is kept
exactly as it was (every current caller of --quiet is unaffected); --nudge is additive and
reports, per tree, everything a librarian should act on:

  1. sweep due            — --quiet's own check, unchanged.
  2. facts due for recheck — reuses kb-verify's own staleness selection (its horizon/agent-TTL
                             test and its verifier_budget cap) by importing scripts/kb-verify
                             as a module, exactly the way kb-verify itself imports scripts/kb-watch
                             (SourceFileLoader, sys.dont_write_bytecode = True) — one judgment of
                             "is this section due", not two copies of it that can drift apart.
                             Only a count and the command (`kb-verify <path> --yes`) are
                             printed; no assertion is ever run or even read here.
  3. open queue items      — `status: open` records in the library's needs-attention.md, read
                             with kb-watch's own `parse_records` (also imported, not re-specified)
                             so a third copy of "what a queue record looks like" never exists.
  4. episodic notes awaiting distillation — a note kb-distill has distilled carries a heading
                             beginning "## Distill" (kb-distill Step 5 now names "## Distilled";
                             older notes say "## Distillation record", which the same prefix
                             matches). A note without one is counted.
  5. unstamped sources     — Source: lines with no Verified: stamp of their own, in sections that
                             are not CONFLICTED, read with check-kb's own section reader (the one
                             its verified: floor uses). Counted per source, since §6 stacks one
                             stamp per source (issue #64). §7 ranks unknown ahead of stale, and
                             until now only a sweep surfaced them (issue #29).
  6. stale, no assertion   — stamped sections past the horizon or agent TTL that carry no
                             Recheck:, by kb-verify's own is_due(). kb-verify cannot settle them,
                             so they are told apart from category 2, and the budget does not cap
                             them (issue #63).

  A tree with nothing due in any of the six contributes no line at all. A failure computing one
  category for one tree (a malformed needs-attention.md, an INDEX.md with no freshness_horizon) is
  printed as a one-line warning to stderr and that category is skipped for that tree only — every
  other tree and every other category still gets computed. This hook must never crash a session.

--SUMMARY (with --nudge, issue #79): also print, as the LAST line, the same nudge condensed to one
line beginning "KB due — ", for the session-start hook to show the person (a systemMessage),
while the full nudge above it goes to the model. One run gives both, so the two cannot disagree.

Usage: kb-due [tree ...] [--quiet|--nudge [--summary]]
  Scans every library registered on this machine (ADR-0014; kb-library list) plus any further
  trees given (a project knowledge/ tree).
  --quiet   print only overdue trees, and nothing at all when none are (sweep only)
  --nudge   print the full librarian nudge (review packets + sweep + recheck + queue + episodic + unstamped + stale), and
            nothing at all when nothing in any category is due
Exit 0 always: being due is a nudge, never a failure.
"""
import datetime, importlib.machinery, importlib.util, pathlib, re, shlex, sys

DEFAULT_INTERVAL = 30
TODAY = datetime.date.today()


def field(text, name):
    m = re.search(rf"^{name}:\s*(\S+)\s*(?:\s#.*)?$", text, re.M)   # a trailing YAML comment is allowed
    return m.group(1) if m else None


def label(tree: pathlib.Path):
    """A project tree is always called knowledge/; name it after the project instead."""
    return tree.parent.resolve().name if tree.name == "knowledge" else tree.name


def status(tree: pathlib.Path):
    idx = tree / "INDEX.md"
    if not idx.is_file():
        return None
    text = idx.read_text(errors="replace")
    interval = field(text, "sweep_interval") or f"{DEFAULT_INTERVAL}d"
    days = int(re.sub(r"\D", "", interval) or DEFAULT_INTERVAL)
    swept = field(text, "last_swept")
    if swept in (None, "never"):
        return {"tree": tree, "age": None, "interval": days, "due": True}
    try:
        age = (TODAY - datetime.date.fromisoformat(swept)).days
    except ValueError:
        return {"tree": tree, "age": None, "interval": days, "due": True}
    return {"tree": tree, "age": age, "interval": days, "due": age > days}


# -------------------------------------------------------------------- --nudge ----
def load_module(name: str, filename: str):
    """Import an extensionless sibling script as a module, byte-identical to the file on
    disk — not a copy. Same pattern kb-verify already uses to import kb-watch: no .py
    suffix means spec_from_file_location can't infer a loader from the extension, so an
    explicit SourceFileLoader is required, and bytecode caching is turned off first so an
    engine script that only ever reads these trees doesn't litter scripts/__pycache__."""
    path = pathlib.Path(__file__).resolve().parent / filename
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def recheck_due(root: pathlib.Path, kb_verify):
    """The exact set kb-verify would run by default, with --yes, right now: due_sections()
    reuses kb-verify's own is_due() (horizon / agent-TTL test, §7), capped at its
    verifier_budget. Returns None (not zero) when the tree declares no freshness_horizon —
    that is not an overdue count of zero, it is "not computable", and the two must not read
    the same in the nudge."""
    horizon, budget = kb_verify.horizon_and_budget(root)
    if horizon is None:
        return None
    budget = budget or 5
    due, _found, _with_cmd = kb_verify.due_sections(root, horizon, kb_verify.agent_ttl(root, horizon))
    return due[:budget]


def stale_unasserted(root: pathlib.Path, kb_verify):
    """Stamped sections past their horizon or agent TTL that carry no Recheck: (issue #63).
    kb-verify reports these as "STALE, no assertion" but only when someone runs it, and
    recheck_due() counts only what a command can settle, so between sweeps they were silent.
    The same is_due() decides, so there is one judgment of "due". Not capped by
    verifier_budget: the budget limits what kb-verify RUNS, and nothing runs these."""
    horizon, _budget = kb_verify.horizon_and_budget(root)
    if horizon is None:
        return None
    ttl = kb_verify.agent_ttl(root, horizon)
    _due, found, _with_cmd = kb_verify.due_sections(root, horizon, ttl)
    return [s for s in found if not s["cmd"] and kb_verify.is_due(s, horizon, ttl)]


def queue_due(root: pathlib.Path, kb_watch):
    """(open_count, {category: count}) from the library's needs-attention.md, parsed with
    kb-watch's own parse_records — the same record grammar kb-watch and kb-verify both write.
    (0, {}) when there is no queue file at all; that is the normal, silent case."""
    qpath = root / "needs-attention.md"
    if not qpath.is_file():
        return 0, {}
    text = qpath.read_text(errors="replace")
    records = kb_watch.parse_records(text)
    open_recs = [r for r in records if r.get("status") == "open"]
    cats = {}
    for r in open_recs:
        cats[r.get("category", "?")] = cats.get(r.get("category", "?"), 0) + 1
    return len(open_recs), cats


DISTILLED = re.compile(r"^##\s+Distill", re.M)


def episodic_count(root: pathlib.Path):
    """Episodic notes not yet distilled. kb-distill marks a note it has distilled with a heading
    beginning `## Distill` ("## Distilled ...", or older notes' "## Distillation record"); a note
    without one is counted. Counting every note instead would ask about the same, already-distilled
    notes at every session start, which is how a nudge turns into noise nobody reads."""
    edir = root / "episodic"
    if not edir.is_dir():
        return 0
    return len([f for f in edir.glob("*.md")
                if f.name != "INDEX.md" and not DISTILLED.search(f.read_text(errors="replace"))])


def unstamped_count(root: pathlib.Path, check_kb):
    """Served sections citing a Source: with no stamp, counted by check-kb's own section reader
    (issue #29). Only a kb-audit sweep surfaced these before, though §7 ranks unknown ahead of
    stale. Facts only: the golden set, the queue, the state leaves (open questions and the
    contradiction register, §2), episodic notes and source stubs are records, and no stamp
    could ever clear them."""
    n = 0
    for f in check_kb.kb_files(root):
        rel = f.relative_to(root).parts
        if f.name.endswith(("-golden.md", "-open-questions.md", "-contradictions.md")) \
                or f.name == "needs-attention.md" \
                or "episodic" in rel[:-1] or "sources" in rel[:-1]:
            continue
        text = f.read_text(errors="replace")
        n += check_kb.unstamped(text.split("---\n", 2)[2] if text.startswith("---\n") else text)
    return n


def plural(n: int, word: str) -> str:
    return f"{n} {word}" if n == 1 else f"{n} {word}s"


# The --summary categories, in the order they are shown: (key, heading).
SUMMARY = (("report", "weekly report"), ("packets", "to decide"), ("sweep", "sweeps due"), ("recheck", "to recheck"), ("stale", "stale, no assertion"),
           ("queue", "queue"), ("distill", "to distill"), ("unstamped", "unstamped"),
           ("contract", "contract"))


def summary_line(counts: list) -> str:
    """One line for the person from [(label, {key: count-or-text})]: each category with the
    trees in it, at most three named. Empty when nothing is due."""
    out = []
    for key, heading in SUMMARY:
        items = [f"{lbl} {c[key]}".rstrip() for lbl, c in counts if c.get(key)]
        if items:
            more = f", +{len(items) - 3} more" if len(items) > 3 else ""
            out.append(f"{heading}: {', '.join(items[:3])}{more}")
    return "KB due — " + " · ".join(out) if out else ""


def nudge_for(s: dict, kb_verify, kb_watch, check_kb, packets=()):
    """(line-or-None, [warning, ...], {summary key: count}) for one tree's row from status(). A
    warning never stops the other categories, this tree's own line, or any other tree — see
    module docstring: a malformed or uncomputable category is reported once and skipped."""
    tree, lbl = s["tree"], label(s["tree"])
    parts, warnings, counts = [], [], {}

    # Review packets kb-prepare drafted for this tree (ADR-0017): the decisions already waiting.
    mine = [h for _, h in packets if h.get("library_path") == str(tree.resolve())]
    if mine:
        counts["packets"] = len(mine)
        parts.append(f"{plural(len(mine), 'review packet')} awaiting your decision (kb-apply list)")

    if s["due"]:
        counts["sweep"] = " "     # named, not counted: one sweep per tree
        when = "never swept" if s["age"] is None else f"last swept {s['age']}d ago"
        parts.append(f"sweep due ({when}, every {s['interval']}d)")

    try:
        due = recheck_due(tree, kb_verify)
    except Exception as e:
        warnings.append(f"{lbl}: could not compute facts due for recheck ({e}) — skipped")
        due = None
    if due:
        counts["recheck"] = len(due)
        parts.append(f"{plural(len(due), 'fact')} due for recheck (kb-verify {shlex.quote(str(tree.resolve()))} --yes)")

    try:
        stale = stale_unasserted(tree, kb_verify)
    except Exception as e:
        warnings.append(f"{lbl}: could not compute stale facts with no assertion ({e}) — skipped")
        stale = None
    if stale:
        counts["stale"] = len(stale)
        parts.append(f"{plural(len(stale), 'stale fact')} with no assertion (re-check by hand, or kb-audit)")

    try:
        qn, cats = queue_due(tree, kb_watch)
    except Exception as e:
        warnings.append(f"{lbl}: could not read needs-attention.md ({e}) — skipped")
        qn, cats = 0, {}
    if qn:
        counts["queue"] = qn
        by_cat = ", ".join(f"{v} {k}" for k, v in sorted(cats.items()))
        parts.append(f"{plural(qn, 'open queue item')} ({by_cat})")

    try:
        en = episodic_count(tree)
    except Exception as e:
        warnings.append(f"{lbl}: could not count episodic notes ({e}) — skipped")
        en = 0
    if en:
        counts["distill"] = en
        parts.append(f"{plural(en, 'episodic note')} awaiting distillation")

    try:
        if check_kb is None:
            raise RuntimeError("check-kb could not be loaded")
        un = unstamped_count(tree, check_kb)
    except Exception as e:
        warnings.append(f"{lbl}: could not count unstamped sections ({e}) — skipped")
        un = 0
    if un:
        counts["unstamped"] = un
        parts.append(f"{plural(un, 'unstamped source')} (never verified)")

    try:   # ADR-0016: a library behind the contract is told; never a failure
        if check_kb is None:
            raise RuntimeError("check-kb could not be loaded")
        st, v, newest, newer = check_kb.contract_status(check_kb.declared_contract(tree))
    except ValueError:
        st = "malformed"
    except Exception as e:
        warnings.append(f"{lbl}: could not read the contract version ({e}) — skipped")
        st = None
    if st in ("behind", "ahead", "unsupported", "malformed"):
        counts["contract"] = {"behind": f"{check_kb.fmt(v)} (behind)", "ahead": f"{check_kb.fmt(v)} (ahead)",
                              "unsupported": f"{check_kb.fmt(v)} (unsupported)",
                              "malformed": "(unreadable)"}[st]
    if st == "behind":
        parts.append(f"built to contract {check_kb.fmt(v)}; this engine knows {check_kb.fmt(newest)} "
                     f"(CONVENTIONS §14 says what it adds; check-kb lists it)")
    elif st == "ahead":
        parts.append(f"declares contract {check_kb.fmt(v)}, newer than this engine "
                     f"({check_kb.fmt(newest)}) — upgrade the engine")
    elif st == "unsupported":
        parts.append(f"declares contract {check_kb.fmt(v)}, which this engine does not support — not served")
    elif st == "malformed":
        parts.append("kb_contract cannot be read — not served (check-kb says why)")

    line = f"{lbl}: " + "; ".join(parts) if parts else None
    return line, warnings, counts


def main(argv) -> int:
    nudge = "--nudge" in argv
    quiet = "--quiet" in argv
    summary = "--summary" in argv
    args = [a for a in argv if a not in ("--quiet", "--nudge", "--summary")]

    trees = []
    try:   # the registry's one reader; an unreadable registry must not crash a session
        trees += list(load_module("kb_libraries", "kb-libraries").installed().values())
    except Exception as e:
        print(f"kb-due: library registry unreadable, registered libraries skipped: {e}", file=sys.stderr)
    trees += [pathlib.Path(a) for a in args]

    rows = [s for s in (status(t) for t in trees) if s]
    due = [s for s in rows if s["due"]]

    if nudge:
        kb_verify = load_module("kb_verify", "kb-verify")
        kb_watch = load_module("kb_watch", "kb-watch")
        try:   # one category's dependency must never silence the others
            check_kb = load_module("check_kb", "check-kb")
        except Exception:
            check_kb = None
        lines, warnings, counts = [], [], []
        try:
            packets = load_module("kb_apply", "kb-apply").pending()
        except Exception as e:
            print(f"kb-due: review packets unreadable, skipped: {e}", file=sys.stderr)
            packets = []
        for s in rows:
            line, warn, c = nudge_for(s, kb_verify, kb_watch, check_kb, packets)
            if line:
                lines.append(line)
            warnings += warn
            counts.append((label(s["tree"]), c))
        try:   # the weekly report (ADR-0017): named while it is this week's and lists decisions
            rep = load_module("kb_report", "kb-report").latest()
        except Exception as e:
            warnings.append(f"the weekly report is unreadable ({e}) — skipped")
            rep = None
        if rep and rep[1] and rep[2] < 8:
            lines.append(f"Weekly report: {rep[1]} decision(s) waiting in {rep[0]}")
            counts.append(("report", {"report": rep[1]}))
        for w in warnings:
            print(f"kb-due: {w}", file=sys.stderr)
        if lines:
            print("\n".join(lines))
            print("Commands: kb-audit <library> for a sweep; kb-verify <path> --yes for "
                  "the rechecks above; kb-distill for the episodic notes above; kb-audit "
                  "<library> queues unstamped sources and stale facts with no assertion.")
            if summary:
                print(summary_line(counts))
        return 0

    if quiet:
        for s in due:
            when = "never swept" if s["age"] is None else f"last swept {s['age']}d ago"
            print(f"{label(s['tree'])}: {when} (every {s['interval']}d) — kb-audit due")
        return 0

    if not rows:
        print("kb-due: no knowledge trees found"); return 0
    for s in rows:
        when = "never swept" if s["age"] is None else f"{s['age']}d ago"
        print(f"  {'DUE ' if s['due'] else 'ok  '} {label(s['tree']):<28} swept {when:<14} "
              f"(every {s['interval']}d)")
    print(f"\n{len(due)} of {len(rows)} tree(s) due for a sweep"
          + ("" if due else " — nothing to do"))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
