#!/usr/bin/env python3
"""secret-entropy — heuristic pass for credentials that have no recognisable shape.

Companion to check-secrets, which runs it on every file it scans. Reads one file,
prints `LINE:text` for each suspicious line (at most 3), exits 0 either way —
check-secrets decides what a hit means.

Two rules, both deliberately narrow because this blocks a commit:

  labeled  a secret-ish label (password, secret, token, api key ...) followed by
           `=` or `:` and a value of 8+ characters drawing on 3+ character classes
           (lower, upper, digit, symbol). Catches a password whose `#` or `(` stops
           the pattern file's value class short.
  bare     a single token of 16+ characters with a digit and 3+ classes including
           a symbol, or 20+ characters of mixed-case letters and digits, with
           Shannon entropy >= 3.5 bits/char. (`-_.` count as glue, not symbols.) Catches a prefixless literal.

Not flagged: hex-only strings (hashes, SHAs), URLs and paths, [[wiki-links]] and
markdown links, ISO dates, hyphenated words and slugs, code (calls, indexing,
regex), placeholders (<x>, $X, {{x}}), and any line carrying `lint-allow: <reason>` (same escape as check-embedded-facts).

HONEST LIMIT: a heuristic. It will miss low-entropy or short secrets and may flag
a legitimate literal; annotate the latter with `lint-allow: <reason>`.
"""
import math, re, sys

LABEL = re.compile(
    r"(?i)(?:password|passwd|pwd|secret|token|api[_-]?key|access[_-]?key|private[_-]?key|credential)"
    r"\w*[\"']?\s*[:=]\s*(?:\"([^\"]*)\"|'([^']*)'|`([^`]*)`|(\S+))")
TOKEN = re.compile(r"[^\s\"'`<>,;|=]+")
PLACEHOLDER = re.compile(r"^(?:[<$%{\[*]|\.\.\.|x{4,}|\$)", re.I)
HEX = re.compile(r"^(?:0x)?[0-9a-fA-F]+$")
SLUG = re.compile(r"^[a-z0-9]+(?:[-_.][a-z0-9]+)*$")
DATE = re.compile(r"^\d{4}-\d{2}-\d{2}")
# Code and prose that happen to be long and mixed-class: a call or index
# (`f(x`, `a[0]`), a regex (`[a-z0-9]`, `{16}`, backslashes).
CALL = re.compile(r"^[A-Za-z_][\w.]*[(\[]")  # bare tokens only: a labeled value may be `pw(x)!`
CODE = re.compile(r"\\|\[\^?\w-\w|\{\d+(?:,\d*)?\}")
FILEEXT = re.compile(r"\.(?:md|py|sh|json|ya?ml|txt|toml|js|ts|html|css|csv)(?:[:#)\]].*)?$")


def classes(s):  # lower, upper, digit, symbol — `-_.` are word glue, not symbols
    return sum(bool(re.search(p, s)) for p in ("[a-z]", "[A-Z]", "[0-9]", r"[^A-Za-z0-9._-]"))


def entropy(s):
    n = len(s)
    return -sum(c / n * math.log2(c / n) for c in (s.count(ch) for ch in set(s)))


def hyphenated_words(t):  # `20%-longer-cycle`: most hyphen segments are plain words/numbers
    segs = [s for s in re.split(r"[-_]", t) if s]
    plain = sum(bool(re.fullmatch(r"[A-Za-z]{2,}|\d+%?", s)) for s in segs)
    return len(segs) > 1 and plain * 2 >= len(segs)


def exempt(t):
    return (PLACEHOLDER.match(t) or HEX.match(t) or SLUG.match(t) or DATE.match(t)
            or "://" in t or "/" in t or t[0] in "~." or CODE.search(t) or hyphenated_words(t) or "](" in t or "[[" in t or FILEEXT.search(t))


def labeled(line):
    for m in LABEL.finditer(line):
        v = next(g for g in m.groups() if g is not None).rstrip(",;")
        if len(v) >= 8 and not exempt(v) and classes(v) >= 3:
            return True
    return False


def bare(line):
    line = re.sub(r"\[\[[^\]]*\]\]|\]\([^)]*\)", " ", line)  # wiki-links, link targets
    for m in TOKEN.finditer(line):
        t = m.group().rstrip(".,:;)")
        t = t.lstrip("([*_)]}")
        if len(t) < 16 or exempt(t) or CALL.match(t):
            continue
        sym = re.search(r"[^A-Za-z0-9._-]", t)
        if (re.search("[0-9]", t) and classes(t) >= 3 and entropy(t) >= 3.5
                and (sym or len(t) >= 20)):
            return True
    return False


def main():
    data = open(sys.argv[1], "rb").read()
    if b"\0" in data:
        return
    shown = 0
    for n, line in enumerate(data.decode("utf-8", "replace").split("\n"), 1):
        if "lint-allow" in line:
            continue
        if labeled(line) or bare(line):
            print(f"{n}:{line.strip()[:120]}")
            shown += 1
            if shown == 3:
                break


main()
