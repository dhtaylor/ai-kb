#!/usr/bin/env python3
"""kb-eval-sample — a graded retrieval sample, joined with what each case cost (#97).

kb-telemetry measures cost in normal use, but normal use does not say whether the answers were
right. This draws a seeded sample of a library's positive and cross-root golden cases, has a person
put each to a fresh kb-retrieve agent, and grades the runs with the graders the engine already has:
grade-routing (did it read the right file, and nothing it should not) and grade-eval --transcripts
(is the answer grounded in that file). Each case is then joined with its cost, measured the way
kb-telemetry measures it.

  prepare  writes <out>/sample.tsv (the cases) and <out>/PROMPTS.md: per case, the description to
           give the agent (`kb-eval <sample> Q<n>`) and the prompt, which forbids opening golden sets
           and eval folders. Spawn one fresh agent per case, in a session started after the change
           being measured, so the agent runs the current definition.
  grade    finds each case's transcript by that description (the newest, if several), writes
           <out>/mapping in the Q<n>|<transcript> form both graders read, runs them, and prints a
           cost row per case.

A random sample can miss what a reshape changed, so `--cases Q4,Q9` draws exactly those cases, for
a before-and-after comparison. kb-telemetry leaves these runs out of normal use by their description.

Usage: kb-eval-sample prepare <library> [--seed N] [--n K] [--cases Q<n>,...] --out DIR
       kb-eval-sample grade DIR [--projects DIR]
  Defaults: --seed today as YYYYMMDD, --n 5.
Exit for grade: 0 every graded case passed both graders, 1 any failed, 2 nothing to grade.
"""
import datetime, importlib.machinery, importlib.util, pathlib, random, re, subprocess, sys

SCRIPTS = pathlib.Path(__file__).resolve().parent


def load(name, filename):
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader(name, str(SCRIPTS / filename))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


def usage() -> int:
    print(__doc__.strip().split("\n\n")[-2], file=sys.stderr)
    return 2


def options(argv, names):
    opts, rest, i = {}, [], 0
    while i < len(argv):
        if argv[i] in names and i + 1 < len(argv):
            opts[argv[i]] = argv[i + 1]; i += 2
        elif argv[i].startswith("--"):
            return None, None
        else:
            rest.append(argv[i]); i += 1
    return opts, rest


def prepare(argv) -> int:
    opts, rest = options(argv, ("--seed", "--n", "--cases", "--out"))
    if opts is None or len(rest) != 1 or "--out" not in opts:
        return usage()
    lib = pathlib.Path(rest[0]).resolve()
    ge = load("grade_eval", "grade-eval")
    recs = ge.load_golden(lib)
    name = ge.installed()[1](lib) or lib.name
    eligible = [(i, r) for i, r in enumerate(recs, 1) if r.get("case") in ("positive", "cross-root")]
    if "--cases" in opts:
        want = {int(q[1:]) for q in opts["--cases"].split(",") if re.fullmatch(r"Q[1-9]\d*", q)}
        chosen = [(i, r) for i, r in eligible if i in want]
        sid = f"{name}-cases-{'-'.join(f'Q{i}' for i, _ in chosen)}"
    else:
        seed = int(opts.get("--seed", datetime.date.today().strftime("%Y%m%d")))
        chosen = sorted(random.Random(seed).sample(eligible, min(int(opts.get("--n", "5")), len(eligible))))
        sid = f"{name}-s{seed}"
    if not chosen:
        print(f"kb-eval-sample: {name} has no positive or cross-root case to draw", file=sys.stderr)
        return 2
    out = pathlib.Path(opts["--out"]); out.mkdir(parents=True, exist_ok=True)
    (out / "sample.tsv").write_text(f"sample_id: {sid}\nlibrary: {lib}\n"
                                    + "".join(f"Q{i}\t{r.get('question', '')}\n" for i, r in chosen))
    prompts = [f"# Retrieval sample {sid}\n",
               "Spawn one fresh kb-retrieve agent per case below, in a session started after the change "
               "being measured. Give it the description shown and the prompt word for word. Then run "
               f"`kb-eval-sample grade {out}`.\n"]
    for i, r in chosen:
        prompts.append(f"## Q{i}\n\nDescription: `kb-eval {sid} Q{i}`\n\nPrompt:\n\n> {r.get('question', '')}\n>\n"
                       "> Do not open golden sets (files ending -golden.md) or eval folders (documents/eval-*).\n")
    (out / "PROMPTS.md").write_text("\n".join(prompts))
    print(f"kb-eval-sample: {len(chosen)} case(s) drawn as kb-eval {sid}; prompts in {out / 'PROMPTS.md'}")
    return 0


def grade(argv) -> int:
    opts, rest = options(argv, ("--projects",))
    if opts is None or len(rest) != 1:
        return usage()
    out = pathlib.Path(rest[0])
    try:
        lines = (out / "sample.tsv").read_text().splitlines()
    except OSError:
        print(f"kb-eval-sample: {out} holds no sample.tsv; run prepare first", file=sys.stderr)
        return 2
    sid, lib = lines[0].split(": ", 1)[1], pathlib.Path(lines[1].split(": ", 1)[1])
    cases = [l.split("\t", 1)[0] for l in lines[2:] if l.startswith("Q")]
    tel = load("kb_telemetry", "kb-telemetry")
    projects = pathlib.Path(opts.get("--projects") or pathlib.Path.home() / ".claude" / "projects")
    found = {}
    for t, meta in tel.runs(projects):
        m = re.fullmatch(rf"kb-eval {re.escape(sid)} (Q\d+)", str(meta.get("description", "")).strip())
        if m and m.group(1) in cases and (m.group(1) not in found or t.stat().st_mtime > found[m.group(1)].stat().st_mtime):
            found[m.group(1)] = t
    for q in cases:
        if q not in found:
            print(f"kb-eval-sample: {q}: no transcript described `kb-eval {sid} {q}`; not graded")
    if not found:
        return 2
    mapping = out / "mapping"
    mapping.write_text("".join(f"{q}|{found[q]}\n" for q in cases if q in found))

    rcs = []
    for label, cmd in (("routing (grade-routing)", [str(SCRIPTS / "grade-routing"), str(lib), str(mapping)]),
                       ("grounding (grade-eval)", [str(SCRIPTS / "grade-eval"), str(lib), "--transcripts", str(mapping)])):
        r = subprocess.run(cmd, capture_output=True, text=True)
        rcs.append(r.returncode)
        print(f"{label}: exit {r.returncode}\n" + "\n".join("  " + l for l in (r.stdout + r.stderr).strip().splitlines()))

    ge = load("grade_eval", "grade-eval")
    libs = {n: pathlib.Path(p).resolve() for n, p in ge.installed()[0].items()}
    libs.setdefault(ge.installed()[1](lib) or lib.name, lib.resolve())
    print("\n| case | " + " | ".join(tel.COLUMNS) + " |\n|---|" + "---|" * len(tel.COLUMNS))
    for q in cases:
        if q in found:
            r = tel.measure(found[q], ge, libs) or {}
            print(f"| {q} | " + " | ".join(tel.median([r.get(c)]) for c in tel.COLUMNS) + " |")
    return 2 if 2 in rcs else (1 if any(rcs) else 0)


def main(argv) -> int:
    if argv[:1] == ["prepare"]:
        return prepare(argv[1:])
    if argv[:1] == ["grade"]:
        return grade(argv[1:])
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
