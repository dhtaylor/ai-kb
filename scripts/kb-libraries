#!/usr/bin/env python3
"""kb-libraries — the one reader of the per-machine library registry (ADR-0014).

A library is installed on a machine when it is registered there, and only then. The registry is
~/.config/ai-kb/libraries, in git-config format, read with `git config --file`:

    [library "azure-devops"]
        path = /mnt/c/workspace/kb/azure-devops
        origin = https://github.com/dhtaylor/azure-devops.git

The path is FIXED and does not follow XDG_CONFIG_HOME: that variable is often set only in an
interactive shell, which would put a git hook and the terminal on two different registries
(the trap ADR-0008 documents). It is not ~/.gitconfig, which people sync across machines.

Each registered library is in exactly one state, and only `ok` is served:
  ok             the path exists and its root INDEX.md declares the registered name (domain:)
  missing        nothing is at the registered path
  not-a-library  the path exists but has no root INDEX.md
  name-mismatch  the root INDEX.md declares a different name
Every other state is reported by whoever reads this, never dropped: a library that silently
vanishes makes retrieval answer `fact not found`, which looks exactly like a correct refusal.

Shell callers run it; Python callers import it (the SourceFileLoader pattern kb-due uses).

Usage: kb-libraries          one line per registered library: <state>TAB<name>TAB<path>
Exit 0, or 2 if the registry exists and git cannot read it.
"""
import os, pathlib, re, subprocess, sys

REGISTRY = pathlib.Path.home() / ".config" / "ai-kb" / "libraries"
DOMAIN = re.compile(r"^domain:\s*[\"']?([\w-]+)[\"']?\s*(?:#.*)?$")


def declared_name(lib: pathlib.Path):
    """The `domain:` a library's root INDEX.md declares in its frontmatter, or None."""
    try:
        lines = (lib / "INDEX.md").read_text(errors="replace").splitlines()
    except OSError:
        return None
    if not lines or lines[0].strip() != "---":
        return None
    for line in lines[1:]:
        if line.strip() == "---":
            return None
        m = DOMAIN.match(line.strip())
        if m:
            return m.group(1)
    return None


def state_of(name: str, path: pathlib.Path) -> str:
    if not path.exists():
        return "missing"
    if not (path / "INDEX.md").is_file():
        return "not-a-library"
    return "ok" if declared_name(path) == name else "name-mismatch"


def entries():
    """[{name, path, origin, state}] for every registered library, in name order."""
    if not REGISTRY.is_file():
        return []
    r = subprocess.run(["git", "config", "--file", str(REGISTRY), "--null", "--list"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"cannot read {REGISTRY}: {r.stderr.strip()}")
    libs = {}
    for rec in r.stdout.split("\0"):
        key, _, value = rec.partition("\n")
        if not key.startswith("library.") or key.count(".") < 2:
            continue
        name, field = key[len("library."):].rsplit(".", 1)
        libs.setdefault(name, {})[field] = value
    out = []
    for name in sorted(libs):
        if "path" not in libs[name]:
            continue
        path = pathlib.Path(libs[name]["path"])
        out.append({"name": name, "path": path, "origin": libs[name].get("origin", ""),
                    "state": state_of(name, path)})
    return out


def library_home(engine: pathlib.Path) -> pathlib.Path:
    """Where new libraries are cloned: $KB_LIBRARY_HOME, else kb.libraryHome in the registry
    (kb-bootstrap records it), else <engine>/kb. Only a default for kb-library add and import;
    a library is never discovered by being in it."""
    if os.environ.get("KB_LIBRARY_HOME"):
        return pathlib.Path(os.environ["KB_LIBRARY_HOME"]).expanduser()
    if REGISTRY.is_file():
        r = subprocess.run(["git", "config", "--file", str(REGISTRY), "--get", "kb.libraryHome"],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return pathlib.Path(r.stdout.strip()).expanduser()
    return engine / "kb"


def installed():
    """{name: resolved path} for every library in state ok: the set that is served."""
    return {e["name"]: e["path"].resolve() for e in entries() if e["state"] == "ok"}


def main() -> int:
    try:
        rows = entries()
    except RuntimeError as e:
        print(f"kb-libraries: {e}", file=sys.stderr)
        return 2
    for e in rows:
        print(f"{e['state']}\t{e['name']}\t{e['path']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
