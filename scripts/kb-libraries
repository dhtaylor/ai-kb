#!/usr/bin/env python3
"""kb-libraries — the one reader of the per-machine library registry (ADR-0014).

A library is installed on a machine when it is registered there, and only then. The registry is
~/.config/ai-kb/libraries, in git-config format, read with `git config --file`:

    [library "azure-devops"]
        path = /mnt/c/workspace/kb/azure-devops
        origin = https://github.com/dhtaylor/azure-devops.git
        readOnly = true        # optional: a consumer's copy of someone else's library (ADR-0020)
        ref = v0.4.0           # optional, with readOnly: the release tag the copy is pinned to

A read-only library is served like any other, but this machine never curates it: nothing commits
to it, writes into it or nudges about it. Its corrections are filed with its origin.

The path is FIXED and does not follow XDG_CONFIG_HOME: that variable is often set only in an
interactive shell, which would put a git hook and the terminal on two different registries
(the trap ADR-0008 documents). It is not ~/.gitconfig, which people sync across machines.

Each registered library is in exactly one state, and only `ok` is served:
  ok             the path exists and its root INDEX.md declares the registered name (domain:)
  missing        nothing is at the registered path
  not-a-library  the path exists but has no root INDEX.md
  name-mismatch  the root INDEX.md declares a different name
  unsupported-contract
                 its kb_contract names a major this engine does not support, or cannot be read
                 (ADR-0016): its markers may mean something this engine cannot read, and serving
                 it could present a disputed fact as settled
Every other state is reported by whoever reads this, never dropped: a library that silently
vanishes makes retrieval answer `fact not found`, which looks exactly like a correct refusal.

Shell callers run it; Python callers import it (the SourceFileLoader pattern kb-due uses).

A file the engine writes under HOME may be a link into a dotfiles repository synced across
machines, as GNU Stow and its kin make (#138). The write goes through the link, so this machine's
paths land in the shared copy. `linked()` names such a file, and every writer says so; it never
refuses. HOME itself being a link (/home on another disk) is not reported.

Usage: kb-libraries          one line per registered library: <state>TAB<name>TAB<path>
       kb-libraries --read-only   one line per read-only library: <name>TAB<path>TAB<origin>
       kb-libraries --linked PATH...   one line per PATH reached through a link: <path>TAB<real path>
Exit 0, or 2 if the registry exists and git cannot read it.
"""
import os, pathlib, re, subprocess, sys

from kbengine import library

REGISTRY = pathlib.Path.home() / ".config" / "ai-kb" / "libraries"
NAME = re.compile(r"[\w-]+")      # what a registered library may be called


def declared_name(lib: pathlib.Path):
    """The `domain:` a library's root INDEX.md declares in its frontmatter, if it is a name a
    library can be registered by, else None."""
    name = library.library(lib).name
    return name if name and NAME.fullmatch(name) else None


def declared_terms(lib: pathlib.Path) -> set:
    """The `keywords:` and `tags:` of a library's root INDEX.md frontmatter, normalized: lowercase,
    runs of space, `_` and `-` read as one `-`, a trailing plural `s` dropped. Empty if there is
    none."""
    return set(library.library(lib).terms)


normalize_term = library.normalize_term


def contract_supported(path: pathlib.Path) -> bool:
    """False if the library's kb_contract is an unsupported major or unreadable (ADR-0016). True
    if this engine cannot read its own contract versions: that is an engine defect check-kb
    reports, not grounds to withhold every library."""
    status = library.library(path).contract
    return status is None or status[0] not in ("unsupported", "malformed")


def state_of(name: str, path: pathlib.Path) -> str:
    if not path.exists():
        return "missing"
    if not (path / "INDEX.md").is_file():
        return "not-a-library"
    if declared_name(path) != name:
        return "name-mismatch"
    return "ok" if contract_supported(path) else "unsupported-contract"


def entries():
    """[{name, path, origin, read_only, ref, state}] for every registered library, in name order."""
    if not REGISTRY.is_file():
        return []
    r = subprocess.run(["git", "config", "--file", str(REGISTRY), "--null", "--list"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"cannot read {REGISTRY}: {r.stderr.strip()}")
    libs = {}
    for rec in r.stdout.split("\0"):
        key, _, value = rec.partition("\n")
        if not key.startswith("library.") or key.count(".") < 2:
            continue
        name, field = key[len("library."):].rsplit(".", 1)
        libs.setdefault(name, {})[field] = value
    out = []
    for name in sorted(libs):
        if "path" not in libs[name]:
            continue
        path = pathlib.Path(libs[name]["path"])
        out.append({"name": name, "path": path, "origin": libs[name].get("origin", ""),
                    "read_only": libs[name].get("readonly", "").lower() == "true",
                    "ref": libs[name].get("ref", ""), "state": state_of(name, path)})
    return out


def library_home(engine: pathlib.Path) -> pathlib.Path:
    """Where new libraries are cloned: $KB_LIBRARY_HOME, else kb.libraryHome in the registry
    (kb-bootstrap records it), else <engine>/kb. Only a default for kb-library add and import;
    a library is never discovered by being in it."""
    if os.environ.get("KB_LIBRARY_HOME"):
        return pathlib.Path(os.environ["KB_LIBRARY_HOME"]).expanduser()
    if REGISTRY.is_file():
        r = subprocess.run(["git", "config", "--file", str(REGISTRY), "--get", "kb.libraryHome"],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return pathlib.Path(r.stdout.strip()).expanduser()
    return engine / "kb"


def installed():
    """{name: resolved path} for every library in state ok: the set that is served."""
    return {e["name"]: e["path"].resolve() for e in entries() if e["state"] == "ok"}


def origin_key(url: str) -> tuple:
    """(host, path) an origin names, so that its forms compare equal (ADR-0020): scheme, user, port,
    the host's case, a trailing .git and trailing slashes don't matter. A local path is ("", path)."""
    u = url.strip()
    m = re.match(r"^[a-z][a-z0-9+.-]*://(?:[^@/]*@)?([^/:]*)(?::\d+)?/(.*)$", u, re.I) \
        or re.match(r"^(?:[^@/:]+@)?([^/:]{2,}):(?!//)(.*)$", u)
    host, path = (m.group(1).lower(), m.group(2)) if m else ("", u)
    return host, re.sub(r"(\.git)?/*$", "", path.lstrip("/") if host else path)


def same_origin(a: str, b: str) -> bool:
    return origin_key(a) == origin_key(b)


def links_to(root) -> dict:
    """{library: origin} from the `links_to:` block in a root INDEX.md's frontmatter (contract 2.6):
    where each library it links into comes from. {} when it declares none."""
    return library.library(root).links_to


def read_only(path) -> dict:
    """The registry entry of the read-only library at path, or None (ADR-0020). Every script that
    writes into a library asks this first. An unreadable registry reads as no entry: the writer then
    behaves as it did before read-only libraries existed, and session start names the registry."""
    try:
        here = pathlib.Path(path).resolve()
        return next((e for e in entries() if e["read_only"] and e["path"].resolve() == here), None)
    except (RuntimeError, OSError):
        return None


def refusal(tool: str, e: dict) -> str:
    """One wording for every writer that refuses a read-only library."""
    where = e["origin"] or "its publisher"
    return (f"{tool}: {e['name']} is registered read-only on this machine, a consumer's copy: it is "
            f"not curated here (ADR-0020). File what you found with {where}. To curate it here: "
            f"kb-library add {e['path']}")


def linked(path):
    """The real path of `path` when it, or a folder between it and HOME, is a symlink; else None."""
    p = pathlib.Path(os.path.abspath(os.path.expanduser(str(path))))
    home = pathlib.Path(os.path.abspath(pathlib.Path.home()))
    q = p
    while q != home and q.parent != q:
        if q.is_symlink():
            return os.path.realpath(p)
        if home not in q.parents:      # outside HOME: only the file itself is asked about
            return None
        q = q.parent
    return None


def linked_note(tool: str, path) -> str:
    """The note a writer prints for a linked target, or '' when it is not linked."""
    real = linked(path)
    if not real:
        return ""
    return (f"{tool}: note: {path} is a link to {real}. What is written there is this machine's, so "
            f"if that file is shared with other machines, as a dotfiles repository is, it carries "
            f"this machine's paths to them (#138).")


def main(argv=()) -> int:
    argv = list(argv)
    if argv[:1] == ["--linked"]:
        for a in argv[1:]:
            real = linked(a)
            if real:
                print(f"{a}\t{real}")
        return 0
    try:
        rows = entries()
    except RuntimeError as e:
        print(f"kb-libraries: {e}", file=sys.stderr)
        return 2
    if list(argv) == ["--read-only"]:
        for e in rows:
            if e["read_only"]:
                print(f"{e['name']}\t{e['path']}\t{e['origin']}")
        return 0
    if argv:
        print("usage: kb-libraries [--read-only]", file=sys.stderr); return 2
    for e in rows:
        print(f"{e['state']}\t{e['name']}\t{e['path']}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
