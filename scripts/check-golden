#!/usr/bin/env python3
"""check-golden — the deterministic half of the retrieval eval.

Verifies that a library's golden set is a working oracle: every record is
well-formed, every expected_file exists, and every expected_excerpt is actually
present in the file it names, and every expected_file is REACHABLE from the library's
root INDEX.md by router links (check-kb's own reachability, imported, not copied). Retrieval
descends routers and never searches, so a file no router reaches cannot be routed to — and
check-kb's orphan check exempts documents/ and the golden set, which would otherwise be
places a record could hide. A cross-root case may name its expected_file in another library
registered on this machine as <library>:<path>; it is checked there, against that library's
routers. An uncorroborated case's excerpt must sit in a section marked UNCORROBORATED, and a
library holding such a section must carry one (CONVENTIONS §8, §10). No LLM, no agent, no network — it runs on every commit and is
cheap enough to.

What it CANNOT do, and this is the point of the split: it cannot tell whether an
agent answers from the file or from its own memory. An inlined fact routes
correctly and passes here. That is the answer-grounding eval's job, which runs an
agent and greps its answer. This check is the fire alarm's wiring; it is not the
fire alarm.

Usage: check-golden <library-root>
Exit 0 clean, 1 on any defect.
"""
import importlib.machinery, importlib.util, pathlib, sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))   # found beside it, also when loaded as a module
from kbengine import golden

parse = golden.parse    # the golden-set parser is kbengine.golden's; a caller that loads this script reads it here


def load_check_kb():
    """Import the extensionless sibling script check-kb as a module (the SourceFileLoader pattern
    kb-due uses for kb-verify), so reachability has one implementation. This is the one script load
    left: moving reachable, kb_files and marked_sections into the engine overlaps #251 (one parse of a
    library per sweep), so it waits for that."""
    path = pathlib.Path(__file__).resolve().parent / "check-kb"
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("check_kb", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def main(root: pathlib.Path) -> int:
    golds = golden.files(root)
    if not golds:
        print(f"check-golden: no golden set in {root} — a library with content and no oracle "
              f"is untested by construction")
        return 1
    if len(golds) > 1:
        print(f"check-golden: {len(golds)} golden sets found; expected exactly one")
        return 1

    gf = golds[0]
    text = gf.read_text()
    records = golden.parse(text)
    defects, counts = [], {c: 0 for c in golden.VALID_CASES}
    ckb = load_check_kb()
    reached = {root.resolve(): ckb.reachable(root, ckb.kb_files(root))}
    unchecked = []

    def reachable(owner):
        if owner not in reached:
            reached[owner] = ckb.reachable(owner, ckb.kb_files(owner))
        return reached[owner]

    if not records:
        defects.append(f"{gf.name}: no records parsed — the oracle is empty")

    for i, r in enumerate(records, 1):
        if r.get("case") in golden.VALID_CASES:
            counts[r["case"]] += 1
        found, skipped = golden.validate(root, r, f"{gf.name} record {i}", reachable, ckb.marked_sections)
        defects += found
        unchecked += skipped

    if counts["negative"] < 2:
        defects.append(f"{gf.name}: {counts['negative']} negative case(s); the contract requires >=2 "
                       f"(a KB that never refuses is a KB that guesses)")
    if counts["unresolved"] == 0 and "unresolved" not in text.lower():
        defects.append(f"{gf.name}: no unresolved case and no stated reason for its absence")
    if counts["uncorroborated"] == 0:
        # Required only where the library holds one: a caveat invented to fill a slot tests a
        # fiction, so a library with no marker needs neither a case nor a reason.
        holding = [f.name for f in ckb.kb_files(root)
                   if f != gf and ckb.marked_sections(f.read_text(errors="replace"))]
        if holding:
            defects.append(f"{gf.name}: no uncorroborated case, but {', '.join(sorted(holding))} "
                           f"holds a section marked UNCORROBORATED — nothing proves it is served "
                           f"caveat first")

    for d in defects:
        print(f"FAIL {d}")
    for u in unchecked:
        print(f"NOT CHECKED {u}")
    total = len(records)
    summary = ", ".join(f"{c}={counts[c]}" for c in sorted(golden.VALID_CASES) if counts[c])
    print(f"\n{total} record(s) checked ({summary}) — "
          + ("clean" if not defects else f"{len(defects)} defect(s)"))
    return 1 if defects else 0


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("usage: check-golden <library-root>", file=sys.stderr)
        sys.exit(2)
    sys.exit(main(pathlib.Path(sys.argv[1])))
